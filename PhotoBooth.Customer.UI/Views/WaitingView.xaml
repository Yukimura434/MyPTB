<UserControl x:Class="PhotoBooth.Customer.UI.Views.WaitingView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:PhotoBooth.Customer.UI.Controls" xmlns:color="clr-namespace:PhotoBooth.Color.D3D11;assembly=PhotoBooth.Color.D3D11">
 <Button Command="{Binding EnterCommand}" BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
  <Button.Template><ControlTemplate TargetType="Button"><Viewbox Stretch="UniformToFill"><Canvas Width="1600" Height="900" Background="{StaticResource BackgroundBrush}">
   <Image Width="1600" Height="900" Source="{Binding DataContext.BackgroundPath, RelativeSource={RelativeSource TemplatedParent}}" Stretch="UniformToFill"/>
   <controls:AnimatedImage Width="1600" Height="900" SourcePath="{Binding DataContext.BackgroundPath, RelativeSource={RelativeSource TemplatedParent}}" Stretch="UniformToFill"/>
   <Border Width="1600" Height="900" Background="#22000000"/>
   <controls:RoundedClipBorder Canvas.Left="{Binding DataContext.LiveViewCanvasX, RelativeSource={RelativeSource TemplatedParent}}" Canvas.Top="{Binding DataContext.LiveViewCanvasY, RelativeSource={RelativeSource TemplatedParent}}" Width="512" Height="288" CornerRadius="24" BorderThickness="2" BorderBrush="#99FFFFFF" Background="#22000000" Visibility="{Binding DataContext.ShowLiveView, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolVisibility}}">
    <Grid RenderTransformOrigin="0.5,0.5"><Grid.RenderTransform><ScaleTransform ScaleX="{Binding DataContext.LiveViewScaleX, RelativeSource={RelativeSource TemplatedParent}}"/></Grid.RenderTransform>
     <Image Source="{Binding DataContext.LiveImage, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource CustomerByteImage}}" Stretch="UniformToFill"/>
     <color:LiveColorSurface Failed="OnGpuLiveColorFailed" FrameData="{Binding DataContext.LiveImage, RelativeSource={RelativeSource TemplatedParent}}" LutValues="{Binding DataContext.LiveColor.Values, RelativeSource={RelativeSource TemplatedParent}}" LutSize="{Binding DataContext.LiveColor.Size, RelativeSource={RelativeSource TemplatedParent}}" DomainMin="{Binding DataContext.LiveColor.DomainMin, RelativeSource={RelativeSource TemplatedParent}}" DomainMax="{Binding DataContext.LiveColor.DomainMax, RelativeSource={RelativeSource TemplatedParent}}" Strength="{Binding DataContext.LiveColor.Strength, RelativeSource={RelativeSource TemplatedParent}}" Visibility="{Binding DataContext.LiveColor.IsEnabled, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolVisibility}}"/>
    </Grid>
   </controls:RoundedClipBorder>
  </Canvas></Viewbox></ControlTemplate></Button.Template>
 </Button>
</UserControl>
