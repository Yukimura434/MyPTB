<UserControl x:Class="PhotoBooth.Customer.UI.Views.WaitingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PhotoBooth.Customer.UI.Controls"
             xmlns:color="clr-namespace:PhotoBooth.Color.D3D11;assembly=PhotoBooth.Color.D3D11"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.Resources><ResourceDictionary Source="/PhotoBooth.Customer.UI;component/CustomerViewResources.xaml"/></UserControl.Resources>
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="StartChrome"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.45"/>
                    <DoubleAnimation Storyboard.TargetName="StartChrome"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                     From="24" To="0" Duration="0:0:0.45">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>
    <Grid Background="{StaticResource BackgroundBrush}" ClipToBounds="True">
        <!-- Canvas follows the viewport; normalized Live View placement stays inside every aspect ratio. -->
        <Viewbox Panel.ZIndex="0" Stretch="UniformToFill" StretchDirection="Both">
            <Canvas Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}"
                    Background="{StaticResource BackgroundBrush}" ClipToBounds="True">
                <!-- Built-in artwork remains visible whenever the operator has
                     not selected a custom waiting image (or that file is missing). -->
                <Image x:Name="DefaultLandscapeBackground" Panel.ZIndex="0"
                       Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}"
                       Source="/PhotoBooth.Customer.UI;component/Assets/default-waiting-landscape.png"
                       Stretch="UniformToFill"/>
                <Image x:Name="DefaultPortraitBackground" Panel.ZIndex="0"
                       Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}"
                       Source="/PhotoBooth.Customer.UI;component/Assets/default-waiting-portrait.png"
                       Stretch="UniformToFill" Visibility="Collapsed"/>
                <Image Panel.ZIndex="1"
                       Canvas.Left="{Binding BackgroundCanvasX}" Canvas.Top="{Binding BackgroundCanvasY}"
                       Width="{Binding BackgroundDisplayWidth}" Height="{Binding BackgroundDisplayHeight}"
                       Source="{Binding BackgroundPath}" Stretch="UniformToFill"/>
                <controls:AnimatedImage Panel.ZIndex="2"
                       Canvas.Left="{Binding BackgroundCanvasX}" Canvas.Top="{Binding BackgroundCanvasY}"
                       Width="{Binding BackgroundDisplayWidth}" Height="{Binding BackgroundDisplayHeight}"
                       SourcePath="{Binding BackgroundPath}" Stretch="UniformToFill"/>

                <!-- L2: theme scrim. It never participates in Live View geometry. -->
                <Border Panel.ZIndex="10" Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}"
                        Background="#26000000" IsHitTestVisible="False"/>

                <!-- L1: movable/resizable Live View. Only uniform cover scaling is used. -->
                <Grid x:Name="LiveViewPlacement" Panel.ZIndex="20" SizeChanged="LiveViewPlacement_SizeChanged"
                      Canvas.Left="{Binding LiveViewCanvasX}" Canvas.Top="{Binding LiveViewCanvasY}"
                      Width="{Binding LiveViewDisplayWidth}" Height="{Binding LiveViewDisplayHeight}"
                      Visibility="{Binding ShowLiveView,Converter={StaticResource BoolVisibility}}">
                <controls:RoundedClipBorder x:Name="LiveViewViewport" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="20" Background="#22000000">
                        <Viewbox Stretch="UniformToFill" StretchDirection="Both">
                            <Grid Width="{Binding LiveFrameWidth}" Height="{Binding LiveFrameHeight}">
                                <Grid.LayoutTransform>
                                    <TransformGroup>
                                        <ScaleTransform ScaleX="{Binding LiveViewScaleX}" ScaleY="1"/>
                                        <RotateTransform x:Name="LiveRotation" Angle="{Binding LiveViewRotation}"/>
                                    </TransformGroup>
                                </Grid.LayoutTransform>
                                <color:LatestJpegImage ColorPreset="{Binding LivePreset}" FrameData="{Binding LiveImage}"
                                                       Stretch="UniformToFill"
                                                       HorizontalAlignment="Stretch"
                                                       VerticalAlignment="Stretch"/>
                            </Grid>
                        </Viewbox>
                    </controls:RoundedClipBorder>
                </Grid>
            </Canvas>
        </Viewbox>

        <!-- L3 + L4: customer prompt and visual CTA. -->
        <StackPanel x:Name="StartChrome" Panel.ZIndex="31" VerticalAlignment="Bottom"
                    HorizontalAlignment="Center" Margin="30,0,30,54"
                    IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
            <StackPanel.RenderTransform><TranslateTransform/></StackPanel.RenderTransform>
            <TextBlock Text="Sẵn sàng lưu lại khoảnh khắc?"
                       Background="#E60B0B0F" Padding="12,6" FontSize="32" FontWeight="SemiBold" Foreground="White"
                       TextWrapping="Wrap" Margin="12,0,12,22"/>
            <Border MinWidth="0" MinHeight="78" Padding="48,18"
                    Background="#F014212A"
                    BorderBrush="{StaticResource AccentBrush}" BorderThickness="3" CornerRadius="40">
                <Border.Effect><DropShadowEffect Color="#FF2F86" BlurRadius="24" ShadowDepth="0" Opacity="0.7"/></Border.Effect>
                <Border.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                <Border.Triggers>
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                        <BeginStoryboard><Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.82" To="1" Duration="0:0:1.1"/>
                        </Storyboard></BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
                <TextBlock Text="CHẠM ĐỂ BẮT ĐẦU" FontSize="24"
                           FontWeight="Bold" Foreground="White"/>
            </Border>
        </StackPanel>

        <!-- L5: one transparent hit target above every visual layer. -->
        <Button Panel.ZIndex="50" Command="{Binding EnterCommand}"
                Background="Transparent" BorderThickness="0" Padding="0"
                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                automation:AutomationProperties.Name="Chạm để bắt đầu">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</UserControl>
