<UserControl x:Class="PhotoBooth.Customer.UI.Views.VideoSelectionView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:PhotoBooth.Customer.UI.Controls">
 <UserControl.Resources><Style x:Key="HitSlot" TargetType="Button"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter></Style></UserControl.Resources>
 <Grid Background="#100F13" Margin="28,24,28,22">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,14"><TextBlock Text="Ghép video chuyển động" FontSize="34" FontWeight="SemiBold"/><StackPanel HorizontalAlignment="Right"><TextBlock Text="{Binding AssignmentStatus}" HorizontalAlignment="Right" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding Guidance}" Foreground="#A8A4AE" FontSize="15"/></StackPanel></Grid>
  <Grid x:Name="WorkspaceGrid" Grid.Row="1">
   <Grid.RowDefinitions><RowDefinition x:Name="FrameRow" Height="*"/><RowDefinition x:Name="PreviewRow" Height="0"/><RowDefinition x:Name="VideoRow" Height="0"/></Grid.RowDefinitions>
   <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource SoftCard}" Background="#19171D" Padding="12"><DockPanel><TextBlock Text="FRAME ĐÃ CHỌN" DockPanel.Dock="Top" FontSize="18" FontWeight="Bold" Foreground="#C9A7BB" Margin="4,2,4,12"/><Image Source="{Binding SelectedFrame.ThumbnailPath,Converter={StaticResource CustomerPathImage}}" Stretch="Uniform"/></DockPanel></Border>
   <Border Grid.Column="2" Style="{StaticResource SoftCard}" Background="#151319" Padding="8" ClipToBounds="True"><Viewbox Stretch="Uniform"><Grid Width="{Binding SelectedFrame.PixelWidth}" Height="{Binding SelectedFrame.PixelHeight}" Background="#211E25"><ItemsControl ItemsSource="{Binding FrameSlots}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding X}"/><Setter Property="Canvas.Top" Value="{Binding Y}"/></Style></ItemsControl.ItemContainerStyle><ItemsControl.ItemTemplate><DataTemplate><controls:MediaSlotControl Width="{Binding Width}" Height="{Binding Height}" IsVideo="True" SourcePath="{Binding Photo.PreviewVideoPath}" Zoom="{Binding MediaZoom,Mode=TwoWay}" CenterX="{Binding MediaCenterX,Mode=TwoWay}" CenterY="{Binding MediaCenterY,Mode=TwoWay}" SelectCommand="{Binding DataContext.SelectSlotCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" SelectCommandParameter="{Binding}" ToolTip="Giữ chuột trái để di chuyển; lăn chuột để phóng đại"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Image Source="{Binding SelectedFrame.SourcePath,Converter={StaticResource CustomerPathImage}}" Stretch="Fill" IsHitTestVisible="False"/></Grid></Viewbox></Border>
   <Border Grid.Column="4" Style="{StaticResource SoftCard}" Background="#19171D" Padding="8"><DockPanel><TextBlock Text="VIDEO MP4" DockPanel.Dock="Top" FontSize="18" FontWeight="Bold" Foreground="#C9A7BB" Margin="6,2,6,8"/><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding Videos}"><ItemsControl.ItemTemplate><DataTemplate><Button Command="{Binding DataContext.SelectPhotoCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="5" Margin="4" Background="#242129" BorderThickness="3"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="BorderBrush" Value="#665A65"/><Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="BorderBrush" Value="#EF5DA8"/></DataTrigger></Style.Triggers></Style></Button.Style><Grid Width="220" Height="150" ClipToBounds="True"><Image Source="{Binding Path,Converter={StaticResource CustomerPathImage}}" Stretch="UniformToFill"/><MediaElement Source="{Binding PreviewVideoPath}" LoadedBehavior="Manual" UnloadedBehavior="Manual" IsMuted="True" Stretch="UniformToFill" Loaded="PreviewMediaLoaded" MediaEnded="PreviewMediaEnded"/><Border HorizontalAlignment="Left" VerticalAlignment="Top" Background="#CC27232A" CornerRadius="12" Padding="8,4"><TextBlock Text="{Binding Number,StringFormat=Video {0}}" FontWeight="Bold"/></Border><Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="#CC1E5134" CornerRadius="10" Padding="7,3"><TextBlock Text="MP4" Foreground="#9BE2BE" FontSize="11" FontWeight="Bold"/></Border></Grid></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></DockPanel></Border>
  </Grid>
  <WrapPanel Grid.Row="2" Margin="0,16,0,0" HorizontalAlignment="Center" VerticalAlignment="Center">
   <Button Content="Bỏ video khỏi ô đang chọn" Command="{Binding ClearSlotCommand}" MinWidth="220" Background="#85687A"/>
   <Button Content="Quay lại" Command="{Binding BackCommand}" Background="#CE93D8"/>
   <TextBlock Text="Số bản in" FontSize="18" VerticalAlignment="Center" Margin="18,0,8,0"/>
   <Button Content="−" Command="{Binding DecreaseCopiesCommand}" Width="64" Height="48" MinWidth="0" MinHeight="0" Padding="0" Margin="4"/>
   <Border Width="64" Height="48" Margin="4" Background="#211F26" CornerRadius="8"><TextBlock Text="{Binding PrintCopies}" FontSize="20" VerticalAlignment="Center"/></Border>
   <Button Content="+" Command="{Binding IncreaseCopiesCommand}" Width="64" Height="48" MinWidth="0" MinHeight="0" Padding="0" Margin="4"/>
   <Button Content="Tạo video" Command="{Binding FinishCommand}" Width="220"/>
  </WrapPanel>
  <Border Grid.RowSpan="3" Background="#E60A0A0D" Visibility="{Binding HasError,Converter={StaticResource BoolVisibility}}"><Border Style="{StaticResource SoftCard}" Width="560" VerticalAlignment="Center"><TextBlock Text="{Binding ErrorMessage}" FontSize="24" TextWrapping="Wrap"/></Border></Border>
 </Grid>
</UserControl>
