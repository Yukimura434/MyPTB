<UserControl x:Class="PhotoBooth.Customer.UI.Views.PrinterConnectionView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Background="{StaticResource BackgroundBrush}" Margin="38,28,38,32">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel Margin="8,0,8,18"><TextBlock Text="Thiết lập máy in" Style="{StaticResource PageTitle}"/><TextBlock Text="Kết nối máy in và kiểm tra thông số trước khi bắt đầu" Style="{StaticResource PageSubtitle}"/></StackPanel>
  <Grid x:Name="PrinterLayout" Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition x:Name="PrinterListColumn" Width="5*"/><ColumnDefinition x:Name="PrinterSettingsColumn" Width="6*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition x:Name="PrinterListRow" Height="*"/><RowDefinition x:Name="PrinterSettingsRow" Height="0"/></Grid.RowDefinitions>
   <Border x:Name="PrinterListPanel" Style="{StaticResource SoftCard}" Margin="0,0,12,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Border Background="{StaticResource AccentSubtleBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,14"><TextBlock Text="{Binding Message}" Foreground="{StaticResource TextBrush}" FontSize="15" TextWrapping="Wrap"/></Border>
    <UniformGrid Grid.Row="1" Columns="2" Margin="-5,0,-5,10"><Button Content="Máy in mặc định" Command="{Binding ConnectDefaultCommand}"/><Button Content="Quét lại" Command="{Binding ScanCommand}" Style="{StaticResource SecondaryButton}"/></UniformGrid>
    <ListBox Grid.Row="2" ItemsSource="{Binding Printers}" SelectedItem="{Binding SelectedPrinter,Mode=TwoWay}" MinHeight="210"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="13,11"/><Setter Property="Margin" Value="0,0,0,6"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource AccentSubtleBrush}"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold" TextAlignment="Left"/><TextBlock Text="{Binding ConnectionType}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextAlignment="Left" Margin="0,3,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="›" Foreground="{StaticResource AccentBrush}" FontSize="24"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
    <Grid Grid.Row="3" Margin="-5,10,-5,-5"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="Không dùng máy in" Command="{Binding SkipCommand}" Style="{StaticResource GhostButton}"/><Button Grid.Column="1" Content="Kết nối máy đã chọn" Command="{Binding ConnectCommand}"/></Grid>
   </Grid></Border>
   <Border x:Name="PrinterSettingsPanel" Grid.Column="1" Style="{StaticResource SoftCard}" Margin="0"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <TextBlock Text="Thông số in" FontSize="22" FontWeight="SemiBold" TextAlignment="Left"/><TextBlock Text="{Binding Profile.PrinterName}" Foreground="{StaticResource MutedTextBrush}" FontSize="15" TextAlignment="Left" Margin="0,4,0,16"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0"><TextBlock Text="Khổ giấy" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding PaperSizes}" SelectedItem="{Binding Profile.PaperSize,Mode=TwoWay}"/><TextBlock Text="Chất lượng" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding Qualities}" SelectedItem="{Binding Profile.Quality,Mode=TwoWay}"/></StackPanel><StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Nguồn / loại giấy" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding PaperTypes}" SelectedItem="{Binding Profile.PaperType,Mode=TwoWay}"/><TextBlock Text="Số bản mặc định" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding Copies}" SelectedItem="{Binding Profile.DefaultCopies,Mode=TwoWay}"/></StackPanel></Grid>
    <Border BorderBrush="#303039" BorderThickness="0,1,0,0" Margin="0,6,0,0" Padding="0,14,0,0"><UniformGrid Columns="2"><CheckBox IsChecked="{Binding Profile.Landscape,Mode=TwoWay}" Margin="4,8" Content="In ngang"/><CheckBox IsChecked="{Binding Profile.PrintInColor,Mode=TwoWay}" Margin="4,8" Content="In màu"/><CheckBox IsChecked="{Binding Profile.UseDefaultBorder,Mode=TwoWay}" Margin="4,8" Content="Dùng lề mặc định"/><CheckBox IsChecked="{Binding Profile.IsDefault,Mode=TwoWay}" Margin="4,8" Content="Đặt làm mặc định"/></UniformGrid></Border>
    <Button Content="Lưu và tiếp tục" Command="{Binding SaveAndContinueCommand}" HorizontalAlignment="Right" MinWidth="210" Margin="0,18,0,0"/>
   </StackPanel></ScrollViewer></Border>
  </Grid>
 </Grid>
</UserControl>
