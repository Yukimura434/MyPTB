<UserControl x:Class="PhotoBooth.Customer.UI.Views.PrinterConnectionView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="60" TextElement.Foreground="#4F3948">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <TextBlock Text="Thiết lập máy in" FontSize="42" FontWeight="Bold" Foreground="#9C5B87" Margin="0,0,0,12"/>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource SoftCard}" Margin="8">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Text="{Binding Message}" Foreground="#5F4655" FontSize="20" TextWrapping="Wrap" Margin="0,0,0,14"/>
     <StackPanel Grid.Row="1">
      <Button Content="Kết nối máy in mặc định" Command="{Binding ConnectDefaultCommand}"/>
      <Button Content="Không sử dụng máy in" Command="{Binding SkipCommand}" Background="#B56BC2"/>
      <Button Content="Quét lại máy in Windows" Command="{Binding ScanCommand}"/>
     </StackPanel>
     <ListBox Grid.Row="2" ItemsSource="{Binding Printers}" SelectedItem="{Binding SelectedPrinter,Mode=TwoWay}" MinHeight="220" Margin="0,4" Background="#F7F2F5" BorderBrush="#D7C6D0" BorderThickness="1">
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Foreground" Value="#3E2D37"/><Setter Property="Padding" Value="10"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" Foreground="#302229" FontWeight="Bold" TextAlignment="Left"/><TextBlock Text="{Binding ConnectionType}" Foreground="#6B5662" TextAlignment="Left"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <Button Grid.Row="3" Content="Kết nối máy đã chọn" Command="{Binding ConnectCommand}"/>
    </Grid>
   </Border>
   <Border Grid.Column="1" Style="{StaticResource SoftCard}" Margin="8">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel TextElement.Foreground="#4F3948">
     <TextBlock Text="Thông số máy in" Foreground="#5F4655" FontSize="24" FontWeight="Bold" Margin="0,0,0,6"/>
     <TextBlock Text="{Binding Profile.PrinterName}" Foreground="#302229" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>
      <TextBlock Text="Khổ giấy" Foreground="#5F4655" TextAlignment="Left"/><ComboBox ItemsSource="{Binding PaperSizes}" SelectedItem="{Binding Profile.PaperSize,Mode=TwoWay}"/>
      <TextBlock Text="Nguồn/loại giấy" Foreground="#5F4655" TextAlignment="Left"/><ComboBox ItemsSource="{Binding PaperTypes}" SelectedItem="{Binding Profile.PaperType,Mode=TwoWay}"/>
      <TextBlock Text="Chất lượng" Foreground="#5F4655" TextAlignment="Left"/><ComboBox ItemsSource="{Binding Qualities}" SelectedItem="{Binding Profile.Quality,Mode=TwoWay}"/>
      <TextBlock Text="Số bản" Foreground="#5F4655" TextAlignment="Left"/><ComboBox ItemsSource="{Binding Copies}" SelectedItem="{Binding Profile.DefaultCopies,Mode=TwoWay}" Foreground="White"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="White" TextAlignment="Center"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
     <Border BorderBrush="#E0D3DA" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="0,14,0,0">
      <UniformGrid Columns="2">
       <CheckBox IsChecked="{Binding Profile.Landscape,Mode=TwoWay}" Margin="4,8"><TextBlock Text="In ngang (Landscape)" Foreground="#302229" TextAlignment="Left" VerticalAlignment="Center"/></CheckBox>
       <CheckBox IsChecked="{Binding Profile.PrintInColor,Mode=TwoWay}" Margin="4,8"><TextBlock Text="In màu" Foreground="#302229" TextAlignment="Left" VerticalAlignment="Center"/></CheckBox>
       <CheckBox IsChecked="{Binding Profile.UseDefaultBorder,Mode=TwoWay}" Margin="4,8"><TextBlock Text="Dùng lề mặc định" Foreground="#302229" TextAlignment="Left" VerticalAlignment="Center"/></CheckBox>
       <CheckBox IsChecked="{Binding Profile.IsDefault,Mode=TwoWay}" Margin="4,8"><TextBlock Text="Đặt làm máy mặc định" Foreground="#302229" TextAlignment="Left" VerticalAlignment="Center"/></CheckBox>
      </UniformGrid>
     </Border>
     <Button Content="Lưu và tiếp tục" Command="{Binding SaveAndContinueCommand}" Margin="10,22,10,10"/>
    </StackPanel></ScrollViewer>
   </Border>
  </Grid>
 </Grid>
</UserControl>
