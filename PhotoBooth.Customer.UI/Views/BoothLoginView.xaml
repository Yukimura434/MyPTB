<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:PhotoBooth.Customer.UI.Controls" x:Class="PhotoBooth.Customer.UI.Views.BoothLoginView" UseLayoutRounding="True" RenderOptions.BitmapScalingMode="HighQuality" Background="#111015">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PhotoBooth.Customer.UI;component/Themes/ApprovedUx.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="HeaderRow" Height="80"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <controls:CustomerHeader>
            <controls:CustomerHeader.Style>
                <Style TargetType="controls:CustomerHeader">
                    <Setter Property="IsManagerEntranceEnabled" Value="True"/>
                    <Style.Triggers><DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="IsManagerEntranceEnabled" Value="False"/></DataTrigger></Style.Triggers>
                </Style>
            </controls:CustomerHeader.Style>
        </controls:CustomerHeader>
        <Grid Grid.Row="1" ClipToBounds="True">
            <Image x:Name="PortraitBackdrop" Source="/PhotoBooth.Customer.UI;component/Assets/default-waiting-portrait.png" Stretch="UniformToFill" Opacity="0.25" Visibility="Collapsed"/>
            <Border x:Name="PortraitShade" IsHitTestVisible="False" Visibility="Collapsed">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#44111015"/>
                        <GradientStop Color="#FF111015" Offset="0.92"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Grid x:Name="LoginBody" Margin="96,32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="StoryColumn"/>
                    <ColumnDefinition x:Name="StoryGap" Width="96"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Border x:Name="Story" CornerRadius="28" ClipToBounds="True" MaxHeight="760">
                    <Border.Background>
                        <ImageBrush ImageSource="/PhotoBooth.Customer.UI;component/Assets/default-waiting-portrait.png" Stretch="UniformToFill"/>
                    </Border.Background>
                    <Grid>
                        <Grid.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00151219" Offset="0.1"/>
                                <GradientStop Color="#08151219" Offset="0.35"/>
                                <GradientStop Color="#ED151219" Offset="0.95"/>
                            </LinearGradientBrush>
                        </Grid.Background>
                        <StackPanel VerticalAlignment="Bottom" Margin="36">
                            <TextBlock Text="MỘT TẤM ẢNH. NHIỀU KỶ NIỆM." Foreground="#FF72AA" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Text="Khoảnh khắc này,&#10;là của bạn." FontSize="36" FontWeight="SemiBold" Margin="0,12"/>
                            <TextBlock Text="Thả lỏng một chút, cười thêm một chút.&#10;Miu giữ lại phần còn lại." Foreground="#E6DDE9" FontSize="16" LineHeight="26"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <ScrollViewer Grid.Column="2" x:Name="FormScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalContentAlignment="Center" PanningMode="VerticalOnly">
                    <Border x:Name="LoginCard" MaxWidth="540" VerticalAlignment="Center" HorizontalAlignment="Stretch" CornerRadius="28">
                        <StackPanel>
                            <TextBlock x:Name="Tagline" Text="BẮT ĐẦU PHIÊN CHỤP" Foreground="#FF72AA" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock x:Name="Title" Text="{Binding LoginTitle}" FontSize="46" FontWeight="Bold" Margin="0,14"/>
                            <TextBlock x:Name="Intro" Text="{Binding LoginIntro}" Foreground="#BBB3C6" FontSize="18" TextWrapping="Wrap" LineHeight="29"/>
                            <StackPanel x:Name="CodePanel" Visibility="{Binding IsCodeMode,Converter={StaticResource UxVisible}}">
                                <Grid x:Name="CodeLabel" Margin="0,30,0,10">
                                    <TextBlock Text="Mã chụp ảnh" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="8 ký tự" FontSize="13" Foreground="#BBB3C6" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid>
                                    <TextBox x:Name="CodeBox" Text="{Binding Code,UpdateSourceTrigger=PropertyChanged}" MaxLength="8" CharacterCasing="Upper" FontSize="32" Height="84" Padding="14,2" TextAlignment="Center" VerticalContentAlignment="Center" GotKeyboardFocus="Code_Focus" PreviewTouchDown="Code_Touch" AutomationProperties.Name="Mã chụp ảnh"/>
                                    <TextBlock Text="N H Ậ P  M Ã" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="#A198AC" FontSize="22" HorizontalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text,ElementName=CodeBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <TextBlock x:Name="Helper" Text="Mã gồm chữ và số, có trên phiếu hoặc tin nhắn của bạn." FontSize="13" Foreground="#BBB3C6" TextWrapping="Wrap" Margin="0,12,0,24" LineHeight="22"/>
                            </StackPanel>
                            <StackPanel Visibility="{Binding IsEmployeeMode,Converter={StaticResource UxVisible}}" Margin="0,20">
                                <TextBlock Text="Mã sự kiện hoặc tài khoản" FontSize="14" Margin="0,0,0,8"/>
                                <TextBox x:Name="AccountName" Text="{Binding Username,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Mã sự kiện hoặc tài khoản"/>
                                <TextBlock Text="Mật khẩu" FontSize="14" Margin="0,12,0,8"/>
                                <PasswordBox x:Name="EmployeePassword" PasswordChanged="EmployeePassword_Changed" Height="54" FontSize="22" Background="#22202A" Foreground="White" BorderBrush="#9D91AA" Padding="12"/>
                            </StackPanel>
                            <Button x:Name="SubmitButton" IsDefault="True" Command="{Binding SubmitCommand}" Style="{StaticResource UxPrimary}" Height="62" HorizontalContentAlignment="Stretch">
                                <Grid>
                                    <TextBlock Text="{Binding SubmitLabel}" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" FontWeight="SemiBold"/>
                                    <TextBlock Text="→" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" HorizontalAlignment="Right"/>
                                </Grid>
                            </Button>
                            <TextBlock Text="{Binding BusyLabel}" Foreground="#BBB3C6" FontSize="14" Margin="0,12,0,0" Visibility="{Binding IsBusy,Converter={StaticResource UxVisible}}"/>
                            <TextBlock Text="{Binding Error}" Foreground="#FFBECD" FontSize="14" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="{Binding HasError,Converter={StaticResource UxVisible}}"/>
                            <Border x:Name="Assist" BorderBrush="#403949" BorderThickness="0,1,0,0" Margin="0,22,0,0" Padding="0,18,0,0">
                                <Grid>
                                    <TextBlock Text="{Binding AlternateHint}" Foreground="#BBB3C6" FontSize="14"/>
                                    <Button x:Name="EventLoginButton" Content="{Binding AlternateLabel}" Click="EventLogin_Click" Style="{StaticResource UxSubtle}" FontSize="14" HorizontalAlignment="Right" Padding="0" MinHeight="44"/>
                                </Grid>
                            </Border>
                            <Button Content="‹ Quay lại màn hình chờ" Command="{Binding BackCommand}" Style="{StaticResource UxSubtle}" Visibility="{Binding IsEmployeeMode,Converter={StaticResource UxVisible}}"/>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </Grid>
        </Grid>
        <Border x:Name="KeyboardPanel" Grid.Row="2" Background="#25212C" BorderBrush="#8E829C" BorderThickness="0,1,0,0" Padding="20,12" Visibility="Collapsed">
            <StackPanel x:Name="Keys" MaxWidth="980">
                <Grid Margin="0,0,0,8">
                    <TextBlock Text="Bàn phím nhập mã" Foreground="#BBB3C6" FontSize="13"/>
                    <Button Content="Ẩn bàn phím ⌄" Click="HideKeyboard_Click" Style="{StaticResource UxSubtle}" FontSize="13" Padding="0" MinHeight="25" HorizontalAlignment="Right" Focusable="False"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
