<UserControl x:Class="PhotoBooth.Customer.UI.Views.CompleteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PhotoBooth.Customer.UI.Controls"
             UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.Resources><ResourceDictionary Source="/PhotoBooth.Customer.UI;component/CustomerViewResources.xaml"/></UserControl.Resources>
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard><Storyboard>
                <DoubleAnimation Storyboard.TargetName="ResultCard" Storyboard.TargetProperty="Opacity"
                                 From="0" To="1" Duration="0:0:0.45"/>
                <DoubleAnimation Storyboard.TargetName="ResultCard"
                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                 From="0.97" To="1" Duration="0:0:0.45">
                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="ResultCard"
                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                 From="0.97" To="1" Duration="0:0:0.45">
                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard></BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>
    <Grid Background="{StaticResource BackgroundBrush}" ClipToBounds="True">
        <Image x:Name="LandscapeBackdrop"
               Source="/PhotoBooth.Customer.UI;component/Assets/default-waiting-landscape.png"
               Stretch="UniformToFill" Opacity="0.72" IsHitTestVisible="False"/>
        <Image x:Name="PortraitBackdrop"
               Source="/PhotoBooth.Customer.UI;component/Assets/default-waiting-portrait.png"
               Stretch="UniformToFill" Opacity="0.72" Visibility="Collapsed" IsHitTestVisible="False"/>
        <Border Background="#6507070B" IsHitTestVisible="False"/>
        <Grid>
            <Ellipse Width="420" Height="420" Fill="#2EFF2F86" HorizontalAlignment="Left"
                     VerticalAlignment="Top" Margin="-240,-260,0,0" IsHitTestVisible="False"/>
            <Ellipse Width="520" Height="520" Fill="#20FF2F86" HorizontalAlignment="Right"
                     VerticalAlignment="Bottom" Margin="0,0,-330,-360" IsHitTestVisible="False"/>
        </Grid>

        <Border x:Name="ResultCard" Margin="54,46" CornerRadius="28" Background="#E8121217"
                BorderBrush="#806F5966" BorderThickness="2" Padding="18"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
            <Grid x:Name="ContentLayout">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="PreviewColumn" Width="*"/>
                    <ColumnDefinition x:Name="QrColumn" Width="540"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="PreviewRow" Height="*"/>
                    <RowDefinition x:Name="QrRow" Height="0"/>
                </Grid.RowDefinitions>

                <Border x:Name="GifPanel" Margin="0,0,18,0" CornerRadius="20"
                        BorderBrush="{StaticResource AccentBrush}" BorderThickness="2"
                        Background="{StaticResource PreviewBackdropBrush}" Padding="12"
                        ClipToBounds="True">
                    <Grid>
                        <TextBlock Text="Đang chuẩn bị ảnh của bạn…"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="20" VerticalAlignment="Center"/>
                        <controls:AnimatedImage Stretch="Uniform"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch">
                            <controls:AnimatedImage.Style>
                                <Style TargetType="{x:Type controls:AnimatedImage}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Setter Property="SourcePath" Value="{x:Null}"/>
                                    <Style.Triggers>
                                        <!-- GIF is a fallback only. Never render it
                                             behind the final framed composition. -->
                                        <DataTrigger Binding="{Binding FinalImagePath}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Setter Property="SourcePath" Value="{Binding GifPath}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </controls:AnimatedImage.Style>
                        </controls:AnimatedImage>
                        <!-- Prefer the final framed composition. If it is not
                             available yet, the animated capture preview below
                             remains visible as a graceful fallback. -->
                        <Image Source="{Binding FinalImagePath,Converter={StaticResource CustomerPathImage},ConverterParameter=1600}"
                               Stretch="Uniform" HorizontalAlignment="Stretch"
                               VerticalAlignment="Stretch" Panel.ZIndex="2"/>
                    </Grid>
                </Border>

                <Border x:Name="QrPanel" Grid.Column="1" CornerRadius="22" Background="#FFFDFB"
                        BorderBrush="#80FF2F86" BorderThickness="2" Padding="30">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="QUÉT MÃ ĐỂ NHẬN ẢNH" Foreground="#141217"
                                   FontSize="28" FontWeight="Bold" TextWrapping="Wrap"
                                   Margin="0,0,0,18"/>
                        <Border x:Name="QrCodeSurface" Grid.Row="1" Background="White"
                                BorderBrush="#30FF2F86" BorderThickness="1"
                                CornerRadius="14" Padding="18"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                MaxWidth="390" MaxHeight="390">
                            <Grid>
                                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Foreground="#746E78"
                                           FontSize="17" VerticalAlignment="Center">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding HasQr}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                                <Image Source="{Binding QrSource,Converter={StaticResource CustomerByteImage}}"
                                       Stretch="Uniform" Panel.ZIndex="1"/>
                            </Grid>
                        </Border>
                        <TextBlock Grid.Row="2" Text="{Binding StatusText}" TextWrapping="Wrap"
                                   Foreground="#343039" FontSize="18" Margin="0,16,0,0"/>
                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center"
                                    Margin="0,14,0,12">
                            <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding HasQr}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                            <Border Width="34" Height="34" CornerRadius="17"
                                    BorderBrush="{StaticResource AccentBrush}" BorderThickness="3"
                                    Margin="0,0,10,0">
                                <TextBlock Text="◷" Foreground="{StaticResource AccentBrush}"
                                           FontSize="22" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Foreground="{StaticResource AccentBrush}" FontSize="22"
                                       FontWeight="Bold" VerticalAlignment="Center">
                                <Run Text="Còn "/><Run Text="{Binding RemainingSeconds,Mode=OneWay}"/><Run Text=" giây"/>
                            </TextBlock>
                        </StackPanel>
                        <Button Style="{DynamicResource UxPrimary}" x:Name="DoneButton" Grid.Row="4" Content="HOÀN TẤT"
                                Command="{Binding DoneCommand}" Height="68" Width="Auto"
                                HorizontalAlignment="Stretch" FontSize="20" Margin="0,8,0,0">
                            <Button.Resources><ResourceDictionary Source="/PhotoBooth.Customer.UI;component/Themes/ApprovedUx.xaml"/></Button.Resources>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
