<UserControl x:Class="PhotoBooth.Customer.UI.Views.CompleteView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:PhotoBooth.Customer.UI.Controls"
 Background="#FFF8FB">
 <Grid Background="#FFF8FB" Margin="42,34">
  <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Margin="0,10,28,10" CornerRadius="24" Background="Transparent" ClipToBounds="True">
   <Grid Background="Transparent">
    <TextBlock Text="GIF đang được tạo…" Foreground="White" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    <Border Background="White" CornerRadius="12" Padding="16,16,16,68" HorizontalAlignment="Center" VerticalAlignment="Center">
     <controls:AnimatedImage SourcePath="{Binding GifPath}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
   </Grid>
  </Border>
  <Border Grid.Column="1" Margin="0,10,0,10" CornerRadius="28" Background="#9C989C" Padding="26">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="White" CornerRadius="22" Padding="18"><Image Source="{Binding QrSource,Converter={StaticResource CustomerByteImage}}" Stretch="Uniform"/></Border>
    <TextBlock Grid.Row="1" Text="{Binding RemainingSeconds}" FontSize="58" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center" Margin="0,18,0,0"/>
    <TextBlock Grid.Row="2" Text="{Binding StatusText}" FontSize="17" Foreground="#3F303A" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0"/>
   </Grid>
  </Border>
  <Button Grid.Row="1" Grid.ColumnSpan="2" Content="Hoàn tất" Command="{Binding DoneCommand}" Width="220" HorizontalAlignment="Center" Margin="0,14,0,0"/>
 </Grid>
</UserControl>
