<UserControl x:Class="PhotoBooth.Customer.UI.Views.CompleteView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:PhotoBooth.Customer.UI.Controls">
 <Grid Background="{StaticResource BackgroundBrush}" Margin="32,26,32,24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="8,0,8,18"><TextBlock Text="Ảnh của bạn đã sẵn sàng" Style="{StaticResource PageTitle}"/><TextBlock Text="Quét mã QR để tải ảnh về điện thoại" Style="{StaticResource PageSubtitle}"/></StackPanel>
  <Grid x:Name="ContentLayout" Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition x:Name="PreviewColumn" Width="*"/><ColumnDefinition x:Name="QrColumn" Width="360"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition x:Name="PreviewRow" Height="*"/><RowDefinition x:Name="QrRow" Height="0"/></Grid.RowDefinitions>
   <Border x:Name="GifPanel" Style="{StaticResource SoftCard}" Margin="0,0,14,0" Padding="20"><Grid><TextBlock Text="Đang tạo ảnh động…" Foreground="{StaticResource MutedTextBrush}" FontSize="20" VerticalAlignment="Center"/><Border Background="#0A0A0D" CornerRadius="12" Padding="14" HorizontalAlignment="Center" VerticalAlignment="Center"><controls:AnimatedImage SourcePath="{Binding GifPath}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid></Border>
   <Border x:Name="QrPanel" Grid.Column="1" Style="{StaticResource SoftCard}" Margin="0" Padding="24"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Background="White" CornerRadius="14" Padding="18"><Image Source="{Binding QrSource,Converter={StaticResource CustomerByteImage}}" Stretch="Uniform"/></Border><TextBlock Grid.Row="1" Text="{Binding RemainingSeconds}" FontSize="46" FontWeight="SemiBold" Foreground="White" Margin="0,16,0,0"/><TextBlock Grid.Row="2" Text="{Binding StatusText}" FontSize="15" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/></Grid></Border>
  </Grid>
  <Button Grid.Row="2" Content="Hoàn tất" Command="{Binding DoneCommand}" Width="220" HorizontalAlignment="Center" Margin="0,18,0,0"/>
 </Grid>
</UserControl>
