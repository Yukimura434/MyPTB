<UserControl x:Class="PhotoBooth.Customer.UI.Views.CaptureView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:color="clr-namespace:PhotoBooth.Color.D3D11;assembly=PhotoBooth.Color.D3D11">
 <Grid Background="#08080A" ClipToBounds="True">
  <!-- Full-bleed live view: UniformToFill removes pillar-box bars. -->
  <TextBlock Text="Không có tín hiệu camera" FontSize="26" Foreground="#77737D" VerticalAlignment="Center"/>
  <Grid RenderTransformOrigin="0.5,0.5">
   <Grid.RenderTransform><ScaleTransform ScaleX="{Binding LiveViewScaleX}"/></Grid.RenderTransform>
   <Image Source="{Binding LiveImage,Converter={StaticResource ByteImage}}" Stretch="UniformToFill"/>
   <color:LiveColorSurface Failed="OnGpuLiveColorFailed" FrameData="{Binding LiveImage}" LutValues="{Binding LiveColor.Values}" LutSize="{Binding LiveColor.Size}" DomainMin="{Binding LiveColor.DomainMin}" DomainMax="{Binding LiveColor.DomainMax}" Strength="{Binding LiveColor.Strength}" Visibility="{Binding LiveColor.IsEnabled,Converter={StaticResource BoolVisibility}}"/>
  </Grid>
  <Border VerticalAlignment="Top" HorizontalAlignment="Center" Background="#C9141419" BorderBrush="#44FFFFFF" BorderThickness="1" CornerRadius="18" Padding="20,9" Margin="20">
   <TextBlock Text="{Binding ProgressText}" FontSize="17" FontWeight="SemiBold" Foreground="White"/>
  </Border>

  <Border VerticalAlignment="Bottom" Background="#B30B0B0E" BorderBrush="#292830" BorderThickness="0,1,0,0" Padding="24,16">
   <Grid>
    <Button Content="Bắt đầu chụp" Command="{Binding StartCommand}" Width="250" Height="60" FontSize="20" Visibility="{Binding IsIdle,Converter={StaticResource BoolVisibility}}" HorizontalAlignment="Center"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Visibility="{Binding IsPreview,Converter={StaticResource BoolVisibility}}">
     <Button Content="Chụp lại ảnh đã chọn" Command="{Binding RetakeCommand}" Style="{StaticResource SecondaryButton}" MinWidth="230"/>
     <Button Content="Tiếp tục chọn frame" Command="{Binding SelectFrameCommand}" MinWidth="230"/>
    </StackPanel>
   </Grid>
  </Border>

  <Border Background="#52000000" IsHitTestVisible="True" Visibility="{Binding IsCountdown,Converter={StaticResource BoolVisibility}}">
   <Grid><Border Width="250" Height="250" Background="#B315151A" BorderBrush="#55FFFFFF" BorderThickness="1" CornerRadius="125"/><TextBlock Text="{Binding CountdownNumber}" FontSize="150" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"><TextBlock.Triggers><EventTrigger RoutedEvent="FrameworkElement.Loaded"><BeginStoryboard><Storyboard RepeatBehavior="Forever"><DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.65" To="1" Duration="0:0:0.4" AutoReverse="True"/></Storyboard></BeginStoryboard></EventTrigger></TextBlock.Triggers></TextBlock></Grid>
  </Border>
  <Border Background="#62000000" IsHitTestVisible="True" Visibility="{Binding IsSmile,Converter={StaticResource BoolVisibility}}"><StackPanel VerticalAlignment="Center"><TextBlock Text="😊" FontSize="120"/><TextBlock Text="Cười lên nào!" FontSize="58" FontWeight="SemiBold" Foreground="White"/></StackPanel></Border>
  <Border Background="White" IsHitTestVisible="True" Visibility="{Binding IsShutterFlash,Converter={StaticResource BoolVisibility}}"/>

  <Border Background="#F20E0E11" Visibility="{Binding IsInterShotDelay,Converter={StaticResource BoolVisibility}}"><StackPanel VerticalAlignment="Center"><Border Width="72" Height="72" CornerRadius="36" Background="#283C2F" Margin="0,0,0,22"><TextBlock Text="✓" FontSize="38" Foreground="#79D69E" VerticalAlignment="Center"/></Border><TextBlock Text="Ảnh đẹp!" FontSize="44" FontWeight="SemiBold"/><TextBlock Text="{Binding StatusMessage}" FontSize="21" Foreground="{StaticResource MutedTextBrush}" Margin="0,12,0,26"/><ProgressBar IsIndeterminate="True" Width="320" Height="6" Foreground="{StaticResource AccentBrush}" Background="#292830"/></StackPanel></Border>

  <Border Background="#F20E0E11" Visibility="{Binding IsPreview,Converter={StaticResource BoolVisibility}}" Margin="28,28,28,104" CornerRadius="18" Padding="14" BorderBrush="#303039" BorderThickness="1">
   <Grid x:Name="ReviewLayout"><Grid.ColumnDefinitions><ColumnDefinition x:Name="ReviewImageColumn" Width="*"/><ColumnDefinition x:Name="ReviewListColumn" Width="230"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition x:Name="ReviewImageRow" Height="*"/><RowDefinition x:Name="ReviewListRow" Height="0"/></Grid.RowDefinitions>
    <Border x:Name="ReviewImagePanel" Margin="0,0,12,0" CornerRadius="12" Background="#08080A" ClipToBounds="True"><Image Source="{Binding SelectedReviewPhoto.Path,Converter={StaticResource CustomerPathImage}}" Stretch="Uniform"/></Border>
    <Border x:Name="ReviewListPanel" Grid.Column="1" CornerRadius="12" Background="#17171C" Padding="7" ClipToBounds="True">
     <ListBox ItemsSource="{Binding ReviewPhotos}" SelectedItem="{Binding SelectedReviewPhoto}"
              ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
              ScrollViewer.PanningMode="VerticalOnly" HorizontalContentAlignment="Stretch">
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/></Style></ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate><Grid Margin="4" ClipToBounds="True"><Border Height="135" HorizontalAlignment="Stretch" CornerRadius="10" Background="#24242B" ClipToBounds="True"><Image Source="{Binding Path,Converter={StaticResource CustomerPathImage}}" Stretch="UniformToFill" HorizontalAlignment="Stretch"/></Border><Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="7" Background="#D9141419" CornerRadius="12" Padding="7,3"><TextBlock Text="{Binding Number}" FontWeight="Bold" Foreground="White"/></Border><CheckBox IsChecked="{Binding IsRetakeSelected,Mode=TwoWay}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="9" Width="28" Height="28"><CheckBox.Template><ControlTemplate TargetType="CheckBox"><Grid><Ellipse Fill="#17171C" Stroke="#E85D9E" StrokeThickness="3"/><Ellipse x:Name="Dot" Margin="6" Fill="#E85D9E" Visibility="Collapsed"/></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Dot" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></CheckBox.Template></CheckBox></Grid></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </Border>
   </Grid>
  </Border>

  <Border Background="#F20E0E11" Visibility="{Binding IsPrinting,Converter={StaticResource BoolVisibility}}"><StackPanel VerticalAlignment="Center"><ProgressBar IsIndeterminate="True" Width="320" Height="6" Foreground="{StaticResource AccentBrush}" Background="#292830"/><TextBlock Text="Đang in ảnh của bạn" FontSize="36" FontWeight="SemiBold" Margin="0,28,0,8"/><TextBlock Text="Vui lòng chờ trong giây lát…" FontSize="20" Foreground="{StaticResource MutedTextBrush}"/></StackPanel></Border>
  <Border Background="#E60A0A0D" Visibility="{Binding HasError,Converter={StaticResource BoolVisibility}}"><Border Style="{StaticResource SoftCard}" Width="520" VerticalAlignment="Center"><StackPanel><TextBlock Text="Có lỗi xảy ra" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,12"/><TextBlock Text="{Binding ErrorMessage}" FontSize="18" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0"><Button Content="Thử lại" Command="{Binding RetryCommand}"/><Button Content="Hủy" Command="{Binding CancelErrorCommand}" Style="{StaticResource SecondaryButton}"/></StackPanel></StackPanel></Border></Border>
 </Grid>
</UserControl>
