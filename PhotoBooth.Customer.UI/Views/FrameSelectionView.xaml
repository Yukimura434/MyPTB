<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:PhotoBooth.Customer.UI.Controls" x:Class="PhotoBooth.Customer.UI.Views.FrameSelectionView" UseLayoutRounding="True" RenderOptions.BitmapScalingMode="HighQuality" Background="#111015">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PhotoBooth.Customer.UI;component/CustomerViewResources.xaml"/>
                <ResourceDictionary Source="/PhotoBooth.Customer.UI;component/Themes/ApprovedUx.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="HeaderRow" Height="80"/>
            <RowDefinition/>
            <RowDefinition x:Name="FooterRow" Height="92"/>
        </Grid.RowDefinitions>
        <controls:CustomerHeader Step="2"/>
        <Grid x:Name="WorkspaceGrid" Grid.Row="1" Margin="34,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition x:Name="ToolGap" Width="28"/>
                <ColumnDefinition x:Name="ToolColumn" Width="350"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition x:Name="ToolRowGap" Height="0"/>
                <RowDefinition x:Name="ToolRow" Height="0"/>
            </Grid.RowDefinitions>
            <Grid x:Name="PreviewPanel">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel x:Name="PreviewHeading" Margin="0,0,0,14">
                    <TextBlock RenderTransformOrigin="0,0" x:Name="PreviewTitle" Text="Thêm chút riêng của bạn." LineHeight="31.36" LineStackingStrategy="BlockLineHeight" FontSize="28" FontWeight="Bold">
                        <TextBlock.RenderTransform>
                            <ScaleTransform ScaleX="0.95"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock x:Name="PreviewSubtitle" Text="Chọn khung, thử màu, rồi giữ lại khoảnh khắc này." Foreground="#BBB3C6" FontSize="13" Margin="0,7,0,0"/>
                </StackPanel>
                <Border Grid.Row="1" Background="{StaticResource UxDots}" CornerRadius="22" Padding="40" ClipToBounds="True">
                    <Viewbox x:Name="PaperPreview" UseLayoutRounding="False" SnapsToDevicePixels="False" Stretch="Uniform">
                        <Grid Width="{Binding SelectedFrame.PixelWidth}" Height="{Binding SelectedFrame.PixelHeight}" Background="White">
                            <ItemsControl ItemsSource="{Binding FrameSlots}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                        <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Width="{Binding Width}" Height="{Binding Height}">
                                            <controls:MediaSlotControl SourcePath="{Binding PhotoPath}" Zoom="{Binding MediaZoom,Mode=TwoWay}" CenterX="{Binding MediaCenterX,Mode=TwoWay}" CenterY="{Binding MediaCenterY,Mode=TwoWay}" SelectCommand="{Binding DataContext.SelectSlotCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" SelectCommandParameter="{Binding}" ToolTip="Kéo ảnh để căn vị trí; dùng hai ngón hoặc nút +/− để phóng to"/>
                                            <Border BorderBrush="#8B174B" BorderThickness="4" IsHitTestVisible="False">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding IsSelected}" Value="True"/>
                                                                    <Condition Binding="{Binding Tag,RelativeSource={RelativeSource AncestorType=UserControl}}" Value="photos"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Image Source="{Binding SelectedFrame.SourcePath,Converter={StaticResource CustomerPathImage},ConverterParameter=1280}" Stretch="Fill" IsHitTestVisible="False"/>
                        </Grid>
                    </Viewbox>
                </Border>
                <TextBlock Grid.Row="2" x:Name="PreviewCaption" Height="22" Text="{Binding SelectedFrame.Name,StringFormat=✓  Ảnh xem trước · {0}}" Foreground="#BBB3C6" FontSize="13" HorizontalAlignment="Center" Margin="0,14,0,0"/>
            </Grid>
            <Border x:Name="Tools" Grid.Column="2" Background="#1D1B24" BorderBrush="#403949" BorderThickness="1" CornerRadius="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="TabsRow" Height="67"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Border x:Name="TabsBorder" BorderBrush="#403949" BorderThickness="0,0,0,1" Padding="8">
                        <UniformGrid x:Name="TabButtons" Columns="3">
                            <RadioButton x:Name="FrameTab" GroupName="FrameTools" Style="{StaticResource UxTab}" IsChecked="True" Checked="Tool_Checked" Tag="frames">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="22" Height="22" Margin="0,0,7,0">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M4,3 L20,3 L20,21 L4,21Z M7,7 L17,7 L17,17 L7,17Z" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.7"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="Khung" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=RadioButton}}" FontSize="{Binding FontSize,RelativeSource={RelativeSource AncestorType=RadioButton}}" FontWeight="SemiBold"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="FrameTools" Style="{StaticResource UxTab}" Checked="Tool_Checked" Tag="colors">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="22" Height="22" Margin="0,0,7,0">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M12,4 A8,8 0 1 1 11.99,4 M12,4 L12,20 M4,12 L20,12" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.7"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="Màu" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=RadioButton}}" FontSize="{Binding FontSize,RelativeSource={RelativeSource AncestorType=RadioButton}}" FontWeight="SemiBold"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="FrameTools" Style="{StaticResource UxTab}" Checked="Tool_Checked" Tag="photos">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="22" Height="22" Margin="0,0,7,0">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M3,4 L21,4 L21,20 L3,20Z M7,9 A2,2 0 1 1 6.99,9 M4,18 L10,13 L14,16 L17,12 L20,17" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.7"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="Ảnh" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=RadioButton}}" FontSize="{Binding FontSize,RelativeSource={RelativeSource AncestorType=RadioButton}}" FontWeight="SemiBold"/>
                                </StackPanel>
                            </RadioButton>
                        </UniformGrid>
                    </Border>
                    <Grid Grid.Row="1" x:Name="ToolContent" Margin="20">
                        <Grid x:Name="FramesPanel">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="ToolTitle" Text="Chọn khung bạn thích" FontSize="18" FontWeight="Bold" Margin="0,0,0,17"/>
                            <ListBox x:Name="FrameList" Grid.Row="1" ItemsSource="{Binding PinnedFrames}" SelectedItem="{Binding SelectedFrame}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <Image x:Name="FrameThumb" Width="82" Source="{Binding ThumbnailPath,Converter={StaticResource CustomerPathImage},ConverterParameter=320}" Height="{Binding Tag,RelativeSource={RelativeSource AncestorType=ListBox}}" Stretch="Uniform" Margin="0,0,0,12" RenderTransformOrigin="0.5,0.5">
                                                <Image.RenderTransform>
                                                    <RotateTransform Angle="-3"/>
                                                </Image.RenderTransform>
                                            </Image>
                                            <TextBlock x:Name="FrameName" LineStackingStrategy="BlockLineHeight" LineHeight="18" Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock x:Name="FrameDetails" Text="{Binding Slots.Count,StringFormat={}{0} ảnh}" FontSize="11" Foreground="#BBB3C6" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Tag,RelativeSource={RelativeSource AncestorType=ListBox}}" Value="85">
                                                <Setter TargetName="FrameThumb" Property="Width" Value="58"/>
                                                <Setter TargetName="FrameThumb" Property="Margin" Value="0,0,0,8"/>
                                                <Setter TargetName="FrameName" Property="FontSize" Value="13"/>
                                                <Setter TargetName="FrameName" Property="LineHeight" Value="17"/>
                                                <Setter TargetName="FrameDetails" Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="FrameNote" Grid.Row="2" Text="Chạm khung để xem trước. Bạn có thể đổi lại bất cứ lúc nào." Foreground="#BBB3C6" FontSize="13" TextWrapping="Wrap" Margin="0,18,0,0"/>
                            <TextBlock Text="Chưa có khung ảnh. Nhờ nhân viên hỗ trợ." TextWrapping="Wrap" Foreground="#BBB3C6" Grid.Row="1">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PinnedFrames.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <Grid x:Name="ColorsPanel" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ListBox x:Name="PresetList" ItemsSource="{Binding PinnedPresets}" SelectedItem="{Binding SelectedPreset}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Width="96">
                                            <Image Source="{Binding PreviewBytes,Converter={StaticResource CustomerByteImage}}" Height="85" Stretch="UniformToFill" Margin="0,0,0,8"/>
                                            <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="Chưa có màu ảnh được chọn." Foreground="#BBB3C6" FontSize="14" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasPinnedPresets}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Grid Grid.Row="1" Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>
                                <Slider Minimum="0" Maximum="100" Value="{Binding PresetStrengthPercent}" IsEnabled="{Binding CanApplyPreset}"/>
                                <TextBlock Grid.Column="1" Text="{Binding PresetStrengthText}" FontSize="13"/>
                            </Grid>
                            <StackPanel Grid.Row="2">
                                <TextBlock Text="{Binding PresetStatus}" FontSize="12" Foreground="#BBB3C6" TextWrapping="Wrap"/>
                                <UniformGrid Columns="3">
                                    <Button Content="Áp dụng" Command="{Binding ApplyPresetToPhotoCommand}" Padding="6" FontSize="13" Margin="2"/>
                                    <Button Content="Tất cả" Command="{Binding ApplyPresetToAllCommand}" Padding="6" FontSize="13" Margin="2"/>
                                    <Button Content="Hủy" Command="{Binding CancelPresetCommand}" Padding="6" FontSize="13" Margin="2"/>
                                </UniformGrid>
                            </StackPanel>
                        </Grid>
                        <Grid x:Name="PhotosPanel" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Chạm ô ảnh, rồi chọn ảnh thay thế" FontSize="14" Margin="0,0,0,12"/>
                            <ListBox x:Name="CapturedPhotoList" Grid.Row="1" ItemsSource="{Binding CapturedPhotos}" SelectionChanged="Photo_Changed">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Width="96">
                                            <Image Source="{Binding Path,Converter={StaticResource CustomerPathImage},ConverterParameter=360}" Height="85" Stretch="UniformToFill"/>
                                            <TextBlock Text="{Binding Number,StringFormat=Ảnh {0}}" FontSize="13" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <DockPanel Grid.Row="2" Margin="0,8,0,0">
                                <TextBlock Text="Phóng ảnh" FontSize="13" Margin="0,0,12,0"/>
                                <Slider Minimum="1" Maximum="2" Value="{Binding SelectedSlot.MediaZoom,Mode=TwoWay}"/>
                            </DockPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <Border Grid.Row="2" Background="#19171E" BorderBrush="#403949" BorderThickness="0,1,0,0">
            <Grid x:Name="Footer" Margin="34,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="BackButton" Content="‹  Chụp lại" Command="{Binding CancelCommand}" Style="{StaticResource UxSubtle}"/>
                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="FooterTitle" Text="Đẹp theo cách của bạn" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock x:Name="FooterHint" Text="Bạn vẫn có thể quay lại chỉnh sửa." FontSize="14" Foreground="#BBB3C6" Margin="0,4,0,0"/>
                </StackPanel>
                <Button x:Name="FinishButton" Grid.Column="2" Content="Tiếp tục  →" VerticalAlignment="Center" Click="Continue_Click" IsEnabled="{Binding CanFinish}" Style="{StaticResource UxPrimary}" MinWidth="220"/>
            </Grid>
        </Border>
        <Border x:Name="Confirmation" KeyboardNavigation.TabNavigation="Cycle" Grid.RowSpan="3" Background="#BB0B0813" Visibility="Collapsed">
            <Border MaxWidth="540" Margin="24" Padding="30" CornerRadius="22" Background="#25202C" BorderBrush="#AC98BD" BorderThickness="1" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Sẵn sàng giữ lại khoảnh khắc này?" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding SelectedFrame.Name}" FontSize="16" Foreground="#D4C9DC" Margin="0,12,0,18"/>
                    <StackPanel Orientation="Horizontal" IsEnabled="{Binding CanChangePrintCopies}" Visibility="{Binding CanChangePrintCopies,Converter={StaticResource UxVisible}}">
                        <TextBlock Text="Số bản in" Margin="0,0,20,0"/>
                        <Button Content="−" Command="{Binding DecreaseCopiesCommand}"/>
                        <TextBlock Text="{Binding PrintCopies}" Margin="20,0"/>
                        <Button Content="+" Command="{Binding IncreaseCopiesCommand}"/>
                    </StackPanel>
                    <Button Content="Bỏ qua in" Click="SkipPrint_Click" Visibility="{Binding CanSkipPrint,Converter={StaticResource UxVisible}}" Margin="0,18,0,0" HorizontalAlignment="Stretch"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,26,0,0">
                        <Button x:Name="ContinueEditing" Content="Chỉnh thêm" Click="Edit_Click" Margin="0,0,12,0"/>
                        <Button Click="Finish_Click" Style="{StaticResource UxPrimary}">
                            <Button.Content>
                                <TextBlock Foreground="#291020">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Nhận ảnh"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PrintingEnabled}" Value="True">
                                                    <Setter Property="Text" Value="In &amp; nhận ảnh"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button.Content>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
        <Border Grid.RowSpan="3" Background="#E6111015" Visibility="{Binding IsPrinting,Converter={StaticResource UxVisible}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Đang chuẩn bị ảnh…" FontSize="30"/>
                <TextBlock Text="Vui lòng chờ trong giây lát." Foreground="#BBB3C6" Margin="0,16,0,0"/>
            </StackPanel>
        </Border>
        <Border Grid.RowSpan="3" Background="#E6111015" Visibility="{Binding HasError,Converter={StaticResource UxVisible}}">
            <StackPanel VerticalAlignment="Center" MaxWidth="480" Margin="24">
                <TextBlock Text="{Binding ErrorMessage}" FontSize="24" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                    <Button Content="Thử lại" Command="{Binding RetryCommand}" Margin="0,0,12,0"/>
                    <Button Content="Đóng" Command="{Binding CancelErrorCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
