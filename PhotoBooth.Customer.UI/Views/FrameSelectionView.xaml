<UserControl x:Class="PhotoBooth.Customer.UI.Views.FrameSelectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="CompactControlButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="46"/><Setter Property="MinHeight" Value="44"/>
            <Setter Property="Width" Value="46"/><Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="3"/>
            <Setter Property="FontSize" Value="22"/><Setter Property="Background" Value="#35313B"/>
        </Style>
        <Style x:Key="SlotButton" TargetType="Button">
            <!-- The composed preview underneath already applies the real frame
                 alpha mask and UniformToFill crop. This button is hit-testing
                 only; it must not add rounded corners, borders or tint. -->
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#100F13">
        <Grid Margin="28,24,28,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,14">
                <TextBlock Text="Chọn frame và sắp xếp ảnh" FontSize="34" FontWeight="SemiBold" Foreground="White"/>
                <StackPanel HorizontalAlignment="Right">
                    <TextBlock Text="{Binding AssignmentStatus}" HorizontalAlignment="Right" FontSize="20" FontWeight="SemiBold" Foreground="White"/>
                    <TextBlock Text="{Binding Guidance}" HorizontalAlignment="Right" FontSize="15" Foreground="#A8A4AE"/>
                </StackPanel>
            </Grid>

            <Grid x:Name="WorkspaceGrid" Grid.Row="1">
                <Grid.RowDefinitions><RowDefinition x:Name="WorkspaceTopRow" Height="*"/><RowDefinition x:Name="WorkspaceBottomRow" Height="0"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="260"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="FramesPanel" Style="{StaticResource SoftCard}" Background="#19171D" Padding="8">
                    <DockPanel>
                        <TextBlock Text="FRAME" DockPanel.Dock="Top" FontSize="18" FontWeight="Bold" Foreground="#C9A7BB" Margin="6,2,6,8"/>
                        <ListBox ItemsSource="{Binding PinnedFrames}" SelectedItem="{Binding SelectedFrame}"
                                 Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Center"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,4"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="FrameBox" Height="240" Padding="8" CornerRadius="12"
                                                Background="#242129" BorderBrush="#554451" BorderThickness="2">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="FrameBox" Property="BorderBrush" Value="#EF5DA8"/>
                                                        <Setter TargetName="FrameBox" Property="BorderThickness" Value="5"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Image Source="{Binding ThumbnailPath,Converter={StaticResource CustomerPathImage}}"
                                           Height="220" MaxWidth="240" Stretch="Uniform" SnapsToDevicePixels="True"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <Border x:Name="PreviewPanel" Grid.Column="2" Style="{StaticResource SoftCard}" Background="#151319" Padding="0" ClipToBounds="True">
                    <Grid>
                        <TextBlock Text="Đang tạo bản xem trước..." Foreground="#A8929F" FontSize="20"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <ScrollViewer x:Name="PreviewHost" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                      Background="#151319" PanningMode="Both" PanningDeceleration="0.001" Margin="8">
                            <Viewbox Stretch="Uniform" StretchDirection="Both"
                                     Width="{Binding ViewportWidth,ElementName=PreviewHost}"
                                     Height="{Binding ViewportHeight,ElementName=PreviewHost}">
                                <Viewbox.LayoutTransform><ScaleTransform ScaleX="{Binding ZoomScale}" ScaleY="{Binding ZoomScale}"/></Viewbox.LayoutTransform>
                                <Grid Width="{Binding SelectedFrame.PixelWidth}" Height="{Binding SelectedFrame.PixelHeight}" Background="#211E25">
                                    <Image Source="{Binding PreviewPath,Converter={StaticResource CustomerPathImage}}" Stretch="Fill"/>
                                    <ItemsControl ItemsSource="{Binding FrameSlots}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding X}"/><Setter Property="Canvas.Top" Value="{Binding Y}"/></Style></ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate><DataTemplate><Button Style="{StaticResource SlotButton}" Width="{Binding Width}" Height="{Binding Height}" Content="{Binding Number}" Command="{Binding DataContext.SelectSlotCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="Chạm để đặt ảnh vào ô này"/></DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Viewbox>
                        </ScrollViewer>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="18" Padding="5"
                                Background="#E619171E" CornerRadius="24">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="−" Command="{Binding ZoomOutCommand}" Style="{StaticResource CompactControlButton}" ToolTip="Thu nhỏ"/>
                                <Button Content="{Binding ZoomText}" Command="{Binding ResetZoomCommand}" MinWidth="76" Height="44" Padding="10,0" Margin="3" FontSize="16" Background="#292630" ToolTip="Trở về 100%"/>
                                <Button Content="+" Command="{Binding ZoomInCommand}" Style="{StaticResource CompactControlButton}" ToolTip="Phóng to"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Border x:Name="PhotosPanel" Grid.Column="4" Style="{StaticResource SoftCard}" Background="#19171D" Padding="8">
                    <DockPanel>
                        <TextBlock Text="ẢNH ĐÃ CHỤP" DockPanel.Dock="Top" FontSize="18" FontWeight="Bold" Foreground="#C9A7BB" Margin="6,2,6,8"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding CapturedPhotos}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.SelectPhotoCommand,RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" Padding="5" Margin="4" Background="#242129" BorderThickness="3" Cursor="Hand">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Setter Property="BorderBrush" Value="#E5B4CA"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="BorderBrush" Value="#EF5DA8"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Grid>
                                                <Image Source="{Binding Path,Converter={StaticResource CustomerPathImage}}" Height="150" Width="210" Stretch="Uniform"/>
                                                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Background="#CC27232A" CornerRadius="12" Padding="8,4">
                                                    <TextBlock Text="{Binding Number}" Foreground="White" FontSize="16" FontWeight="Bold"/>
                                                </Border>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="2" Margin="0,16,0,0">
                <Button Content="Bỏ ảnh khỏi ô đang chọn" Command="{Binding ClearSlotCommand}" HorizontalAlignment="Left"
                        Background="#85687A" Width="230"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Quay lại" Command="{Binding CancelCommand}" Background="#CE93D8"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0" IsEnabled="{Binding PrintingEnabled}">
                        <TextBlock Text="Số bản in" FontSize="18" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Button Content="−" Command="{Binding DecreaseCopiesCommand}" Style="{StaticResource CompactControlButton}"/>
                        <Border Width="58" Height="44" Margin="3" Background="#211F26" BorderBrush="#4A4551" BorderThickness="1" CornerRadius="8">
                            <TextBlock Text="{Binding PrintCopies}" FontSize="20" Foreground="White" VerticalAlignment="Center"/>
                        </Border>
                        <Button Content="+" Command="{Binding IncreaseCopiesCommand}" Style="{StaticResource CompactControlButton}"/>
                    </StackPanel>
                    <Button Content="Tiếp tục ghép Motion Photo" Command="{Binding PrintCommand}" Width="260"/>
                </StackPanel>
            </Grid>

            <Border Grid.RowSpan="3" Background="#E60A0A0D" Visibility="{Binding HasError,Converter={StaticResource BoolVisibility}}">
                <Border Style="{StaticResource SoftCard}" Width="520" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="{Binding ErrorMessage}" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="Thử lại" Command="{Binding RetryCommand}"/>
                            <Button Content="Đóng" Command="{Binding CancelErrorCommand}" Background="#CE93D8"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Grid>
</UserControl>
