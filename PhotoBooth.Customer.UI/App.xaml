<Application x:Class="PhotoBooth.Customer.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PhotoBooth.Customer.UI.ViewModels"
             xmlns:views="clr-namespace:PhotoBooth.Customer.UI.Views"
             xmlns:conv="clr-namespace:PhotoBooth.Customer.UI.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/PastelTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:ByteArrayImageConverter x:Key="ByteImage"/>

            <DataTemplate DataType="{x:Type vm:PrinterConnectionViewModel}">
                <views:PrinterConnectionView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CaptureViewModel}">
                <views:CaptureView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:FrameSelectionViewModel}">
                <views:FrameSelectionView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CompleteViewModel}">
                <views:CompleteView/>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>