<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========== Color Brushes ========== -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#FFF8FB" />
    <SolidColorBrush x:Key="PinkBrush" Color="#F8BBD0" />
    <SolidColorBrush x:Key="AccentBrush" Color="#F48FB1" />
    <SolidColorBrush x:Key="PurpleBrush" Color="#CE93D8" />

    <!-- ========== Converters ========== -->
    <BooleanToVisibilityConverter x:Key="BoolVisibility" />

    <!-- ========== Base Control Styles ========== -->
    
    <!-- Window Style -->
    <Style TargetType="Window">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="Foreground" Value="#5F4655" />
    </Style>

    <!-- UserControl Style -->
    <Style TargetType="UserControl">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="Foreground" Value="#5F4655" />
    </Style>

    <!-- TextBlock Style -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="#5F4655" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <!-- ========== Button Style ========== -->
    <Style TargetType="Button">
        <Setter Property="MinHeight" Value="56" />
        <Setter Property="MinWidth" Value="140" />
        <Setter Property="Padding" Value="28,14" />
        <Setter Property="Margin" Value="10" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border 
                        Background="{TemplateBinding Background}"
                        CornerRadius="28"
                        Padding="{TemplateBinding Padding}">
                        <ContentPresenter 
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== Custom Component Styles ========== -->
    
    <!-- Soft Card Style with Shadow -->
    <Style x:Key="SoftCard" TargetType="Border">
        <Setter Property="Background" Value="White" />
        <Setter Property="CornerRadius" Value="24" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="Margin" Value="16" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect 
                    BlurRadius="22"
                    ShadowDepth="3"
                    Opacity="0.13"
                    Color="#7B4A68" />
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
