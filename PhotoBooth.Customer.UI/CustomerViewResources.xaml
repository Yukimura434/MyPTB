<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:PhotoBooth.Customer.UI.Converters">
  <!-- Loaded by every Customer view before its visual tree is created.
       This prevents constructor-time StaticResource failures while keeping
       Customer colors isolated from the Admin application's DarkTheme. -->
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Themes/PastelTheme.xaml"/>
  </ResourceDictionary.MergedDictionaries>
  <conv:ByteArrayImageConverter x:Key="CustomerByteImage"/>
  <conv:PathImageConverter x:Key="CustomerPathImage"/>
</ResourceDictionary>
