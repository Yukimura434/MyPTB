<Window x:Class="PhotoBooth.Customer.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PhotoBooth" Width="1366" Height="768" MinWidth="640" MinHeight="600"
        WindowStyle="None" ResizeMode="CanResize" Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen" KeyDown="Window_KeyDown" Closing="Window_Closing" PreviewMouseDown="Window_PreviewMouseDown" PreviewTouchDown="Window_PreviewTouchDown">
    <Window.Resources>
        <ResourceDictionary Source="CustomerResources.xaml"/>
    </Window.Resources>
    <Window.Style>
        <Style TargetType="Window">
            <Setter Property="WindowState" Value="Normal"/>
            <Style.Triggers><DataTrigger Binding="{Binding IsKiosk}" Value="True"><Setter Property="WindowState" Value="Maximized"/></DataTrigger></Style.Triggers>
        </Style>
    </Window.Style>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="ChromeRow" Height="46"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border x:Name="Chrome" Grid.Row="0" Background="#121217" BorderBrush="#292830" BorderThickness="0,0,0,1" MouseLeftButtonDown="Chrome_MouseLeftButtonDown">
            <Grid>
                <TextBlock Text="PhotoBooth" Margin="16,0" VerticalAlignment="Center"
                           FontSize="15" FontWeight="SemiBold" Foreground="#EEEAF0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="—" Click="Minimize_Click" Width="50" Height="46" MinWidth="0" MinHeight="0" Padding="0" Margin="0" Background="Transparent" Foreground="#B8B4BE" FontSize="17" ToolTip="Thu nhỏ"/>
                    <Button x:Name="RestoreButton" Content="□" Click="Restore_Click" Width="50" Height="46" MinWidth="0" MinHeight="0" Padding="0" Margin="0" Background="Transparent" Foreground="#B8B4BE" FontSize="17" ToolTip="Phóng to / Khôi phục"/>
                    <Button Content="×" Click="Close_Click" Width="50" Height="46" MinWidth="0" MinHeight="0" Padding="0" Margin="0" Background="Transparent" Foreground="#B8B4BE" FontSize="21" ToolTip="Đóng"/>
                </StackPanel>
            </Grid>
        </Border>

        <ContentControl Grid.Row="1" Content="{Binding CurrentPage,NotifyOnTargetUpdated=True}">
            <ContentControl.Triggers>
                <EventTrigger RoutedEvent="Binding.TargetUpdated">
                    <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25"/></Storyboard></BeginStoryboard>
                </EventTrigger>
            </ContentControl.Triggers>
        </ContentControl>

        <Button Grid.Row="1" Panel.ZIndex="10" Content="Quản trị" Click="Admin_Click"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,18,18,0"
                MinWidth="92" MinHeight="40" Height="40" Padding="16,8"
                FontSize="14" Foreground="White" Background="#B51B1A20" BorderBrush="#5A5662" BorderThickness="1" ToolTip="Quay về trang quản trị"/>
    </Grid>
</Window>
