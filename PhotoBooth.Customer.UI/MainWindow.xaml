<Window x:Class="PhotoBooth.Customer.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MiuPhotoBooth" Width="1366" Height="768" MinWidth="480" MinHeight="480"
        Icon="/PhotoBooth.Customer.UI;component/Assets/photobooth.ico"
        WindowStyle="None" ResizeMode="CanResize" Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True"
        KeyDown="Window_KeyDown" PreviewKeyDown="Window_PreviewKeyDown" PreviewMouseDown="Window_PreviewMouseDown" PreviewTouchDown="Window_PreviewTouchDown">
    <Window.Resources>
        <ResourceDictionary Source="CustomerResources.xaml"/>
    </Window.Resources>
    <Window.Style>
        <Style TargetType="Window">
            <Setter Property="WindowState" Value="Normal"/>
            <Style.Triggers><DataTrigger Binding="{Binding IsKiosk}" Value="True"><Setter Property="WindowState" Value="Maximized"/></DataTrigger></Style.Triggers>
        </Style>
    </Window.Style>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="ChromeRow">
                <RowDefinition.Style>
                    <Style TargetType="RowDefinition">
                        <Setter Property="Height" Value="46"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsKiosk}" Value="True">
                                <Setter Property="Height" Value="0"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </RowDefinition.Style>
            </RowDefinition>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border x:Name="Chrome" Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="Chrome_MouseLeftButtonDown">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsKiosk}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <StackPanel Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center">
                    <Image Source="/PhotoBooth.Customer.UI;component/Assets/fox-logo.png" Width="28" Height="28" Margin="0,0,9,0" SnapsToDevicePixels="True"/>
                    <TextBlock Text="MiuPhotoBooth" VerticalAlignment="Center"
                               FontSize="15" FontWeight="SemiBold" Foreground="#EEEAF0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="—" Click="Minimize_Click" Width="50" Height="46" MinWidth="0" MinHeight="0" Padding="0" Margin="0" Background="Transparent" Foreground="#B8B4BE" FontSize="17" ToolTip="Thu nhỏ"/>
                    <Button x:Name="RestoreButton" Content="□" Click="Restore_Click" Width="50" Height="46" MinWidth="0" MinHeight="0" Padding="0" Margin="0" Background="Transparent" Foreground="#B8B4BE" FontSize="17" ToolTip="Phóng to / Khôi phục"/>
                    <Button Content="×" Click="Close_Click" Width="50" Height="46" MinWidth="0" MinHeight="0" Padding="0" Margin="0" Background="Transparent" Foreground="#B8B4BE" FontSize="21" ToolTip="Đóng"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Never scale the whole customer page. Each view receives the real viewport
             and owns its responsive layout. This keeps Live View geometry and aspect
             ratio independent from theme and window scaling. -->
        <Grid Grid.Row="1" Background="{StaticResource PreviewBackdropBrush}" ClipToBounds="True">
            <ContentControl Content="{Binding CurrentPage,NotifyOnTargetUpdated=True}"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                <ContentControl.Triggers><EventTrigger RoutedEvent="Binding.TargetUpdated"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25"/></Storyboard></BeginStoryboard></EventTrigger></ContentControl.Triggers>
            </ContentControl>
        </Grid>


    </Grid>
</Window>
