<Window x:Class="PhotoBooth.Customer.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PhotoBooth" Width="1366" Height="768" MinWidth="1000" MinHeight="650"
        WindowStyle="None" ResizeMode="CanResize" Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen" KeyDown="Window_KeyDown" Closing="Window_Closing" PreviewMouseDown="Window_PreviewMouseDown" PreviewTouchDown="Window_PreviewTouchDown">
    <Window.Resources>
        <ResourceDictionary Source="CustomerResources.xaml"/>
    </Window.Resources>
    <Window.Style>
        <Style TargetType="Window">
            <Setter Property="WindowState" Value="Normal"/>
            <Style.Triggers><DataTrigger Binding="{Binding IsKiosk}" Value="True"><Setter Property="WindowState" Value="Maximized"/></DataTrigger></Style.Triggers>
        </Style>
    </Window.Style>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="ChromeRow" Height="42"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border x:Name="Chrome" Grid.Row="0" Background="#FFF8FB" MouseLeftButtonDown="Chrome_MouseLeftButtonDown">
            <Grid>
                <TextBlock Text="PhotoBooth" Margin="16,0" VerticalAlignment="Center"
                           FontSize="15" FontWeight="SemiBold" Foreground="#7B4A68"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="—" Click="Minimize_Click" Width="52" Height="42" Margin="0"
                            Background="Transparent" Foreground="#57394C" FontSize="17" ToolTip="Minimize"/>
                    <Button x:Name="RestoreButton" Content="□" Click="Restore_Click" Width="52" Height="42" Margin="0"
                            Background="Transparent" Foreground="#57394C" FontSize="18" ToolTip="Maximize / Restore"/>
                    <Button Content="×" Click="Close_Click" Width="52" Height="42" Margin="0"
                            Background="Transparent" Foreground="#57394C" FontSize="22" ToolTip="Close"/>
                </StackPanel>
            </Grid>
        </Border>

        <ContentControl Grid.Row="1" Content="{Binding CurrentPage,NotifyOnTargetUpdated=True}">
            <ContentControl.Triggers>
                <EventTrigger RoutedEvent="Binding.TargetUpdated">
                    <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25"/></Storyboard></BeginStoryboard>
                </EventTrigger>
            </ContentControl.Triggers>
        </ContentControl>

        <Button Grid.Row="1" Panel.ZIndex="10" Content="Quản trị" Click="Admin_Click"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,16,0"
                MinWidth="96" MinHeight="42" Height="42" Padding="18,8"
                FontSize="15" Foreground="White" Background="#57394C" ToolTip="Quay về trang quản trị"/>
    </Grid>
</Window>
