<Window x:Class="PhotoBooth.Admin.UI.DeviceEnrollmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PhotoBooth.Admin.UI.Views"
        Title="Thiết lập thiết bị PhotoBooth" Width="1160" Height="760"
        MinWidth="900" MinHeight="650" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="16,12" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock Text="Bạn có thể đóng cửa sổ và tiếp tục sau nếu chưa hoàn tất."
                           Foreground="{StaticResource MutedTextBrush}" FontSize="12" VerticalAlignment="Center"/>
                <Button Content="Đóng" IsCancel="True" HorizontalAlignment="Right" MinWidth="100"
                        Style="{StaticResource AdminSecondaryButton}"/>
            </Grid>
        </Border>
        <views:DeviceEnrollmentView/>
    </DockPanel>
</Window>
