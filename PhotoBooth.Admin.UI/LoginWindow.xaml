<Window x:Class="PhotoBooth.Admin.UI.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đăng nhập PhotoBooth"
        Width="1280" Height="820" MinWidth="620" MinHeight="600"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}"
        Icon="Assets/photobooth.ico" ShowInTaskbar="True">
    <Window.Resources>
  <Style TargetType="ScrollBar">
   <Setter Property="Width" Value="14"/><Setter Property="Background" Value="#151922"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
    <Border Background="{TemplateBinding Background}" Padding="2"><Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
     <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
     <Track.Thumb><Thumb MinHeight="24"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="Grip" Background="#8395AF" CornerRadius="5"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="#B6D0FF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
     <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
    </Track></Border>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
        <Style x:Key="LoginInput" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
                <Border x:Name="InputBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8">
                    <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="InputBorder" Property="BorderBrush" Value="#C7DAFF"/><Setter TargetName="InputBorder" Property="BorderThickness" Value="2"/></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="InputBorder" Property="BorderBrush" Value="#A9C7FF"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#BAC7DC"/><Setter TargetName="InputBorder" Property="Background" Value="#263040"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="LoginPassword" TargetType="PasswordBox" BasedOn="{StaticResource {x:Type PasswordBox}}">
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox">
                <Border x:Name="InputBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8"><ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="InputBorder" Property="BorderBrush" Value="#C7DAFF"/><Setter TargetName="InputBorder" Property="BorderThickness" Value="2"/></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="InputBorder" Property="BorderBrush" Value="#A9C7FF"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#BAC7DC"/><Setter TargetName="InputBorder" Property="Background" Value="#263040"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Grid Background="#0F131C">
      <ScrollViewer x:Name="LoginScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
       <Grid MinHeight="{Binding ViewportHeight,ElementName=LoginScrollViewer}">
        <Border x:Name="LoginCard" MaxWidth="1040" Margin="30" Background="#171E2B" BorderBrush="#8496B1" BorderThickness="1" CornerRadius="18" VerticalAlignment="Center">
         <Grid x:Name="LoginLayout">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.9*"/>
            <ColumnDefinition Width="1.15*"/>
        </Grid.ColumnDefinitions>

        <Border x:Name="StoryPanel" Grid.Column="0" CornerRadius="17,0,0,17" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#12233B" Offset="0"/>
                    <GradientStop Color="#0E1A2C" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="34,34,34,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal">
                    <!-- Keep the production brand artwork intact; it is shared across the product. -->
                    <Image Source="Assets/fox-logo.png" Width="58" Height="58" Stretch="Uniform" Margin="0,0,16,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="MIU PHOTOBOOTH" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="QUẢN LÝ BOOTH" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentHoverBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,24">
                    <TextBlock Text="Mỗi khoảnh khắc.&#10;Một dấu ấn riêng."
                               FontSize="31" FontWeight="SemiBold" LineHeight="42"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="Chuẩn bị máy ảnh, chọn khung và preset để bắt đầu buổi chụp của bạn."
                               Foreground="#C2CDE0" TextWrapping="Wrap" FontSize="15"
                               LineHeight="23" Margin="0,20,0,30"/>


                </StackPanel>

                <TextBlock Grid.Row="2" Text="Chủ tài khoản dùng mục Thiết lập để liên kết máy với cửa hàng." TextWrapping="Wrap"
                           Foreground="#C4D2E8" FontSize="11"/>
            </Grid>
        </Border>

        <Border x:Name="FormBorder" Grid.Column="1" Background="#171E2B" CornerRadius="0,17,17,0">
                <Grid x:Name="FormPanel" Margin="36,30">
                    <StackPanel MaxWidth="640" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                        <StackPanel x:Name="CompactBrand" Visibility="Collapsed" Orientation="Horizontal" Margin="0,0,0,24"><Image Source="Assets/fox-logo.png" Width="44" Height="44" Margin="0,0,12,0"/><TextBlock Text="MIU PHOTOBOOTH" FontWeight="Bold" FontSize="18" VerticalAlignment="Center"/></StackPanel>
                        <TextBlock x:Name="HeadingText" Text="Chào mừng trở lại"
                                   FontSize="29" FontWeight="SemiBold" TextAlignment="Left"/>
                        <TextBlock x:Name="SubtitleText"
                                     Text="Đăng nhập bằng tài khoản nhân viên hoặc mã sự kiện."
                                   Margin="0,7,0,22" FontSize="14" Foreground="#B9C5D8"
                                   TextAlignment="Left" TextWrapping="Wrap"/>

                        <Border x:Name="DeviceSetupPanel" Background="#182236" BorderBrush="#263958"
                                BorderThickness="1" CornerRadius="11" Padding="18" Margin="0,0,0,24">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="DeviceStatusIconBorder" Width="32" Height="32" CornerRadius="16"
                                        Background="{StaticResource SuccessSubtleBrush}" Margin="0,0,16,0">
                                    <Path x:Name="DeviceStatusIcon" Data="{StaticResource Icon.Check}"
                                          Style="{StaticResource VectorIcon}" Width="18" Height="18"
                                          Stroke="{StaticResource SuccessBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="DeviceStatusTitle" Text="Đang kiểm tra thiết bị…"
                                               FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="DeviceStatusDetail" Text="Vui lòng chờ" FontSize="13"
                                               Foreground="#B9C5D8" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button x:Name="EnrollmentButton" Grid.Column="2" Content="Thiết lập"
                                        MinWidth="76" Height="38" Margin="10,0,0,0" Padding="10,6"
                                        Style="{StaticResource AdminSecondaryButton}" Click="OpenEnrollment_Click"/>
                            </Grid>
                        </Border>

                        <TextBlock Text="Tên nhân viên hoặc mã sự kiện" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#C9D4E6" Margin="0,0,0,7"/>
                        <Grid>
                            <TextBox Style="{StaticResource LoginInput}" BorderBrush="#78879F" Foreground="#F1F5FC" Background="#101620" x:Name="EmailBox" Height="52" Margin="0" Padding="14,0"
                                     FontSize="15" MaxLength="64"
                                      AutomationProperties.Name="Tên nhân viên hoặc mã sự kiện"/>
                            <TextBlock Text="Nhập tên đăng nhập…" Margin="15,0,0,0" VerticalAlignment="Center" FontSize="15"
                                       Foreground="#9EACC1" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=EmailBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <TextBlock Text="Mật khẩu" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#C9D4E6" Margin="0,16,0,7"/>
                        <Grid>
                            <PasswordBox Style="{StaticResource LoginPassword}" BorderBrush="#78879F" Foreground="#F1F5FC" Background="#101620" x:Name="PasswordBox" Height="52" Margin="0" Padding="14,0"
                                         FontSize="15" MaxLength="64"
                                         PasswordChanged="PasswordBox_PasswordChanged"
                                         AutomationProperties.Name="Mật khẩu nhân viên"/>
                            <TextBox Style="{StaticResource LoginInput}" BorderBrush="#78879F" Foreground="#F1F5FC" Background="#101620" x:Name="VisiblePasswordBox" Height="52" Margin="0" Padding="14,0"
                                     FontSize="15" Visibility="Collapsed"
                                     TextChanged="VisiblePasswordBox_TextChanged" MaxLength="64"
                                     AutomationProperties.Name="Mật khẩu nhân viên đang hiển thị"/>
                            <TextBlock x:Name="PasswordPlaceholder" Text="Nhập mật khẩu…"
                                       Margin="15,0,0,0" VerticalAlignment="Center" FontSize="15" Foreground="#9EACC1"
                                       IsHitTestVisible="False"/>
                        </Grid>

                        <Grid Margin="0,15,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="ShowPasswordBox" Grid.Column="1" Content="Hiện mật khẩu"
                                      Checked="ShowPasswordBox_Checked" Unchecked="ShowPasswordBox_Unchecked"/>
                        </Grid>

                        <Border x:Name="ErrorBorder" Margin="0,18,0,0" Padding="14"
                                Background="{StaticResource DangerSubtleBrush}" BorderBrush="#8A4651"
                                BorderThickness="1" CornerRadius="8" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Path Data="{StaticResource Icon.Error}" Style="{StaticResource VectorIcon}"
                                      Width="18" Height="18" Stroke="#FFD5D9" Margin="0,1,11,0"
                                      VerticalAlignment="Top"/>
                                <TextBlock x:Name="ErrorText" Grid.Column="1" Foreground="#FFD5D9"
                                           TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/>
                            </Grid>
                        </Border>

                        <Button x:Name="LoginButton" Content="Đăng nhập" Height="52" Margin="0,24,0,0"
                                FontSize="16" BorderBrush="#A7C5FF" IsDefault="True" Click="LoginButton_Click"/>
                        <Button x:Name="CancelButton" Content="Thoát ứng dụng" Height="52" Margin="0,12,0,0"
                                FontSize="16" IsCancel="True" Style="{StaticResource AdminSecondaryButton}" Background="Transparent" BorderThickness="0"/>

                        <TextBlock Text="Tài khoản chủ chỉ dùng trong phần Thiết lập."
                                   FontSize="12" Foreground="#BAC7DC" TextWrapping="Wrap"
                                   Margin="0,18,0,0"/>
                    </StackPanel>
                </Grid>
        </Border>
         </Grid>
        </Border>
       </Grid>
      </ScrollViewer>

        <Border x:Name="BusyOverlay" Grid.ColumnSpan="2" Background="#CC0F1117" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Width="210" Height="5" IsIndeterminate="True"/>
                <TextBlock Text="Đang xác thực…" FontWeight="SemiBold" Margin="0,14,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
