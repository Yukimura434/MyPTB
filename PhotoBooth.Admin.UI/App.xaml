<Application x:Class="PhotoBooth.Admin.UI.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:PhotoBooth.Admin.UI.ViewModels" xmlns:views="clr-namespace:PhotoBooth.Admin.UI.Views" xmlns:conv="clr-namespace:PhotoBooth.Admin.UI.Converters">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/PhotoBooth.Customer.UI;component/CustomerResources.xaml"/><ResourceDictionary Source="Themes/DarkTheme.xaml"/></ResourceDictionary.MergedDictionaries>
      <DataTemplate DataType="{x:Type vm:HomeViewModel}"><views:HomeView/></DataTemplate>
      <DataTemplate DataType="{x:Type vm:FrameManagerViewModel}"><views:FrameManagerView/></DataTemplate>
      <DataTemplate DataType="{x:Type vm:PresetManagerViewModel}"><views:PresetManagerView/></DataTemplate>
      <DataTemplate DataType="{x:Type vm:PrinterManagerViewModel}"><views:PrinterManagerView/></DataTemplate>
      <DataTemplate DataType="{x:Type vm:DiagnosticsViewModel}"><views:DiagnosticsView/></DataTemplate>
      <DataTemplate DataType="{x:Type vm:LocalShareViewModel}"><views:LocalShareView/></DataTemplate>
      <DataTemplate DataType="{x:Type vm:InterfaceViewModel}"><views:InterfaceView/></DataTemplate>
      <DataTemplate DataType="{x:Type vm:AboutViewModel}"><views:AboutView/></DataTemplate>
      <conv:ByteArrayImageConverter x:Key="ByteImage"/>
    </ResourceDictionary>
  </Application.Resources>
</Application>
