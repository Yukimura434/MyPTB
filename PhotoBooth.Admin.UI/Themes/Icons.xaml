    <!-- Product-owned 24 x 24 outline icons; no OS icon font dependency. -->
    <Style x:Key="VectorIcon" TargetType="{x:Type Path}">
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Fill" Value="Transparent"/>
        <Setter Property="Stroke" Value="{DynamicResource TextBrush}"/>
        <Setter Property="StrokeThickness" Value="1.8"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="ButtonVectorIcon" TargetType="{x:Type Path}" BasedOn="{StaticResource VectorIcon}">
        <Setter Property="Stroke" Value="{Binding Foreground,RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>

