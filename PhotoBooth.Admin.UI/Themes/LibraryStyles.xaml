<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <!-- Shared detail sizing leaves room for the frame grid at desktop widths. -->
 <Style x:Key="LibraryDetailColumn" TargetType="ColumnDefinition">
  <Setter Property="Width" Value="0.45*"/>
  <Setter Property="MinWidth" Value="360"/>
  <Setter Property="MaxWidth" Value="500"/>
 </Style>
 <Style x:Key="LibrarySecondary" TargetType="Button" BasedOn="{StaticResource AdminSecondaryButton}"><Setter Property="Margin" Value="0"/><Setter Property="MinHeight" Value="38"/><Setter Property="Padding" Value="12,8"/></Style>
 <Style x:Key="LibraryDanger" TargetType="Button" BasedOn="{StaticResource AdminDangerButton}"><Setter Property="Margin" Value="0"/><Setter Property="BorderBrush" Value="#BD8390"/><Setter Property="MinHeight" Value="38"/></Style>
 <Style x:Key="LibraryPin" TargetType="Button" BasedOn="{StaticResource LibrarySecondary}">
  <Setter Property="Width" Value="36"/><Setter Property="Height" Value="36"/><Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="8"/><Setter Property="ToolTip" Value="Ghim"/><Setter Property="AutomationProperties.Name" Value="Ghim"/><Setter Property="Background" Value="#162132"/><Setter Property="Foreground" Value="#DCE8FB"/>
  <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><Path Data="M 7,2 L 17,2 M 9,2 L 9,9 L 5,14 L 19,14 L 15,9 L 15,2 M 12,14 L 12,22" Stretch="Uniform" Width="16" Height="20" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeLineJoin="Round"/></DataTemplate></Setter.Value></Setter>
  <Style.Triggers><DataTrigger Binding="{Binding Tag,RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="Background" Value="#315DAE"/><Setter Property="BorderBrush" Value="#B5CEFF"/><Setter Property="Foreground" Value="White"/><Setter Property="ToolTip" Value="Bỏ ghim"/><Setter Property="AutomationProperties.Name" Value="Bỏ ghim"/></DataTrigger></Style.Triggers>
 </Style>
 <Style x:Key="LibraryItem" TargetType="ListBoxItem">
  <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Foreground" Value="#F2F4F8"/><Setter Property="Margin" Value="0,0,12,12"/><Setter Property="Padding" Value="12"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Card" Background="#1B2432" BorderBrush="#8196B2" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers>
   <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="#29364B"/></Trigger>
   <Trigger Property="IsSelected" Value="True"><Setter TargetName="Card" Property="Background" Value="#223454"/><Setter TargetName="Card" Property="BorderBrush" Value="#AACBFF"/><Setter TargetName="Card" Property="BorderThickness" Value="2"/><Setter TargetName="Card" Property="Padding" Value="11"/></Trigger>
   <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="White"/></Trigger>
  </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 <DataTemplate x:Key="CollectionName"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/></DataTemplate>
 <Style TargetType="ScrollBar">
  <Setter Property="Width" Value="10"/><Setter Property="Background" Value="#162132"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Border Background="{TemplateBinding Background}" CornerRadius="5"><Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton><Track.Thumb><Thumb MinHeight="24"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="ThumbBorder" Background="#8196B2" CornerRadius="5" Margin="2,0"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbBorder" Property="Background" Value="#B5CEFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton></Track></Border></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="LibraryMenu" TargetType="ContextMenu">
  <Setter Property="Background" Value="#1B2432"/><Setter Property="BorderBrush" Value="#8196B2"/><Setter Property="BorderThickness" Value="1"/><Setter Property="MinWidth" Value="230"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="4"><ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter/></ScrollViewer></Border></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="LibraryMenuItem" TargetType="MenuItem">
  <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  <Setter Property="Foreground" Value="#F2F4F8"/><Setter Property="Background" Value="#1B2432"/><Setter Property="Padding" Value="14,12"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem"><Border x:Name="Item" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" BorderBrush="Transparent" BorderThickness="1"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="#315DAE"/><Setter TargetName="Item" Property="BorderBrush" Value="#B5CEFF"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#B9C4D5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
</ResourceDictionary>
