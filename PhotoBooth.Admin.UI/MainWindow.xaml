<Window x:Class="PhotoBooth.Admin.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PhotoBooth Admin"
        Width="1440"
        Height="900"
        MinWidth="1100"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Width="{Binding MenuWidth}"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="#353535"
                BorderThickness="0,0,1,0">

            <DockPanel>

                <!-- Toggle menu -->
                <Button DockPanel.Dock="Top"
                        Style="{StaticResource MenuButton}"
                        Command="{Binding ToggleMenuCommand}"
                        Content="☰"
                        FontSize="22" />
                
                <!-- Navigation -->
                <StackPanel Margin="8,24">

                    <Button Style="{StaticResource MenuButton}"
                            Command="{Binding StartCustomerCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▶"
                                       Style="{StaticResource IconText}" />

                            <TextBlock Text="Customer mode"
                                       Visibility="{Binding MenuTextVisibility}" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource MenuButton}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="home">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text=""
                                       Style="{StaticResource IconText}" />

                            <TextBlock Text="Home"
                                       Visibility="{Binding MenuTextVisibility}" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource MenuButton}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="frames">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text=""
                                       Style="{StaticResource IconText}" />

                            <TextBlock Text="Frames"
                                       Visibility="{Binding MenuTextVisibility}" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource MenuButton}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="presets">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text=""
                                       Style="{StaticResource IconText}" />

                            <TextBlock Text="Presets"
                                       Visibility="{Binding MenuTextVisibility}" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource MenuButton}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="printers">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text=""
                                       Style="{StaticResource IconText}" />

                            <TextBlock Text="Printers"
                                       Visibility="{Binding MenuTextVisibility}" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource MenuButton}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="data">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D2;"
                                       Style="{StaticResource IconText}" />

                            <TextBlock Text="Dữ liệu &amp; thống kê"
                                       Visibility="{Binding MenuTextVisibility}" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource MenuButton}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="share">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔗"
                                       Style="{StaticResource IconText}" />

                            <TextBlock Text="Local Share"
                                       Visibility="{Binding MenuTextVisibility}" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource MenuButton}" Command="{Binding NavigateCommand}" CommandParameter="beauty">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="✦" Style="{StaticResource IconText}"/><TextBlock Text="Beauty" Visibility="{Binding MenuTextVisibility}"/></StackPanel>
                    </Button>

                    <Button Style="{StaticResource MenuButton}" Command="{Binding NavigateCommand}" CommandParameter="interface">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE771;" Style="{StaticResource IconText}"/><TextBlock Text="Interface" Visibility="{Binding MenuTextVisibility}"/></StackPanel>
                    </Button>

                    <Button Style="{StaticResource MenuButton}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="events">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE787;" Style="{StaticResource IconText}" />
                            <TextBlock Text="Events" Visibility="{Binding MenuTextVisibility}" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource MenuButton}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="about">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&lt;!&gt;"
                                       Style="{StaticResource IconText}"
                                       FontFamily="Consolas"
                                       FontWeight="Bold" />
                            <TextBlock Text="About"
                                       Visibility="{Binding MenuTextVisibility}" />
                        </StackPanel>
                    </Button>

                </StackPanel>

            </DockPanel>
        </Border>

        <!-- Main content -->
        <Grid Grid.Column="1">

            <ContentControl Content="{Binding CurrentPage, NotifyOnTargetUpdated=True}"
                            Opacity="1">

                <ContentControl.RenderTransform>
                    <TranslateTransform />
                </ContentControl.RenderTransform>

                <ContentControl.Triggers>
                    <EventTrigger RoutedEvent="Binding.TargetUpdated">
                        <BeginStoryboard>
                            <Storyboard>

                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="0"
                                                 To="1"
                                                 Duration="0:0:0.18" />

                                <DoubleAnimation
                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                    From="12"
                                    To="0"
                                    Duration="0:0:0.18" />

                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </ContentControl.Triggers>

            </ContentControl>

            <!-- Status message -->
            <Border VerticalAlignment="Bottom"
                    Background="#CC252526"
                    Padding="14,8"
                    Visibility="{Binding HasMessage, Converter={StaticResource BoolVisibility}}">

                <TextBlock Text="{Binding Message}"
                           Foreground="White"
                           HorizontalAlignment="Center" />

            </Border>

        </Grid>

    </Grid>

</Window>
