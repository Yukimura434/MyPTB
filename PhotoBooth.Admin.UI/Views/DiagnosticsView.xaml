<UserControl x:Class="PhotoBooth.Admin.UI.Views.DiagnosticsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><ScrollViewer><StackPanel Margin="28,24,28,32"><TextBlock Text="Dữ liệu &amp; thống kê" Style="{StaticResource PageTitle}" Margin="8,0,8,14"/><TextBlock Text="Thống kê vận hành và doanh thu. Quản lý lượt chụp và trạng thái tải ảnh nằm trong mục Chia sẻ ảnh." Style="{StaticResource PageSubtitle}" Margin="8,0,8,16"/><UniformGrid Columns="3"><Border Style="{StaticResource Card}" MinHeight="128"><StackPanel VerticalAlignment="Center"><TextBlock Text="SỐ ẢNH ĐÃ IN" Foreground="#A8A8AE"/><TextBlock Text="{Binding PrintedPhotoCountText}" FontSize="34" Foreground="#8FB4FF" Margin="0,8,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}" MinHeight="128"><StackPanel VerticalAlignment="Center"><TextBlock Text="SỐ ẢNH IN THÊM" Foreground="#A8A8AE"/><TextBlock Text="{Binding ExtraPrintCountText}" FontSize="34" Foreground="#8FB4FF" Margin="0,8,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}" MinHeight="128"><StackPanel VerticalAlignment="Center"><TextBlock Text="DOANH THU" Foreground="#A8A8AE"/><TextBlock Text="{Binding RevenueText}" FontSize="34" Foreground="#8FB4FF" Margin="0,8,0,0"/><TextBlock Text="{Binding RevenueHint}" Foreground="#E3A95B"/></StackPanel></Border></UniformGrid></StackPanel></ScrollViewer></UserControl>
