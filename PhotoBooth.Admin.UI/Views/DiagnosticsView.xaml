<UserControl x:Class="PhotoBooth.Admin.UI.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Language="vi-VN">
    <Grid Background="{StaticResource BackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,24,28,32">
                <DockPanel Margin="8,0,8,14">
                    <TextBlock Text="Dữ liệu &amp; thống kê" Style="{StaticResource PageTitle}" Margin="0"/>
                    <Border DockPanel.Dock="Right" Background="#24364F" CornerRadius="14" Padding="12,7" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="#62D89B" Margin="0,0,7,0"/>
                            <TextBlock Text="Dữ liệu cục bộ" FontSize="12" Foreground="#B8D3FF"/>
                        </StackPanel>
                    </Border>
                </DockPanel>

                <UniformGrid Columns="4">
                    <Border Style="{StaticResource Card}" MinHeight="128">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="SỐ LƯỢT CHỤP" Foreground="#A8A8AE" FontSize="12"/>
                            <TextBlock Text="{Binding CaptureCountText}" FontSize="34" Foreground="#8FB4FF" Margin="0,8,0,0"/>
                            <TextBlock Text="Theo bộ lọc hiện tại" Foreground="#74747C" FontSize="11" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" MinHeight="128">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="SỐ ẢNH ĐÃ IN" Foreground="#A8A8AE" FontSize="12"/>
                            <TextBlock Text="{Binding PrintedPhotoCountText}" FontSize="34" Foreground="#8FB4FF" Margin="0,8,0,0"/>
                            <TextBlock Text="Tổng số bản in thành công" Foreground="#74747C" FontSize="11" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" MinHeight="128">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="SỐ ẢNH IN THÊM" Foreground="#A8A8AE" FontSize="12"/>
                            <TextBlock Text="{Binding ExtraPrintCountText}" FontSize="34" Foreground="#8FB4FF" Margin="0,8,0,0"/>
                            <TextBlock Text="Số bản vượt quá bản đầu" Foreground="#74747C" FontSize="11" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" MinHeight="128">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="DOANH THU" Foreground="#A8A8AE" FontSize="12"/>
                            <TextBlock Text="{Binding RevenueText}" FontSize="34" Foreground="#8FB4FF" Margin="0,8,0,0"/>
                            <TextBlock Text="{Binding RevenueHint}" Foreground="#E3A95B" FontSize="11" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Style="{StaticResource Card}" Margin="8,10,8,14" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="240"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="130"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="TÌM KIẾM" Foreground="#A8A8AE" VerticalAlignment="Center" Margin="10,0"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding FilterOptions}" SelectedItem="{Binding SelectedFilter}" Height="42"/>
                        <Grid Grid.Column="2" Margin="4,0">
                            <TextBlock Text="Tất cả ngày, sự kiện và session" Foreground="#777780" Margin="12,0" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding SelectedFilter.Mode}" Value="All"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <DatePicker x:Name="SearchDatePicker" SelectedDate="{Binding SelectedDate,Mode=TwoWay}" SelectedDateFormat="Short" Height="42" Margin="4" Language="vi-VN" VerticalContentAlignment="Center" Background="#18181B" Foreground="#F5F5F7" BorderBrush="#66666E" Visibility="{Binding IsDateFilter,Converter={StaticResource BoolVisibility}}">
                                <DatePicker.Resources>
                                    <Style TargetType="DatePickerTextBox">
                                        <Setter Property="Background" Value="#18181B"/>
                                        <Setter Property="Foreground" Value="#F5F5F7"/>
                                        <Setter Property="CaretBrush" Value="#F5F5F7"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    </Style>
                                    <Style TargetType="Calendar">
                                        <Setter Property="Background" Value="#252526"/>
                                        <Setter Property="Foreground" Value="#F5F5F7"/>
                                        <Setter Property="BorderBrush" Value="#55555D"/>
                                    </Style>
                                    <Style TargetType="CalendarItem">
                                        <Setter Property="Background" Value="#252526"/>
                                        <Setter Property="Foreground" Value="#F5F5F7"/>
                                        <Setter Property="BorderBrush" Value="#55555D"/>
                                    </Style>
                                    <Style TargetType="CalendarButton">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="#F5F5F7"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#3A4B68"/></Trigger>
                                            <Trigger Property="IsInactive" Value="True"><Setter Property="Foreground" Value="#777780"/></Trigger>
                                        </Style.Triggers>
                                    </Style>
                                    <Style TargetType="CalendarDayButton">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="#F5F5F7"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsInactive" Value="True"><Setter Property="Foreground" Value="#686870"/></Trigger>
                                            <Trigger Property="IsToday" Value="True"><Setter Property="BorderBrush" Value="#69A0FF"/><Setter Property="BorderThickness" Value="1"/></Trigger>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#3A4B68"/></Trigger>
                                            <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#4F8CFF"/><Setter Property="Foreground" Value="White"/></Trigger>
                                            <Trigger Property="IsBlackedOut" Value="True"><Setter Property="Foreground" Value="#55555D"/></Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DatePicker.Resources>
                            </DatePicker>
                            <ComboBox ItemsSource="{Binding EventSuggestions}" Text="{Binding FilterText,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsEditable="True" StaysOpenOnEdit="True" Height="42" Visibility="{Binding IsEventFilter,Converter={StaticResource BoolVisibility}}"/>
                            <TextBox Text="{Binding FilterText,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Height="42" VerticalContentAlignment="Center" Visibility="{Binding IsSessionFilter,Converter={StaticResource BoolVisibility}}"/>
                        </Grid>
                        <Button Grid.Column="3" Content="Tìm kiếm" Command="{Binding SearchCommand}" Height="42" Background="#4F8CFF"/>
                    </Grid>
                </Border>

                <DockPanel Margin="12,0,12,10">
                    <TextBlock Text="LƯỢT CHỤP" FontSize="13" Foreground="#A8A8AE"/>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding ResultText}" Foreground="#777780" HorizontalAlignment="Right"/>
                </DockPanel>

                <Border Background="#252526" CornerRadius="10" Padding="36" Margin="8" Visibility="{Binding IsLoading,Converter={StaticResource BoolVisibility}}">
                    <StackPanel HorizontalAlignment="Center"><TextBlock Text="Đang tải dữ liệu và thumbnail…" Foreground="#A8A8AE"/></StackPanel>
                </Border>

                <ListBox ItemsSource="{Binding Captures}" HorizontalContentAlignment="Stretch">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Focusable" Value="False"/>
                            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.OpenCaptureCommand,RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Background="Transparent" Padding="0" Margin="0,0,0,4" HorizontalContentAlignment="Stretch">
                                <Border Background="#2D2D30" CornerRadius="11" Padding="12" BorderBrush="#3B3B40" BorderThickness="1" Margin="8,3">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="176"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Border Width="160" Height="112" CornerRadius="8" Background="#202024" ClipToBounds="True">
                                            <Grid>
                                                <TextBlock Text="ẢNH" Foreground="#5B5B64" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Image Source="{Binding ThumbnailBytes,Converter={StaticResource ByteImage}}" Stretch="UniformToFill"/>
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,20,0">
                                            <TextBlock Text="{Binding Title}" FontSize="20" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding EventText}" Foreground="#8FB4FF" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding SessionText}" Foreground="#A8A8AE" FontFamily="Segoe UI" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding CaptureIdText}" Foreground="#777780" FontFamily="Segoe UI" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Width="170" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding MediaText}" Foreground="#D5D5DA" HorizontalAlignment="Right"/>
                                            <TextBlock Text="Xem media  ›" Foreground="#8FB4FF" HorizontalAlignment="Right" Margin="0,9,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Background="#3A2020" CornerRadius="7" Padding="12" Margin="8" Visibility="{Binding HasError,Converter={StaticResource BoolVisibility}}">
                    <TextBlock Text="{Binding Error}" Foreground="#FF9B9B" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Background="#F51A1A1D" Visibility="{Binding IsCaptureOpen,Converter={StaticResource BoolVisibility}}">
            <Grid Margin="38,28">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <DockPanel Margin="8,0,8,16">
                    <Button DockPanel.Dock="Right" Content="Đóng  ✕" Command="{Binding CloseCaptureCommand}" Background="#3A3A40" MinWidth="110"/>
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedCaptureTitle}" FontSize="25" FontWeight="Bold"/>
                        <TextBlock Text="Chọn một thumbnail để mở bằng trình xem ảnh/video mặc định của Windows" Foreground="#A8A8AE" Margin="0,5,0,0"/>
                    </StackPanel>
                </DockPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding SelectedMedia}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.OpenMediaCommand,RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Background="Transparent" Padding="0" Margin="7">
                                    <Border Width="310" Background="#2D2D30" CornerRadius="11" BorderBrush="#44444A" BorderThickness="1" Padding="9">
                                        <StackPanel>
                                            <Border Height="220" Background="#202024" CornerRadius="8" ClipToBounds="True">
                                                <Grid>
                                                    <TextBlock Text="Không có thumbnail" Foreground="#61616A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <Image Source="{Binding ThumbnailBytes,Converter={StaticResource ByteImage}}" Stretch="UniformToFill"/>
                                                    <Border Background="#B8000000" CornerRadius="22" Width="44" Height="44" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsVideo,Converter={StaticResource BoolVisibility}}">
                                                        <TextBlock Text="{Binding TypeIcon}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3,0,0,0"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <TextBlock Text="{Binding Label}" FontSize="16" HorizontalAlignment="Center" Margin="4,10,4,4"/>
                                        </StackPanel>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
