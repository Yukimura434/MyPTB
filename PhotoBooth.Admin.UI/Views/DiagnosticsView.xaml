<UserControl x:Class="PhotoBooth.Admin.UI.Views.DiagnosticsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="32">
  <DockPanel><StackPanel><TextBlock Text="Dữ liệu &amp; thống kê" Style="{StaticResource PageTitle}" Margin="12,8,12,2"/><TextBlock Text="Tổng quan dữ liệu PhotoBooth trong SQLite" Foreground="#A8A8AE" Margin="12,0,0,12"/></StackPanel><StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right"><Button Content="Làm mới dữ liệu" Command="{Binding RefreshCommand}" Width="150"/><TextBlock Text="{Binding UpdatedText}" Foreground="#85858C" HorizontalAlignment="Right" Margin="0,4,4,0"/></StackPanel></DockPanel>
  <UniformGrid Columns="4">
   <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="LƯỢT PHOTOBOOTH" Foreground="#999"/><TextBlock Text="{Binding Snapshot.CaptureCount,StringFormat={}{0:N0}}" FontSize="34" Foreground="{StaticResource AccentBrush}"/><TextBlock Text="{Binding Snapshot.TodayCaptureCount,StringFormat=Hôm nay +{0:N0}}" Foreground="#8FB4FF"/></StackPanel></Border>
   <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="ẢNH GỐC" Foreground="#999"/><TextBlock Text="{Binding TotalOriginalCount,StringFormat={}{0:N0}}" FontSize="34" Foreground="{StaticResource AccentBrush}"/><TextBlock Text="{Binding Snapshot.TodayPictureCount,StringFormat=Hôm nay +{0:N0}}" Foreground="#8FB4FF"/></StackPanel></Border>
   <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="LƯỢT IN THÀNH CÔNG" Foreground="#999"/><TextBlock Text="{Binding Snapshot.SuccessfulPrintCount,StringFormat={}{0:N0}}" FontSize="34" Foreground="{StaticResource AccentBrush}"/><TextBlock Text="{Binding Snapshot.TodayPrintCount,StringFormat=Hôm nay +{0:N0}}" Foreground="#8FB4FF"/></StackPanel></Border>
   <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="TỔNG DỮ LIỆU MEDIA" Foreground="#999"/><TextBlock Text="{Binding TotalAssetSize}" FontSize="34" Foreground="{StaticResource AccentBrush}"/><TextBlock Text="{Binding TotalAssetCount,StringFormat={}{0:N0} asset}" Foreground="#8FB4FF"/></StackPanel></Border>
  </UniformGrid>
  <Border Style="{StaticResource Card}" Margin="8,12,8,0"><StackPanel><TextBlock Text="RAM tiến trình PhotoBooth" Style="{StaticResource SectionTitle}"/><UniformGrid Columns="4"><StackPanel Margin="0,5"><TextBlock Text="ĐANG DÙNG (WORKING SET)" Foreground="#AAA"/><TextBlock Text="{Binding CurrentRam}" FontSize="24" Foreground="#8FB4FF"/></StackPanel><StackPanel Margin="0,5"><TextBlock Text="ĐỈNH TỪ KHI MỞ APP" Foreground="#AAA"/><TextBlock Text="{Binding PeakRam}" FontSize="24" Foreground="#EF5DA8"/></StackPanel><StackPanel Margin="0,5"><TextBlock Text="PRIVATE MEMORY" Foreground="#AAA"/><TextBlock Text="{Binding PrivateRam}" FontSize="24"/></StackPanel><StackPanel Margin="0,5"><TextBlock Text="MANAGED .NET" Foreground="#AAA"/><TextBlock Text="{Binding ManagedRam}" FontSize="24"/></StackPanel></UniformGrid><TextBlock Text="{Binding ProcessArchitecture}" Foreground="#FFB45C" Margin="0,8,0,0"/></StackPanel></Border>
  <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Kho dữ liệu" Style="{StaticResource SectionTitle}"/><UniformGrid Columns="2"><StackPanel Margin="0,5"><TextBlock Text="Video" Foreground="#AAA"/><TextBlock Text="{Binding Snapshot.VideoCount,StringFormat={}{0:N0}}" FontSize="24"/></StackPanel><StackPanel Margin="0,5"><TextBlock Text="Ảnh tĩnh cũ" Foreground="#AAA"/><TextBlock Text="{Binding Snapshot.PictureCount,StringFormat={}{0:N0}}" FontSize="24"/></StackPanel><StackPanel Margin="0,5"><TextBlock Text="Ảnh composite" Foreground="#AAA"/><TextBlock Text="{Binding Snapshot.CompositeCount,StringFormat={}{0:N0}}" FontSize="24"/></StackPanel><StackPanel Margin="0,5"><TextBlock Text="GIF" Foreground="#AAA"/><TextBlock Text="{Binding Snapshot.GifCount,StringFormat={}{0:N0}}" FontSize="24"/></StackPanel><StackPanel Margin="0,5"><TextBlock Text="ZIP chia sẻ" Foreground="#AAA"/><TextBlock Text="{Binding Snapshot.ShareArchiveCount,StringFormat={}{0:N0}}" FontSize="24"/></StackPanel><StackPanel Margin="0,5"><TextBlock Text="Session cấu hình" Foreground="#AAA"/><TextBlock Text="{Binding Snapshot.SessionCount,StringFormat={}{0:N0}}" FontSize="24"/></StackPanel></UniformGrid></StackPanel></Border>
   <Border Grid.Column="1" Style="{StaticResource Card}"><StackPanel><TextBlock Text="Tính toàn vẹn &amp; xử lý" Style="{StaticResource SectionTitle}"/><UniformGrid Columns="2"><StackPanel Margin="0,5"><TextBlock Text="Asset sẵn sàng" Foreground="#AAA"/><TextBlock Text="{Binding Snapshot.ReadyAssetCount,StringFormat={}{0:N0}}" FontSize="24" Foreground="#55C88A"/></StackPanel><StackPanel Margin="0,5"><TextBlock Text="Asset thất lạc" Foreground="#AAA"/><TextBlock Text="{Binding Snapshot.MissingAssetCount,StringFormat={}{0:N0}}" FontSize="24" Foreground="#FF6B6B"/></StackPanel><StackPanel Margin="0,5"><TextBlock Text="Upload đang chờ" Foreground="#AAA"/><TextBlock Text="{Binding Snapshot.PendingUploadCount,StringFormat={}{0:N0}}" FontSize="24"/></StackPanel><StackPanel Margin="0,5"><TextBlock Text="Upload hoàn tất" Foreground="#AAA"/><TextBlock Text="{Binding Snapshot.UploadedCount,StringFormat={}{0:N0}}" FontSize="24"/></StackPanel><StackPanel Margin="0,5"><TextBlock Text="Upload lỗi vĩnh viễn" Foreground="#AAA"/><TextBlock Text="{Binding Snapshot.FailedUploadCount,StringFormat={}{0:N0}}" FontSize="24" Foreground="#FFB45C"/></StackPanel><StackPanel Margin="0,5"><TextBlock Text="Lượt in lỗi" Foreground="#AAA"/><TextBlock Text="{Binding Snapshot.FailedPrintCount,StringFormat={}{0:N0}}" FontSize="24" Foreground="#FFB45C"/></StackPanel></UniformGrid></StackPanel></Border>
  </Grid>
  <Border Style="{StaticResource Card}" Margin="8,20,8,8"><StackPanel><TextBlock Text="50 lượt PhotoBooth gần nhất" Style="{StaticResource SectionTitle}"/><DataGrid ItemsSource="{Binding Snapshot.RecentCaptures}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="Transparent" Foreground="White" BorderThickness="0" RowBackground="#2D2D30" AlternatingRowBackground="#28282B" HorizontalGridLinesBrush="#414146" ColumnHeaderHeight="38" RowHeight="38"><DataGrid.Resources><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#242428"/><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="10,6"/><Setter Property="BorderBrush" Value="#414146"/></Style><Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10,4"/><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="Transparent"/></Style></DataGrid.Resources><DataGrid.Columns><DataGridTextColumn Header="Thời gian" Binding="{Binding CreatedAtUtc,StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="145"/><DataGridTextColumn Header="Session" Binding="{Binding SessionName}" Width="*"/><DataGridTextColumn Header="Capture ID" Binding="{Binding CaptureId}" Width="220"/><DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="100"/><DataGridTextColumn Header="Asset" Binding="{Binding AssetCount}" Width="70"/><DataGridTextColumn Header="Video" Binding="{Binding VideoCount}" Width="70"/><DataGridTextColumn Header="GIF" Binding="{Binding GifCount}" Width="55"/><DataGridTextColumn Header="In" Binding="{Binding PrintCount}" Width="55"/><DataGridTextColumn Header="Thiếu" Binding="{Binding MissingAssetCount}" Width="60"/><DataGridCheckBoxColumn Header="ZIP" Binding="{Binding HasShareArchive}" Width="55"/></DataGrid.Columns></DataGrid></StackPanel></Border>
  <Border Background="#3A2020" CornerRadius="6" Padding="12" Margin="8" Visibility="{Binding HasError,Converter={StaticResource BoolVisibility}}"><TextBlock Text="{Binding Error}" Foreground="#FF8A8A" TextWrapping="Wrap"/></Border>
 </StackPanel></ScrollViewer>
</UserControl>
