<UserControl x:Class="PhotoBooth.Admin.UI.Views.DiagnosticsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><ScrollViewer><StackPanel Margin="32"><DockPanel><TextBlock Text="Diagnostics" Style="{StaticResource PageTitle}"/><Button Content="Refresh" Command="{Binding RefreshCommand}" DockPanel.Dock="Right" Width="140"/></DockPanel><TextBlock Text="Tổng hợp toàn hệ thống" FontSize="18" Foreground="{StaticResource AccentBrush}" Margin="0,20,0,0"/><UniformGrid Columns="3" Margin="0,12,0,0"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Tổng ảnh đã chụp" FontSize="16" Foreground="#999"/><TextBlock Text="{Binding CaptureCount,StringFormat={}{0:N0}}" FontSize="34" Foreground="{StaticResource AccentBrush}"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Tổng lượt in thành công" FontSize="16" Foreground="#999"/><TextBlock Text="{Binding PrintCount,StringFormat={}{0:N0}}" FontSize="34" Foreground="{StaticResource AccentBrush}"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Tổng lượt photobooth hoàn tất" FontSize="16" Foreground="#999"/><TextBlock Text="{Binding SessionCount,StringFormat={}{0:N0}}" FontSize="34" Foreground="{StaticResource AccentBrush}"/></StackPanel></Border></UniformGrid><UniformGrid Columns="2" Margin="0,24,0,0"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Camera" FontSize="20"/><TextBlock Text="{Binding Snapshot.Camera}" FontSize="32" Foreground="{StaticResource AccentBrush}"/><TextBlock Text="{Binding Snapshot.CameraSdkVersion, StringFormat=SDK {0}}"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Printer / Queue" FontSize="20"/><TextBlock Text="{Binding Snapshot.Printer}" FontSize="32"/><TextBlock Text="{Binding Snapshot.PendingPrintJobs, StringFormat=Pending jobs: {0}}"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Storage" FontSize="20"/><TextBlock Text="{Binding Snapshot.Storage}" FontSize="32"/><TextBlock Text="{Binding Snapshot.AvailableDiskBytes, StringFormat=Free bytes: {0:N0}}"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Process" FontSize="20"/><TextBlock Text="{Binding Snapshot.ManagedMemoryBytes, StringFormat=Managed memory: {0:N0} bytes}"/><TextBlock Text="{Binding Snapshot.LiveViewFps, StringFormat=Live View: {0:N1} FPS}"/><TextBlock Text="{Binding Snapshot.CpuPercent, StringFormat=CPU: {0:N1}%}"/></StackPanel></Border></UniformGrid><TextBlock Text="{Binding Error}" Foreground="#F44336" Margin="0,20"/></StackPanel></ScrollViewer></UserControl>
