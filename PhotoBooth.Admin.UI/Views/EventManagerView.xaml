<UserControl x:Class="PhotoBooth.Admin.UI.Views.EventManagerView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource BackgroundBrush}">
 <UserControl.Resources>
  <Style x:Key="EventAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="MinWidth" Value="112"/><Setter Property="Margin" Value="0,0,8,8"/></Style>
  <Style x:Key="EventSecondary" TargetType="Button" BasedOn="{StaticResource EventAction}"><Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/><Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/></Style>
  <Style x:Key="EventDanger" TargetType="Button" BasedOn="{StaticResource EventAction}"><Setter Property="Background" Value="{StaticResource DangerSubtleBrush}"/><Setter Property="BorderBrush" Value="#7D414B"/></Style>
  <Style x:Key="EventLabel" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}"/>
 </UserControl.Resources>
 <Grid Margin="28,24,28,28">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="Sự kiện" Style="{StaticResource PageTitle}"/><TextBlock Text="Chuẩn bị cấu hình, khung ảnh và preset màu cho từng chương trình PhotoBooth." Style="{StaticResource PageSubtitle}"/></StackPanel>
   <Border Grid.Column="1" VerticalAlignment="Center" Background="#263D64" CornerRadius="16" Padding="12,6"><TextBlock Text="{Binding EventSummary}" Foreground="#BDD4FF" FontSize="12"/></Border>
  </Grid>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="330" MinWidth="290"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*" MinWidth="570"/></Grid.ColumnDefinitions>
   <Border Background="{StaticResource CardBrush}" CornerRadius="12"><Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="18,17,18,12"><TextBlock Text="Danh sách event" FontSize="17" FontWeight="Bold"/><TextBlock Text="Chọn event để chỉnh sửa hoặc sử dụng" Foreground="#92939B" FontFamily="Segoe UI" FontSize="12" Margin="0,3,0,0"/></StackPanel>
    <ListBox Grid.Row="1" ItemsSource="{Binding Events}" SelectedItem="{Binding SelectedEvent}" Margin="10,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,6"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Box" Background="#252529" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" Padding="14,12"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Background" Value="#34343A"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Box" Property="Background" Value="#263D64"/><Setter TargetName="Box" Property="BorderBrush" Value="#4F8CFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
     <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontSize="15" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding UpdatedAtUtc,StringFormat={}{0:dd/MM/yyyy}}" Foreground="#92939B" FontFamily="Segoe UI" FontSize="11" Margin="0,5,0,0"/></StackPanel><Border Grid.Column="1" Background="#245B46" CornerRadius="10" Padding="8,3" Margin="8,0,0,0" VerticalAlignment="Top" Visibility="{Binding IsDefault,Converter={StaticResource BoolVisibility}}"><TextBlock Text="ĐANG DÙNG" Foreground="#9BE2BE" FontSize="9"/></Border></Grid></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <Border Grid.Row="2" BorderBrush="#3C3C40" BorderThickness="0,1,0,0" Padding="14"><StackPanel><TextBlock Text="Tên event mới" Style="{StaticResource EventLabel}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding CreateName,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/><Button Grid.Column="1" Content="+ Tạo" Command="{Binding CreateCommand}" Margin="0"/></Grid></StackPanel></Border>
   </Grid></Border>
   <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" Background="Transparent"/>
   <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel IsEnabled="{Binding HasSelection}">
     <!-- Card 1: capture settings -->
     <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="20" Margin="0,0,0,12"><StackPanel>
      <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Cấu hình lượt chụp" FontSize="18" FontWeight="Bold"/><TextBlock Text="Tên, thời lượng và cách hiển thị của event." Foreground="#92939B" FontFamily="Segoe UI" FontSize="12" Margin="0,4,0,0"/></StackPanel><Border Grid.Column="1" Background="#245B46" CornerRadius="11" Padding="10,4" Visibility="{Binding IsActive,Converter={StaticResource BoolVisibility}}"><TextBlock Text="Đang được sử dụng" Foreground="#9BE2BE" FontSize="11"/></Border></Grid>
      <TextBlock Text="Tên hiển thị" Style="{StaticResource EventLabel}"/><TextBox Text="{Binding EditName,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <StackPanel Margin="0,0,10,0"><TextBlock Text="Photo Count" Style="{StaticResource EventLabel}"/><ComboBox ItemsSource="{Binding PhotoCounts}" SelectedItem="{Binding PhotoCount}"/></StackPanel>
       <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="Countdown" Style="{StaticResource EventLabel}"/><ComboBox ItemsSource="{Binding Countdowns}" SelectedItem="{Binding Countdown}"/></StackPanel>
       <StackPanel Grid.Column="2"><TextBlock Text="Thời gian mỗi ảnh GIF" Style="{StaticResource EventLabel}"/><ComboBox ItemsSource="{Binding GifDurations}" SelectedItem="{Binding GifDuration}"/></StackPanel>
      </Grid>
      <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <StackPanel Margin="0,0,10,0"><TextBlock Text="Thời gian màn hình chờ" Style="{StaticResource EventLabel}"/><ComboBox ItemsSource="{Binding WaitingTimeouts}" SelectedItem="{Binding WaitingTimeout}"/></StackPanel>
       <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="Hướng màn hình Customer" Style="{StaticResource EventLabel}"/><ComboBox ItemsSource="{Binding Layouts}" SelectedItem="{Binding Layout}"/></StackPanel>
       <StackPanel Grid.Column="2"><TextBlock Text="Xoay ảnh" Style="{StaticResource EventLabel}"/><ComboBox ItemsSource="{Binding Rotations}" SelectedItem="{Binding Rotation}"/></StackPanel>
      </Grid>
      <WrapPanel Margin="0,16,0,0"><Button Content="Lưu cấu hình" Command="{Binding SaveCommand}" Style="{StaticResource EventAction}"/><Button Content="Lưu &amp; sử dụng" Command="{Binding ActivateCommand}" Style="{StaticResource EventAction}" Background="#267454" MinWidth="144"/><Button Content="Tải lại" Command="{Binding ReloadCommand}" Style="{StaticResource EventSecondary}"/><Button Content="Xóa event" Command="{Binding DeleteCommand}" Style="{StaticResource EventDanger}"/></WrapPanel>
     </StackPanel></Border>
     <!-- Card 2: beauty -->
     <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="20" Margin="0,0,0,12"><StackPanel>
      <TextBlock Text="Beauty" FontSize="18" FontWeight="Bold"/><TextBlock Text="Cấu hình retouch riêng, được áp dụng khi event này được sử dụng." Foreground="#92939B" FontFamily="Segoe UI" FontSize="12" Margin="0,4,0,14"/>
      <CheckBox Content="Bật Beauty" IsChecked="{Binding BeautyEnabled}" Margin="4,0,4,12"/>
      <Grid IsEnabled="{Binding IsBeautyEditorEnabled}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <StackPanel Margin="0,0,18,0">
        <Grid Margin="4,7"><Grid.ColumnDefinitions><ColumnDefinition Width="115"/><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions><TextBlock Text="Smooth Skin"/><Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding SmoothSkin}"/><TextBlock Grid.Column="2" Text="{Binding SmoothSkin}" HorizontalAlignment="Right"/></Grid>
        <Grid Margin="4,7"><Grid.ColumnDefinitions><ColumnDefinition Width="115"/><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions><TextBlock Text="Brighten Skin"/><Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding BrightenSkin}"/><TextBlock Grid.Column="2" Text="{Binding BrightenSkin}" HorizontalAlignment="Right"/></Grid>
        <Grid Margin="4,7"><Grid.ColumnDefinitions><ColumnDefinition Width="115"/><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions><TextBlock Text="Skin Tone"/><Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding SkinTone}"/><TextBlock Grid.Column="2" Text="{Binding SkinTone}" HorizontalAlignment="Right"/></Grid>
       </StackPanel>
       <StackPanel Grid.Column="1">
        <Grid Margin="4,7"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions><TextBlock Text="Sharpen"/><Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Sharpen}"/><TextBlock Grid.Column="2" Text="{Binding Sharpen}" HorizontalAlignment="Right"/></Grid>
        <Grid Margin="4,7"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions><TextBlock Text="Eye Size"/><Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding EyeSize}"/><TextBlock Grid.Column="2" Text="{Binding EyeSize}" HorizontalAlignment="Right"/></Grid>
        <Grid Margin="4,7"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions><TextBlock Text="Slim Face"/><Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding SlimFace}"/><TextBlock Grid.Column="2" Text="{Binding SlimFace}" HorizontalAlignment="Right"/></Grid>
       </StackPanel>
      </Grid>
     </StackPanel></Border>
     <!-- Card 3: frames -->
     <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="20" Margin="0,0,0,12"><StackPanel>
      <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Frame của event" FontSize="18" FontWeight="Bold"/><TextBlock Text="Thumbnail lớn; thứ tự này cũng là thứ tự frame được ghim." Foreground="#92939B" FontFamily="Segoe UI" FontSize="12" Margin="0,4,0,0"/></StackPanel><Border Grid.Column="1" Background="#263D64" CornerRadius="12" Padding="10,5" VerticalAlignment="Center" Margin="8,0"><TextBlock Text="{Binding FrameSummary}" Foreground="#BDD4FF" FontSize="11"/></Border><Button Grid.Column="2" Content="+ Thêm frame" Command="{Binding OpenFramePickerCommand}" Margin="0"/></Grid>
      <ItemsControl ItemsSource="{Binding SelectedFrames}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Width="210" Height="170" Background="#18181B" CornerRadius="9" Margin="0,0,12,12" ClipToBounds="True"><Grid><Image Source="{Binding ThumbnailPath}" Stretch="Uniform" Margin="8"/><Button Content="×" Command="{Binding DataContext.RemoveFrameCommand,RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" HorizontalAlignment="Right" VerticalAlignment="Top" Width="30" Height="30" Padding="0" Margin="6" Background="#CC8E3B46" FontSize="18"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <TextBlock Text="Chưa có frame. Nhấn “Thêm frame” để mở thư viện." Foreground="#777780" Margin="4,6"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedFrames.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
     </StackPanel></Border>
     <!-- Card 4: presets -->
     <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="20"><StackPanel>
      <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Preset của event" FontSize="18" FontWeight="Bold"/><TextBlock Text="Hiệu ứng màu áp dụng trên ảnh mẫu ở cường độ mặc định 50%." Foreground="#92939B" FontFamily="Segoe UI" FontSize="12" Margin="0,4,0,0"/></StackPanel><Border Grid.Column="1" Background="#263D64" CornerRadius="12" Padding="10,5" VerticalAlignment="Center" Margin="8,0"><TextBlock Text="{Binding PresetSummary}" Foreground="#BDD4FF" FontSize="11"/></Border><Button Grid.Column="2" Content="+ Thêm preset" Command="{Binding OpenPresetPickerCommand}" Margin="0"/></Grid>
      <ItemsControl ItemsSource="{Binding SelectedPresets}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Width="210" Height="250" Background="#18181B" CornerRadius="9" Margin="0,0,12,12" ClipToBounds="True"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Image Source="{Binding PreviewBytes,Converter={StaticResource ByteImage}}" Stretch="Uniform" Margin="8"/><Border Grid.Row="1" Background="#242428" Padding="10,9"><TextBlock Text="{Binding Name}" TextAlignment="Center" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></Border><Button Content="×" Command="{Binding DataContext.RemovePresetCommand,RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" HorizontalAlignment="Right" VerticalAlignment="Top" Width="30" Height="30" Padding="0" Margin="6" Background="#CC8E3B46" FontSize="18"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <TextBlock Text="Chưa có preset. Nhấn “Thêm preset” để mở thư viện." Foreground="#777780" Margin="4,6"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedPresets.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
     </StackPanel></Border>
     <Border Background="#3A321F" BorderBrush="#6A582B" BorderThickness="1" CornerRadius="7" Padding="11,9" Margin="0,12,0,0" Visibility="{Binding HasMessage,Converter={StaticResource BoolVisibility}}"><TextBlock Text="{Binding Message}" Foreground="#FFD98A" FontFamily="Segoe UI" FontSize="12" TextWrapping="Wrap"/></Border>
    </StackPanel>
   </ScrollViewer>
  </Grid>
 </Grid>
</UserControl>
