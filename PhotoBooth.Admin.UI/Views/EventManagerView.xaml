<UserControl x:Class="PhotoBooth.Admin.UI.Views.EventManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}"
             UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <Style x:Key="EventLabel" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}"/>
        <Style x:Key="EventAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="MinWidth" Value="112"/><Setter Property="Margin" Value="8,4,0,4"/></Style>
        <Style x:Key="EventSecondary" TargetType="Button" BasedOn="{StaticResource EventAction}"><Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/><Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/></Style>
        <Style x:Key="EventDanger" TargetType="Button" BasedOn="{StaticResource EventAction}"><Setter Property="Background" Value="{StaticResource DangerSubtleBrush}"/><Setter Property="BorderBrush" Value="#A65360"/><Setter Property="Foreground" Value="#FFF1F2"/></Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#F7F8FC"/></Style>
        <Style x:Key="SectionSubtitle" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="#BBC1CE"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,4,0,0"/></Style>
    </UserControl.Resources>

    <Grid Margin="28,24,28,28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Border Width="42" Height="42" CornerRadius="12" Background="#223A68" Margin="0,0,12,0">
                    <Path Data="{DynamicResource Icon.Calendar}" Stroke="#8DB5FF" StrokeThickness="1.8" Width="21" Height="21" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center"><TextBlock Text="Sự kiện &amp; vận hành" Style="{StaticResource PageTitle}"/><TextBlock Text="Chuẩn bị cấu hình, chọn sự kiện đang chạy và quản lý nơi lưu ảnh." Style="{StaticResource PageSubtitle}"/></StackPanel>
            </StackPanel>
            <Border Grid.Column="1" VerticalAlignment="Center" Background="#223A68" BorderBrush="#3E609D" BorderThickness="1" CornerRadius="16" Padding="13,6"><TextBlock Text="{Binding EventSummary}" Foreground="#C9DBFF" FontSize="12" FontWeight="SemiBold"/></Border>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="310" MinWidth="286"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*" MinWidth="620"/></Grid.ColumnDefinitions>
            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Margin="18,17,18,13"><TextBlock Text="Danh sách sự kiện" Style="{StaticResource SectionTitle}"/><TextBlock Text="Sự kiện có nhãn xanh đang được booth sử dụng." Style="{StaticResource SectionSubtitle}"/></StackPanel>
                    <ListBox Grid.Row="1" ItemsSource="{Binding Events}" SelectedItem="{Binding SelectedEvent}" Margin="10,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,7"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Box" Background="#20242C" BorderBrush="#343A46" BorderThickness="1" CornerRadius="10" Padding="13,12"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Background" Value="#282E39"/><Setter TargetName="Box" Property="BorderBrush" Value="#536178"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Box" Property="Background" Value="#243B69"/><Setter TargetName="Box" Property="BorderBrush" Value="#6799F8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Box" Property="Opacity" Value="0.56"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="#F5F7FB" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding LifecycleDisplayName}" Foreground="#C1C7D2" FontSize="11" Margin="0,5,0,0"/><WrapPanel Margin="0,8,0,0"><Border Background="#204D3C" BorderBrush="#3B9A70" BorderThickness="1" CornerRadius="9" Padding="7,2" Margin="0,0,6,0" Visibility="{Binding IsSelectedForThisDevice,Converter={StaticResource BoolVisibility}}"><TextBlock Text="ĐANG VẬN HÀNH" Foreground="#BFF3D4" FontSize="9" FontWeight="Bold"/></Border><Border Background="#3B3420" BorderBrush="#8D7330" BorderThickness="1" CornerRadius="9" Padding="7,2" Visibility="{Binding IsSystemDefault,Converter={StaticResource BoolVisibility}}"><TextBlock Text="MẶC ĐỊNH" Foreground="#FFE49B" FontSize="9" FontWeight="Bold"/></Border></WrapPanel></StackPanel></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <Border Grid.Row="2" BorderBrush="#343A46" BorderThickness="0,1,0,0" Padding="14"><StackPanel><TextBlock Text="Tạo sự kiện mới" Style="{StaticResource EventLabel}"/><TextBox Text="{Binding CreateName,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,9"/><Button Content="Tạo sự kiện" Command="{Binding CreateCommand}" Margin="0"/></StackPanel></Border>
                </Grid>
            </Border>

            <Grid Grid.Column="2" IsEnabled="{Binding HasSelection}">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="18,15" Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><WrapPanel><TextBlock Text="{Binding SelectedEventName}" FontSize="20" FontWeight="SemiBold" Foreground="#F8F9FC" TextTrimming="CharacterEllipsis"/><Border Background="#3B3420" BorderBrush="#8D7330" BorderThickness="1" CornerRadius="10" Padding="8,3" Margin="10,1,0,0" Visibility="{Binding IsSystemDefault,Converter={StaticResource BoolVisibility}}"><StackPanel Orientation="Horizontal"><Path Data="{DynamicResource Icon.Lock}" Stroke="#FFE49B" StrokeThickness="1.6" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0"/><TextBlock Text="SỰ KIỆN MẶC ĐỊNH" Foreground="#FFE49B" FontSize="9" FontWeight="Bold"/></StackPanel></Border></WrapPanel><TextBlock Text="{Binding LifecycleStatusText}" Foreground="#91B6FF" FontSize="12" Margin="0,5,0,0"/></StackPanel><Border Grid.Column="1" CornerRadius="12" Padding="11,5" VerticalAlignment="Center"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#223A68"/><Setter Property="BorderBrush" Value="#4F7CC8"/><Setter Property="BorderThickness" Value="1"/><Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="Background" Value="#204D3C"/><Setter Property="BorderBrush" Value="#3B9A70"/></DataTrigger><DataTrigger Binding="{Binding Dirty}" Value="True"><Setter Property="Background" Value="#493A1E"/><Setter Property="BorderBrush" Value="#B08A38"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding ActionStatusText}" Foreground="#E8EEFA" FontSize="11" FontWeight="SemiBold"/></Border></Grid>
                        <Grid Grid.Row="1" Margin="0,13,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Mọi thay đổi chỉ áp dụng từ lượt chụp tiếp theo." Foreground="#BBC1CE" FontSize="12" VerticalAlignment="Center"/><WrapPanel Grid.Column="1" HorizontalAlignment="Right"><Button Content="Hoàn tác" Command="{Binding ReloadCommand}" Style="{StaticResource EventSecondary}"/><Button Content="Lưu thay đổi" Command="{Binding SaveCommand}" Style="{StaticResource EventAction}"/><Button Content="{Binding LifecycleActionText}" Command="{Binding AdvanceLifecycleCommand}" Style="{StaticResource EventSecondary}" MinWidth="150"/><Button Content="{Binding PrimaryActionText}" Command="{Binding ActivateCommand}" Style="{StaticResource EventAction}" Background="#287A52" BorderBrush="#48A77B" MinWidth="158"/><Button Content="Xóa sự kiện" Command="{Binding DeleteCommand}" Style="{StaticResource EventDanger}"/></WrapPanel></Grid>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel IsEnabled="{Binding CanEditConfiguration}">
                        <Border Background="#272513" BorderBrush="#71632F" BorderThickness="1" CornerRadius="11" Padding="14,11" Margin="0,0,0,12" Visibility="{Binding IsSystemDefault,Converter={StaticResource BoolVisibility}}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path Data="{DynamicResource Icon.Lock}" Stroke="#FFE49B" StrokeThickness="1.7" Width="18" Height="18" Stretch="Uniform" Margin="0,1,11,0"/><StackPanel Grid.Column="1"><TextBlock Text="Sự kiện khởi động an toàn" Foreground="#FFE49B" FontWeight="SemiBold"/><TextBlock Text="Sự kiện này luôn có sẵn, luôn mở và không thể xóa. Bạn vẫn có thể đổi tên, nơi lưu ảnh và toàn bộ thông số bên dưới." Foreground="#F2E6BE" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel></Grid></Border>

                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="20" Margin="0,0,0,12"><StackPanel><TextBlock Text="Thông tin &amp; lưu trữ" Style="{StaticResource SectionTitle}"/><TextBlock Text="Ảnh xuất của sự kiện sẽ được gom về thư mục này; dữ liệu vận hành nội bộ vẫn được ứng dụng quản lý an toàn." Style="{StaticResource SectionSubtitle}" Margin="0,4,0,15"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="1.45*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="Tên hiển thị" Style="{StaticResource EventLabel}"/><TextBox Text="{Binding EditName,UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Thư mục lưu ảnh trên máy" Style="{StaticResource EventLabel}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding OutputDirectory,UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding OutputDirectory}" Margin="0,0,8,0"/><Button Grid.Column="1" Content="Chọn thư mục" Command="{Binding ChooseOutputDirectoryCommand}" Style="{StaticResource EventSecondary}" Margin="0" MinWidth="124"/></Grid></StackPanel></Grid></StackPanel></Border>

                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="20" Margin="0,0,0,12"><StackPanel><TextBlock Text="Thông số lượt chụp" Style="{StaticResource SectionTitle}"/><TextBlock Text="Các giá trị này được khóa theo sự kiện và hiển thị dạng chỉ đọc ở trang Tổng quan." Style="{StaticResource SectionSubtitle}" Margin="0,4,0,15"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,10,0"><TextBlock Text="Số ảnh mỗi lượt" Style="{StaticResource EventLabel}"/><ComboBox ItemsSource="{Binding PhotoCounts}" SelectedItem="{Binding PhotoCount}"/></StackPanel><StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="Đếm ngược (giây)" Style="{StaticResource EventLabel}"/><ComboBox ItemsSource="{Binding Countdowns}" SelectedItem="{Binding Countdown}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Thời gian mỗi ảnh GIF" Style="{StaticResource EventLabel}"/><ComboBox ItemsSource="{Binding GifDurations}" SelectedItem="{Binding GifDuration}"/></StackPanel></Grid><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,10,0"><TextBlock Text="Màn hình chờ" Style="{StaticResource EventLabel}"/><ComboBox ItemsSource="{Binding WaitingTimeouts}" SelectedItem="{Binding WaitingTimeout}"/></StackPanel><StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="Hướng màn hình khách" Style="{StaticResource EventLabel}"/><ComboBox ItemsSource="{Binding Layouts}" SelectedItem="{Binding Layout}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Xoay ảnh" Style="{StaticResource EventLabel}"/><ComboBox ItemsSource="{Binding Rotations}" SelectedItem="{Binding Rotation}"/></StackPanel></Grid></StackPanel></Border>

                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="20" Margin="0,0,0,12"><StackPanel><TextBlock Text="Giá &amp; in ảnh" Style="{StaticResource SectionTitle}"/><TextBlock Text="Thiết lập doanh thu và số bản in áp dụng cho từng lượt chụp." Style="{StaticResource SectionSubtitle}" Margin="0,4,0,15"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,10,0"><TextBlock Text="Giá một lượt chụp" Style="{StaticResource EventLabel}"/><TextBox Text="{Binding BasePriceMinor,UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Giá mỗi ảnh in thêm" Style="{StaticResource EventLabel}"/><TextBox Text="{Binding AdditionalPrintPriceMinor,UpdateSourceTrigger=PropertyChanged}"/></StackPanel></Grid><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,10,0"><TextBlock Text="Cách in ảnh" Style="{StaticResource EventLabel}"/><ComboBox ItemsSource="{Binding PrintPolicies}" SelectedItem="{Binding PrintPolicy}"/></StackPanel><StackPanel Grid.Column="1" Margin="0,0,10,0" IsEnabled="{Binding IsPrintingConfigured}"><TextBlock Text="Số bản có sẵn" Style="{StaticResource EventLabel}"/><TextBox Text="{Binding IncludedPrintCopies,UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Column="2" IsEnabled="{Binding IsPrintingConfigured}"><TextBlock Text="Số bản tối đa" Style="{StaticResource EventLabel}"/><TextBox Text="{Binding MaximumPrintCopies,UpdateSourceTrigger=PropertyChanged}"/></StackPanel></Grid></StackPanel></Border>

                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="20" Margin="0,0,0,12"><StackPanel><Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Khung ảnh" Style="{StaticResource SectionTitle}"/><TextBlock Text="Thứ tự bên dưới cũng là thứ tự hiển thị tại màn hình khách." Style="{StaticResource SectionSubtitle}"/></StackPanel><Border Grid.Column="1" Background="#223A68" CornerRadius="11" Padding="10,5" VerticalAlignment="Center" Margin="8,0"><TextBlock Text="{Binding FrameSummary}" Foreground="#C9DBFF" FontSize="11"/></Border><Button Grid.Column="2" Content="Chọn khung ảnh" Command="{Binding OpenFramePickerCommand}" Margin="0"/></Grid><ItemsControl ItemsSource="{Binding SelectedFrames}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Width="172" Height="142" Background="#171A20" BorderBrush="#383F4C" BorderThickness="1" CornerRadius="10" Margin="0,0,12,12" ClipToBounds="True"><Grid><Image Source="{Binding ThumbnailPath}" Stretch="Uniform" Margin="8"/><Button Command="{Binding DataContext.RemoveFrameCommand,RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" HorizontalAlignment="Right" VerticalAlignment="Top" Width="30" Height="30" Padding="0" Margin="6" Background="#DB7A3341" BorderBrush="#C65B6A" ToolTip="Bỏ khung ảnh"><Path Data="M 5,5 L 15,15 M 15,5 L 5,15" Stroke="#FFF1F2" StrokeThickness="2" Width="14" Height="14" Stretch="Uniform"/></Button></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="Chưa có khung ảnh. Hãy chọn ít nhất một khung để sự kiện có thể vận hành." Foreground="#F4C879" Margin="4,6"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedFrames.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></Border>

                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="20" Margin="0,0,0,12"><StackPanel><Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Preset màu" Style="{StaticResource SectionTitle}"/><TextBlock Text="Có thể để trống để giữ màu ảnh gốc." Style="{StaticResource SectionSubtitle}"/></StackPanel><StackPanel Grid.Column="1" Margin="16,0"><TextBlock Text="Cường độ màu" Style="{StaticResource EventLabel}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions><Slider Minimum="0" Maximum="100" Value="{Binding ColorPresetStrengthPercent}"/><TextBlock Grid.Column="1" Text="{Binding ColorPresetStrengthText}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#E9ECF2"/></Grid></StackPanel><Border Grid.Column="2" Background="#223A68" CornerRadius="11" Padding="10,5" VerticalAlignment="Center" Margin="8,0"><TextBlock Text="{Binding PresetSummary}" Foreground="#C9DBFF" FontSize="11"/></Border><Button Grid.Column="3" Content="Chọn preset" Command="{Binding OpenPresetPickerCommand}" Margin="0"/></Grid><ItemsControl ItemsSource="{Binding SelectedPresets}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Width="172" Height="212" Background="#171A20" BorderBrush="#383F4C" BorderThickness="1" CornerRadius="10" Margin="0,0,12,12" ClipToBounds="True"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Image Source="{Binding PreviewBytes,Converter={StaticResource ByteImage}}" Stretch="Uniform" Margin="8"/><Border Grid.Row="1" Background="#252A34" Padding="9"><TextBlock Text="{Binding Name}" TextAlignment="Center" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="#F5F7FB"/></Border><Button Command="{Binding DataContext.RemovePresetCommand,RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" HorizontalAlignment="Right" VerticalAlignment="Top" Width="30" Height="30" Padding="0" Margin="6" Background="#DB7A3341" BorderBrush="#C65B6A" ToolTip="Bỏ preset"><Path Data="M 5,5 L 15,15 M 15,5 L 5,15" Stroke="#FFF1F2" StrokeThickness="2" Width="14" Height="14" Stretch="Uniform"/></Button></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="Không áp dụng preset màu." Foreground="#BBC1CE" Margin="4,6"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedPresets.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></Border>

                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="20" Margin="0,0,0,12"><StackPanel><TextBlock Text="Làm đẹp" Style="{StaticResource SectionTitle}"/><TextBlock Text="Điều chỉnh nhẹ riêng cho sự kiện; tắt để giữ ảnh nguyên bản." Style="{StaticResource SectionSubtitle}" Margin="0,4,0,13"/><CheckBox Content="Bật làm đẹp" IsChecked="{Binding BeautyEnabled}" Margin="3,0,3,12"/><Grid IsEnabled="{Binding IsBeautyEditorEnabled}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,18,0"><Grid Margin="4,6"><Grid.ColumnDefinitions><ColumnDefinition Width="118"/><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions><TextBlock Text="Làm mịn da" Foreground="#E9ECF2"/><Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding SmoothSkin}"/><TextBlock Grid.Column="2" Text="{Binding SmoothSkin}" HorizontalAlignment="Right" Foreground="#E9ECF2"/></Grid><Grid Margin="4,6"><Grid.ColumnDefinitions><ColumnDefinition Width="118"/><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions><TextBlock Text="Làm sáng da" Foreground="#E9ECF2"/><Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding BrightenSkin}"/><TextBlock Grid.Column="2" Text="{Binding BrightenSkin}" HorizontalAlignment="Right" Foreground="#E9ECF2"/></Grid><Grid Margin="4,6"><Grid.ColumnDefinitions><ColumnDefinition Width="118"/><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions><TextBlock Text="Tông da" Foreground="#E9ECF2"/><Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding SkinTone}"/><TextBlock Grid.Column="2" Text="{Binding SkinTone}" HorizontalAlignment="Right" Foreground="#E9ECF2"/></Grid><Grid Margin="4,6"><Grid.ColumnDefinitions><ColumnDefinition Width="118"/><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions><TextBlock Text="Độ nét" Foreground="#E9ECF2"/><Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Sharpen}"/><TextBlock Grid.Column="2" Text="{Binding Sharpen}" HorizontalAlignment="Right" Foreground="#E9ECF2"/></Grid></StackPanel><StackPanel Grid.Column="1"><Grid Margin="4,6"><Grid.ColumnDefinitions><ColumnDefinition Width="126"/><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions><TextBlock Text="Mở rộng mắt" Foreground="#E9ECF2"/><Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding EyeSize}"/><TextBlock Grid.Column="2" Text="{Binding EyeSize}" HorizontalAlignment="Right" Foreground="#E9ECF2"/></Grid><Grid Margin="4,6"><Grid.ColumnDefinitions><ColumnDefinition Width="126"/><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions><TextBlock Text="Thon gọn mặt" Foreground="#E9ECF2"/><Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding SlimFace}"/><TextBlock Grid.Column="2" Text="{Binding SlimFace}" HorizontalAlignment="Right" Foreground="#E9ECF2"/></Grid><Grid Margin="4,6"><Grid.ColumnDefinitions><ColumnDefinition Width="126"/><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions><TextBlock Text="Xóa khuyết điểm" Foreground="#E9ECF2"/><Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding BlemishRemoval}"/><TextBlock Grid.Column="2" Text="{Binding BlemishRemoval}" HorizontalAlignment="Right" Foreground="#E9ECF2"/></Grid><Grid Margin="4,6"><Grid.ColumnDefinitions><ColumnDefinition Width="126"/><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions><TextBlock Text="Giảm quầng thâm" Foreground="#E9ECF2"/><Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding DarkCircleReduction}"/><TextBlock Grid.Column="2" Text="{Binding DarkCircleReduction}" HorizontalAlignment="Right" Foreground="#E9ECF2"/></Grid></StackPanel></Grid></StackPanel></Border>

                        <Border Background="#3A321F" BorderBrush="#8A7132" BorderThickness="1" CornerRadius="9" Padding="12,10" Visibility="{Binding HasMessage,Converter={StaticResource BoolVisibility}}"><TextBlock Text="{Binding Message}" Foreground="#FFE29A" FontSize="12" TextWrapping="Wrap"/></Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
