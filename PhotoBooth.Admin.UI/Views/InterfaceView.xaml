<UserControl x:Class="PhotoBooth.Admin.UI.Views.InterfaceView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <DockPanel><TextBlock Text="Interface backgrounds" Style="{StaticResource PageTitle}"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Import image / GIF" Command="{Binding ImportCommand}"/><Button Content="Refresh" Command="{Binding RefreshCommand}"/></StackPanel></DockPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Card}"><ListBox ItemsSource="{Binding Assets}" SelectedItem="{Binding SelectedAsset}"><ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate><Border Width="220" Margin="6" Padding="6" Background="#252526" CornerRadius="8"><StackPanel><Image Source="{Binding FilePath}" Width="208" Height="125" Stretch="UniformToFill"/><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Margin="3"/><TextBlock Text="SELECTED" Foreground="#70D67C" FontWeight="Bold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Border>
   <Border Grid.Column="1" Style="{StaticResource Card}"><DockPanel>
    <StackPanel DockPanel.Dock="Bottom"><Button Content="Chọn ảnh này làm background" Command="{Binding SelectCommand}" Background="#4CAF50"/>
     <CheckBox Content="Hiển thị Live View ở màn hình chờ" IsChecked="{Binding ShowLiveView}" Margin="4,12,4,4"/>
     <TextBlock Text="Kích thước Live View" Margin="4,12,4,0"/><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding LiveViewAreaText}" Width="100" VerticalAlignment="Center" TextAlignment="Right"/><Slider Minimum="5" Maximum="40" Value="{Binding LiveViewAreaPercent,Mode=TwoWay}" TickFrequency="1"/></DockPanel>
     <TextBlock Text="Live View luôn được căn chính giữa · ngang 3:4 · dọc 4:3 (cao:rộng)" Margin="4,12,4,4" Foreground="#B8B4BE" TextWrapping="Wrap"/>
     <TextBlock Text="Background vẫn có thể kéo trực tiếp và dùng con lăn chuột để căn ảnh." Foreground="#9A9AA2" FontSize="12" Margin="4,10,4,2" TextWrapping="Wrap"/>
     <WrapPanel HorizontalAlignment="Center"><Button Content="Lưu bố cục" Command="{Binding SaveLiveViewCommand}" Background="#4CAF50"/><Button Content="Đặt lại mặc định" Command="{Binding ResetLiveViewCommand}"/></WrapPanel><TextBlock Text="{Binding Message}" Foreground="#FFB74D" Margin="6"/>
    </StackPanel>
    <Viewbox Stretch="Uniform" Margin="0,0,0,12"><Canvas x:Name="PreviewCanvas" Width="{Binding PreviewCanvasWidth}" Height="{Binding PreviewCanvasHeight}" Background="#111" ClipToBounds="True" Cursor="Hand" MouseLeftButtonDown="PreviewCanvas_MouseLeftButtonDown" MouseLeftButtonUp="PreviewCanvas_MouseLeftButtonUp" MouseMove="PreviewCanvas_MouseMove" MouseWheel="PreviewCanvas_MouseWheel"><Image Canvas.Left="{Binding PreviewBackgroundX}" Canvas.Top="{Binding PreviewBackgroundY}" Width="{Binding PreviewBackgroundWidth}" Height="{Binding PreviewBackgroundHeight}" Source="{Binding SelectedAsset.FilePath}" Stretch="UniformToFill" IsHitTestVisible="False"/><Border Width="{Binding PreviewCanvasWidth}" Height="{Binding PreviewCanvasHeight}" Background="#22000000" IsHitTestVisible="False"/><TextBlock Canvas.Left="24" Canvas.Top="20" Text="{Binding PreviewOrientationText}" Foreground="#CCFFFFFF" FontWeight="SemiBold" FontSize="22" IsHitTestVisible="False"/><Border Canvas.Left="{Binding PreviewLiveViewX}" Canvas.Top="{Binding PreviewLiveViewY}" Width="{Binding PreviewLiveViewWidth}" Height="{Binding PreviewLiveViewHeight}" CornerRadius="24" BorderThickness="6" BorderBrush="#99FFFFFF" Background="#66000000" Visibility="{Binding ShowLiveView,Converter={StaticResource BoolVisibility}}" IsHitTestVisible="False"><Grid><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="↑" Foreground="White" FontSize="58" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5"><TextBlock.RenderTransform><RotateTransform Angle="{Binding ImageRotation}"/></TextBlock.RenderTransform></TextBlock><TextBlock Text="LIVE VIEW" Foreground="White" FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="{Binding ImageRotation,StringFormat=Xoay {0}°}" Foreground="#D8D5DC" FontSize="20" Margin="0,8,0,0" HorizontalAlignment="Center"/></StackPanel></Grid></Border></Canvas></Viewbox>
   </DockPanel></Border>
  </Grid>
 </Grid>
</UserControl>
