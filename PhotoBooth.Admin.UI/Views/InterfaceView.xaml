<UserControl x:Class="PhotoBooth.Admin.UI.Views.InterfaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28,24,28,28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Margin="4,0,4,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="Giao diện màn hình khách" Style="{StaticResource PageTitle}"/><TextBlock Text="Quản lý ảnh nền và bố cục Live View của màn hình chờ." Style="{StaticResource PageSubtitle}"/></StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Làm mới" Command="{Binding RefreshCommand}" Style="{StaticResource AdminSecondaryButton}"/><Button Content="+ Nhập ảnh hoặc GIF" Command="{Binding ImportCommand}"/></StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="350"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Margin="0" Padding="0">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Margin="18,16,18,12"><TextBlock Text="Thư viện ảnh nền" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Chọn một mục để xem trước" Style="{StaticResource PageSubtitle}" FontSize="12"/></StackPanel>
                    <ListBox Grid.Row="1" ItemsSource="{Binding Assets}" SelectedItem="{Binding SelectedAsset}" Margin="10,0,10,10" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ItemBorder" Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="7"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource AccentSubtleBrush}"/><Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="112"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="104" Height="68" CornerRadius="6" Background="#090B0F" ClipToBounds="True"><Image Source="{Binding FilePath}" Stretch="UniformToFill"/></Border><TextBlock Grid.Column="1" Text="{Binding Name}" Margin="11,0" TextTrimming="CharacterEllipsis"/><Border Grid.Column="2" Background="{StaticResource SuccessSubtleBrush}" BorderBrush="#32674E" BorderThickness="1" CornerRadius="10" Padding="7,3" VerticalAlignment="Center"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="ĐANG DÙNG" Foreground="#9CE0BD" FontSize="9" FontWeight="SemiBold"/></Border></Grid></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0" Padding="0">
                <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid Margin="16,16,16,0">
                        <Border Background="#090B0F" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="8">
                            <Viewbox Stretch="Uniform">
                                <Canvas x:Name="PreviewCanvas" Width="{Binding PreviewCanvasWidth}" Height="{Binding PreviewCanvasHeight}" Background="#111318" ClipToBounds="True" Cursor="Hand"
                                        MouseLeftButtonDown="PreviewCanvas_MouseLeftButtonDown" MouseLeftButtonUp="PreviewCanvas_MouseLeftButtonUp" MouseMove="PreviewCanvas_MouseMove" MouseWheel="PreviewCanvas_MouseWheel">
                                    <Image Canvas.Left="{Binding PreviewBackgroundX}" Canvas.Top="{Binding PreviewBackgroundY}" Width="{Binding PreviewBackgroundWidth}" Height="{Binding PreviewBackgroundHeight}" Source="{Binding SelectedAsset.FilePath}" Stretch="UniformToFill" IsHitTestVisible="False"/>
                                    <Border Width="{Binding PreviewCanvasWidth}" Height="{Binding PreviewCanvasHeight}" Background="#22000000" IsHitTestVisible="False"/>
                                    <Border Canvas.Left="18" Canvas.Top="18" Background="#C9151820" BorderBrush="#55FFFFFF" BorderThickness="1" CornerRadius="7" Padding="12,7" IsHitTestVisible="False"><TextBlock Text="{Binding PreviewOrientationText}" FontWeight="SemiBold" FontSize="18"/></Border>
                                    <Border Canvas.Left="{Binding PreviewLiveViewX}" Canvas.Top="{Binding PreviewLiveViewY}" Width="{Binding PreviewLiveViewWidth}" Height="{Binding PreviewLiveViewHeight}" CornerRadius="6" BorderThickness="2" BorderBrush="#D789AD" Background="#55000000" Visibility="{Binding ShowLiveView,Converter={StaticResource BoolVisibility}}" IsHitTestVisible="False">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="↑" Foreground="White" FontSize="48" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5"><TextBlock.RenderTransform><RotateTransform Angle="{Binding ImageRotation}"/></TextBlock.RenderTransform></TextBlock><TextBlock Text="LIVE VIEW" Foreground="White" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="{Binding ImageRotation,StringFormat=Xoay {0}°}" Foreground="#D8D5DC" FontSize="15" Margin="0,5,0,0" HorizontalAlignment="Center"/></StackPanel>
                                    </Border>
                                </Canvas>
                            </Viewbox>
                        </Border>
                    </Grid>

                    <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="18,14" Margin="0,16,0,0">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Live View màn hình chờ" Style="{StaticResource SectionTitle}"/>
                                <CheckBox Content="Hiển thị Live View" IsChecked="{Binding ShowLiveView}" Margin="4,0,4,10"/>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions><TextBlock Text="Kích thước" Style="{StaticResource FieldLabel}"/><TextBlock Grid.Column="1" Text="{Binding LiveViewAreaText}" TextAlignment="Right" Foreground="{StaticResource AccentHoverBrush}"/></Grid>
                                <Slider Minimum="5" Maximum="40" Value="{Binding LiveViewAreaPercent,Mode=TwoWay}" TickFrequency="1"/>
                                <TextBlock Text="Kéo trực tiếp bên trong khung Live View để đổi vị trí; khung luôn được giữ trọn trong màn hình." Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="4,8,4,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Căn chỉnh ảnh nền" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Kéo phần nằm ngoài khung Live View để căn ảnh nền; dùng con lăn chuột để phóng to hoặc thu nhỏ." Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                <Button Content="Dùng ảnh nền này" Command="{Binding SelectCommand}" Style="{StaticResource AdminSuccessButton}" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                                <WrapPanel><Button Content="Đặt lại mặc định" Command="{Binding ResetLiveViewCommand}" Style="{StaticResource AdminSecondaryButton}"/><Button Content="Lưu bố cục" Command="{Binding SaveLiveViewCommand}"/></WrapPanel>
                                <TextBlock Text="{Binding Message}" Foreground="{StaticResource WarningBrush}" Margin="4,7,4,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
