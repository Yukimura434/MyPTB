<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:PhotoBooth.Admin.UI.Controls" x:Class="PhotoBooth.Admin.UI.Views.InterfaceView" Background="#121319" UseLayoutRounding="True" RenderOptions.BitmapScalingMode="HighQuality">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PhotoBooth.Customer.UI;component/Themes/ApprovedUx.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="OrientationTab" TargetType="RadioButton" BasedOn="{StaticResource UxTab}">
                <Setter Property="Foreground" Value="#D7DEEA"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Padding" Value="16,10"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Body" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="9" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Body" Property="Background" Value="#345C97"/>
                                    <Setter TargetName="Body" Property="BorderBrush" Value="#BFD6FF"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Body" Property="BorderBrush" Value="#D4E3FF"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Body" Property="BorderBrush" Value="White"/>
                                    <Setter TargetName="Body" Property="BorderThickness" Value="3"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Body" Property="Background" Value="#364253"/>
                                    <Setter Property="Foreground" Value="#D0D9E7"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="EditorToolTab" TargetType="RadioButton" BasedOn="{StaticResource UxTab}">
                <Setter Property="Foreground" Value="#D7DEEA"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Padding" Value="16,10"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Body" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="9" Padding="{TemplateBinding Padding}">
                                <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" HorizontalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Body" Property="Background" Value="#2D405D"/>
                                    <Setter TargetName="Body" Property="BorderBrush" Value="#99BBEE"/>
                                    <Setter Property="Foreground" Value="#E7EFFF"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Body" Property="BorderBrush" Value="#D4E3FF"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Body" Property="BorderBrush" Value="#E7EFFF"/>
                                    <Setter TargetName="Body" Property="BorderThickness" Value="3"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Body" Property="Background" Value="#364253"/>
                                    <Setter Property="Foreground" Value="#D0D9E7"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="EditorItem" TargetType="ListBoxItem">
                <Setter Property="Foreground" Value="#FAF7FC"/>
                <Setter Property="Background" Value="#252C38"/>
                <Setter Property="Padding" Value="10"/>
                <Setter Property="Margin" Value="0,0,12,12"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Grid>
                                <Border x:Name="Body" Background="{TemplateBinding Background}" BorderBrush="#766E81" BorderThickness="1" CornerRadius="13" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter/>
                                </Border>
                                <Border x:Name="Check" Visibility="Collapsed" Width="23" Height="23" Background="#B6CFFF" CornerRadius="12" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="5">
                                    <TextBlock Text="✓" Foreground="#291020" FontSize="14" HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Body" Property="BorderBrush" Value="#B6CFFF"/>
                                    <Setter TargetName="Body" Property="BorderThickness" Value="2"/>
                                    <Setter TargetName="Body" Property="Background" Value="#344768"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Body" Property="BorderBrush" Value="#C9BDD6"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="Body" Property="BorderBrush" Value="#FFE1EE"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="EditorSave" TargetType="Button" BasedOn="{StaticResource UxButton}">
                <Setter Property="Background" Value="#B9D0FF"/>
                <Setter Property="BorderBrush" Value="#B9D0FF"/>
                <Setter Property="Foreground" Value="#17263D"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Body" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="13" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}">
                                    <ContentPresenter.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/>
                                            <Setter Property="FontSize" Value="{Binding FontSize,RelativeSource={RelativeSource AncestorType=Button}}"/>
                                            <Setter Property="FontWeight" Value="{Binding FontWeight,RelativeSource={RelativeSource AncestorType=Button}}"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#D5E3FF"/>
                                    <Setter TargetName="Body" Property="BorderBrush" Value="#C9BDD6"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Body" Property="BorderBrush" Value="#FFE1EE"/>
                                    <Setter TargetName="Body" Property="BorderThickness" Value="3"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="#D0D9E7"/>
                                    <Setter TargetName="Body" Property="Background" Value="#364253"/>
                                    <Setter TargetName="Body" Property="BorderBrush" Value="#8494AE"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="EditorDiscard" TargetType="Button" BasedOn="{StaticResource UxButton}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Foreground" Value="#CAD4E5"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Body" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="13" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}">
                                    <ContentPresenter.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/>
                                            <Setter Property="FontSize" Value="{Binding FontSize,RelativeSource={RelativeSource AncestorType=Button}}"/>
                                            <Setter Property="FontWeight" Value="{Binding FontWeight,RelativeSource={RelativeSource AncestorType=Button}}"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#37313E"/>
                                    <Setter TargetName="Body" Property="BorderBrush" Value="#C9BDD6"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Body" Property="BorderBrush" Value="#FFE1EE"/>
                                    <Setter TargetName="Body" Property="BorderThickness" Value="3"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="#D0D9E7"/>
                                    <Setter TargetName="Body" Property="Background" Value="Transparent"/>
                                    <Setter TargetName="Body" Property="BorderBrush" Value="Transparent"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <DrawingBrush x:Key="EditorDots" TileMode="Tile" Viewport="0,0,18,18" ViewportUnits="Absolute">
                <DrawingBrush.Drawing>
                    <DrawingGroup>
                        <GeometryDrawing Brush="#202530">
                            <GeometryDrawing.Geometry>
                                <RectangleGeometry Rect="0,0,18,18"/>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <GeometryDrawing Brush="#4C5667">
                            <GeometryDrawing.Geometry>
                                <EllipseGeometry Center="9,9" RadiusX="1" RadiusY="1"/>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingGroup>
                </DrawingBrush.Drawing>
            </DrawingBrush>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="RailColumn" Width="78"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Border x:Name="Rail" Background="#191B23" BorderBrush="#40434E" BorderThickness="0,0,1,0" Padding="12,24">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <Image Source="/PhotoBooth.Customer.UI;component/Assets/fox-logo.png" Width="38" Height="38" Margin="0,0,0,42"/>
                    <Button Tag="home" Click="Navigate_Click" ToolTip="Tổng quan" Style="{StaticResource UxSubtle}" Padding="0" Margin="0,0,0,16" MinHeight="50">
                        <Viewbox Width="22" Height="22">
                            <Canvas Width="24" Height="24">
                                <Path Data="M3,10 L12,3 L21,10 L21,21 L3,21Z M9,21 L9,14 L15,14 L15,21" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button Tag="frames" Click="Navigate_Click" ToolTip="Khung ảnh" Style="{StaticResource UxSubtle}" Padding="0" Margin="0,0,0,16" MinHeight="50">
                        <Viewbox Width="22" Height="22">
                            <Canvas Width="24" Height="24">
                                <Path Data="M4,3 L20,3 L20,21 L4,21Z M7,7 L17,7 L17,17 L7,17Z" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button Background="#303C54" Foreground="#D4E3FF" BorderBrush="#96B5E6" ToolTip="Giao diện khách" Padding="0" Margin="0,0,0,16" MinHeight="50">
                        <Viewbox Width="22" Height="22">
                            <Canvas Width="24" Height="24">
                                <Path Data="M3,4 L21,4 L21,17 L3,17Z M8,21 L16,21 M12,17 L12,21" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button Tag="home" Click="Navigate_Click" ToolTip="Máy ảnh" Style="{StaticResource UxSubtle}" Padding="0" MinHeight="50">
                        <Viewbox Width="22" Height="22">
                            <Canvas Width="24" Height="24">
                                <Path Data="M3,7 L7,7 L9,4 L15,4 L17,7 L21,7 L21,20 L3,20Z M16,13 A4,4 0 1 1 15.99,13" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                </StackPanel>
                <Button DockPanel.Dock="Bottom" Content="☰" Click="Menu_Click" ToolTip="Điều hướng và tài khoản" Style="{StaticResource UxSubtle}" Padding="0" VerticalAlignment="Bottom"/>
                <Border/>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1" IsEnabled="{Binding IsReady}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
                <RowDefinition x:Name="FooterRow" Height="88"/>
            </Grid.RowDefinitions>
            <Border BorderBrush="#40434E" BorderThickness="0,0,0,1">
                <Grid x:Name="Header" Margin="30,24,30,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition x:Name="OrientationColumn" Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="Title" LineStackingStrategy="BlockLineHeight" LineHeight="31.36" Text="Giao diện màn hình chờ" FontSize="28" FontWeight="Bold">
                            <TextBlock.RenderTransform>
                                <ScaleTransform ScaleX="0.95"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock x:Name="HeaderSubtitle" LineStackingStrategy="BlockLineHeight" Text="Một lời chào đẹp, theo cách của booth bạn." Foreground="#BCC4D3" FontSize="13" Margin="0,7,0,0"/>
                    </StackPanel>
                    <Border x:Name="Orientations" Grid.Column="1" Background="#222732" BorderBrush="#7C889B" BorderThickness="1" CornerRadius="13" Padding="5" VerticalAlignment="Center">
                        <UniformGrid Columns="2">
                            <RadioButton MinHeight="46" x:Name="LandscapeTab" GroupName="Orientation" Style="{StaticResource OrientationTab}" IsChecked="{Binding IsLandscapeMode,Mode=TwoWay}" Margin="0,0,5,0">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="22" Height="22" Margin="0,0,8,0">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M3,4 L21,4 L21,17 L3,17Z M8,21 L16,21 M12,17 L12,21" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.7"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="Màn hình ngang" FontSize="14" FontWeight="SemiBold" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton MinHeight="46" x:Name="PortraitTab" GroupName="Orientation" Style="{StaticResource OrientationTab}" IsChecked="{Binding IsPortraitMode,Mode=TwoWay}">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="22" Height="22" Margin="0,0,8,0">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M6,2 L18,2 L18,22 L6,22Z M10,18 L14,18" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.7"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="Màn hình dọc" FontSize="14" FontWeight="SemiBold" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                </StackPanel>
                            </RadioButton>
                        </UniformGrid>
                    </Border>
                    <Button x:Name="PortraitMenu" Content="☰" Click="Menu_Click" ToolTip="Điều hướng và tài khoản" Style="{StaticResource UxSubtle}" Visibility="Collapsed" Grid.ColumnSpan="2" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="8" MinHeight="36"/>
                </Grid>
            </Border>
            <Grid x:Name="Workspace" Grid.Row="1" Margin="30,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition x:Name="ToolGap" Width="24"/>
                    <ColumnDefinition x:Name="ToolColumn" Width="340"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition x:Name="ToolRowGap" Height="0"/>
                    <RowDefinition x:Name="ToolRow" Height="0"/>
                </Grid.RowDefinitions>
                <Grid x:Name="PreviewColumn">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid x:Name="PreviewBar" Margin="0,0,0,12">
                        <TextBlock Text="{Binding PreviewOrientationText,StringFormat=Xem trước · {0}}" FontSize="13" Foreground="#B9C4D6"/>
                        <Button x:Name="FullPreviewButton" Content="Xem toàn màn hình ↗" Click="FullScreen_Click" Style="{StaticResource UxSubtle}" FontSize="14" Padding="13,9" MinHeight="44" HorizontalAlignment="Right"/>
                    </Grid>
                    <Border x:Name="PreviewSurface" Grid.Row="1" Background="{StaticResource EditorDots}" BorderBrush="#414856" BorderThickness="1" CornerRadius="17" Padding="20" ClipToBounds="True">
                        <Viewbox x:Name="PreviewBox" Stretch="Uniform">
                            <Canvas x:Name="PreviewCanvas" Width="{Binding PreviewCanvasWidth}" Height="{Binding PreviewCanvasHeight}" Background="#111318" ClipToBounds="True" Cursor="Hand" MouseLeftButtonDown="PreviewCanvas_MouseLeftButtonDown" MouseLeftButtonUp="PreviewCanvas_MouseLeftButtonUp" MouseMove="PreviewCanvas_MouseMove" MouseWheel="PreviewCanvas_MouseWheel">
                                <Image Canvas.Left="{Binding PreviewBackgroundX}" Canvas.Top="{Binding PreviewBackgroundY}" Width="{Binding PreviewBackgroundWidth}" Height="{Binding PreviewBackgroundHeight}" Source="{Binding DefaultBackgroundPath}" Stretch="UniformToFill" IsHitTestVisible="False"/>
                                <Image Canvas.Left="{Binding PreviewBackgroundX}" Canvas.Top="{Binding PreviewBackgroundY}" Width="{Binding PreviewBackgroundWidth}" Height="{Binding PreviewBackgroundHeight}" Source="{Binding SelectedAsset.FilePath}" Stretch="UniformToFill" IsHitTestVisible="False"/>
                                <Grid Width="{Binding PreviewCanvasWidth}" Height="{Binding PreviewCanvasHeight}" IsHitTestVisible="False">
                                    <Grid.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Offset="0.35" Color="#000F0C17"/>
                                            <GradientStop Offset="1" Color="#DC0F0C17"/>
                                        </LinearGradientBrush>
                                    </Grid.Background>
                                    <TextBlock x:Name="StandbyBrand" Text="miu." Margin="64,64,0,0" VerticalAlignment="Top" Foreground="White" FontSize="55" FontWeight="Bold"/>
                                    <StackPanel x:Name="StandbyPrompt" Margin="72,0,72,100" VerticalAlignment="Bottom">
                                        <TextBlock x:Name="StandbyTitle" Text="Sẵn sàng lưu lại&#10;khoảnh khắc?" FontSize="52" Foreground="White" FontWeight="SemiBold" TextAlignment="Center" Margin="0,0,0,50"/>
                                    </StackPanel>
                                </Grid>
                                <Border Canvas.Left="{Binding PreviewLiveViewX}" Canvas.Top="{Binding PreviewLiveViewY}" Width="{Binding PreviewLiveViewWidth}" Height="{Binding PreviewLiveViewHeight}" CornerRadius="6" BorderThickness="2" BorderBrush="#D789AD" Background="#55000000" Visibility="{Binding ShowLiveView,Converter={StaticResource BoolVisibility}}" IsHitTestVisible="False">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="↑" Foreground="White" FontSize="48" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                            <TextBlock.RenderTransform>
                                                <RotateTransform Angle="{Binding ImageRotation}"/>
                                            </TextBlock.RenderTransform>
                                        </TextBlock>
                                        <TextBlock Text="LIVE VIEW" Foreground="White" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding ImageRotation,StringFormat=Xoay {0}°}" Foreground="#D8D5DC" FontSize="15" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <TextBlock x:Name="PreviewHint" Grid.Row="2" Text="Màn hình khách tự chọn giao diện phù hợp khi xoay màn hình." Foreground="#B9C4D6" FontSize="12" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                </Grid>
                <Border x:Name="Tools" Grid.Column="2" Background="#1C2029" BorderBrush="#4F5867" BorderThickness="1" CornerRadius="17">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="EditorTabsRow" Height="67"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Border BorderBrush="#4F5867" BorderThickness="0,0,0,1" Padding="8">
                            <UniformGrid Columns="3">
                                <RadioButton Content="Ảnh nền" Tag="background" GroupName="EditorTools" IsChecked="True" Checked="Tool_Checked" Style="{StaticResource EditorToolTab}" FontSize="{Binding Tag,RelativeSource={RelativeSource AncestorType=UserControl}}" Padding="4,10"/>
                                <RadioButton Content="Live View" Tag="live" GroupName="EditorTools" Checked="Tool_Checked" Style="{StaticResource EditorToolTab}" FontSize="{Binding Tag,RelativeSource={RelativeSource AncestorType=UserControl}}" Padding="4,10"/>
                                <RadioButton Content="Căn chỉnh" Tag="adjust" GroupName="EditorTools" Checked="Tool_Checked" Style="{StaticResource EditorToolTab}" FontSize="{Binding Tag,RelativeSource={RelativeSource AncestorType=UserControl}}" Padding="4,10"/>
                            </UniformGrid>
                        </Border>
                        <Grid Grid.Row="1" x:Name="ToolContent" Margin="20">
                            <Grid x:Name="BackgroundPanel">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="BackgroundHeading" Text="{Binding BackgroundTitle}" FontSize="17" FontWeight="Bold" Margin="0,0,0,16"/>
                                <ListBox ScrollViewer.PanningMode="VerticalOnly" x:Name="AssetList" ScrollViewer.VerticalScrollBarVisibility="Hidden" Grid.Row="1" ItemsSource="{Binding BackgroundChoices}" SelectedItem="{Binding SelectedBackground}">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <StackPanel x:Name="ImageChoice">
                                                    <controls:BackgroundThumbnail SourcePath="{Binding FilePath}" Height="{Binding Tag,RelativeSource={RelativeSource AncestorType=ListBox}}" PositionY="{Binding BackgroundCropAnchor,RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12" Margin="0,9,0,4"/>
                                                </StackPanel>
                                                <TextBlock x:Name="UploadChoice" Text="{Binding Name}" TextWrapping="Wrap" TextAlignment="Center" Foreground="#E3ECFC" FontSize="{Binding FontSize,RelativeSource={RelativeSource AncestorType=UserControl}}" FontWeight="SemiBold" Visibility="Collapsed" Margin="8" VerticalAlignment="Center"/>
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding FilePath}" Value="{x:Null}">
                                                    <Setter TargetName="ImageChoice" Property="Visibility" Value="Collapsed"/>
                                                    <Setter TargetName="UploadChoice" Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                            <ScrollViewer PanningMode="VerticalOnly" x:Name="LivePanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <TextBlock x:Name="LiveHeading" Text="Live View màn hình chờ" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,16"/>
                                    <CheckBox Content="Hiển thị Live View" Foreground="#E6EDF7" IsChecked="{Binding ShowLiveView}" FontSize="14" MinHeight="36"/>
                                    <TextBlock Text="{Binding LiveViewAreaText}" Foreground="#C4CDDD" FontSize="14" Margin="0,12,0,5"/>
                                    <Slider Minimum="5" Maximum="40" Value="{Binding LiveViewAreaPercent,Mode=TwoWay}"/>
                                    <TextBlock x:Name="LivePositionLabel" Text="Vị trí" FontSize="14" Margin="0,12,0,5"/>
                                    <UniformGrid Columns="5">
                                        <Button Content="←" Tag="live-left" Click="Move_Click" Padding="0"/>
                                        <Button Content="↑" Tag="live-up" Click="Move_Click" Padding="0"/>
                                        <Button Content="◎" Tag="live-center" Click="Move_Click" Padding="0"/>
                                        <Button Content="↓" Tag="live-down" Click="Move_Click" Padding="0"/>
                                        <Button Content="→" Tag="live-right" Click="Move_Click" Padding="0"/>
                                    </UniformGrid>
                                    <TextBlock x:Name="LiveHint" Text="Kéo khung trong bản xem trước để đổi vị trí." FontSize="13" Foreground="#C4CDDD" TextWrapping="Wrap" Margin="0,18,0,0"/>
                                </StackPanel>
                            </ScrollViewer>
                            <ScrollViewer PanningMode="VerticalOnly" x:Name="AdjustPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <TextBlock Text="Căn chỉnh ảnh nền" FontSize="17" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding BackgroundZoomText,StringFormat=Phóng ảnh · {0}}" FontSize="14" Margin="0,18,0,8"/>
                                    <Slider Minimum="100" Maximum="300" Value="{Binding BackgroundZoom}"/>
                                    <UniformGrid Columns="5" Margin="0,18">
                                        <Button Content="←" Tag="bg-left" Click="Move_Click" Padding="0"/>
                                        <Button Content="↑" Tag="bg-up" Click="Move_Click" Padding="0"/>
                                        <Button Content="◎" Tag="bg-center" Click="Move_Click" Padding="0"/>
                                        <Button Content="↓" Tag="bg-down" Click="Move_Click" Padding="0"/>
                                        <Button Content="→" Tag="bg-right" Click="Move_Click" Padding="0"/>
                                    </UniformGrid>
                                    <Button Content="Đặt lại bố cục" Command="{Binding ResetLiveViewCommand}" FontSize="14"/>
                                    <TextBlock x:Name="AdjustHint" Text="Kéo ảnh để căn vị trí. Phóng ảnh để mở rộng vùng di chuyển." FontSize="13" Foreground="#C4CDDD" TextWrapping="Wrap" Margin="0,18,0,0"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
            <Border Grid.Row="2" Background="#1C2029" BorderBrush="#4F5867" BorderThickness="0,1,0,0">
                <Grid x:Name="Footer" Margin="30,17">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="StatusLabel" Text="{Binding SaveStatus,StringFormat=●  {0}}" FontSize="14">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#C4CDDD"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasChanges}" Value="True">
                                            <Setter Property="Foreground" Value="#FFE0A7"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding Message}" Foreground="#FFE0A7" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="DiscardButton" Style="{StaticResource EditorDiscard}" Content="Hủy thay đổi" Command="{Binding DiscardCommand}" FontSize="14" Margin="0,0,10,0"/>
                        <Button x:Name="SaveButton" Content="{Binding SaveLabel}" Command="{Binding SaveLiveViewCommand}" Style="{StaticResource EditorSave}"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Row="1" VerticalAlignment="Bottom" Background="#412631" BorderBrush="#FFBECD" BorderThickness="1" CornerRadius="12" Padding="16" Margin="24" Visibility="{Binding HasError,Converter={StaticResource UxVisible}}">
                <TextBlock Text="{Binding Message}" Foreground="#FFBECD" TextWrapping="Wrap"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
