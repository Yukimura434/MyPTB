<UserControl x:Class="PhotoBooth.Admin.UI.Views.EventFramePickerView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource BackgroundBrush}">
 <Grid Margin="28,24,28,28">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Chọn frame cho event" FontSize="28" FontWeight="Bold"/><TextBlock Text="Chọn từng thumbnail hoặc thêm toàn bộ frame trong nhóm đã phân loại ở tab Frames." Foreground="#A9AAB1" FontFamily="Segoe UI" Margin="0,5,0,0"/></StackPanel><Border Grid.Column="1" Background="#263D64" CornerRadius="15" Padding="12,6" VerticalAlignment="Center"><TextBlock Text="{Binding SelectionSummary}" Foreground="#BDD4FF"/></Border></Grid>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="{StaticResource CardBrush}" CornerRadius="12"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Margin="17,16,17,12"><TextBlock Text="Nhóm frame" FontSize="17" FontWeight="Bold"/><TextBlock Text="Phân loại từ tab Frames" Foreground="#8F9098" FontFamily="Segoe UI" FontSize="12" Margin="0,3,0,0"/></StackPanel><ListBox Grid.Row="1" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" Margin="9,0"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,5"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Box" Background="#252529" CornerRadius="8" Padding="12,10" BorderBrush="Transparent" BorderThickness="1"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Background" Value="#34343A"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Box" Property="Background" Value="#263D64"/><Setter TargetName="Box" Property="BorderBrush" Value="#4F8CFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/><Border Grid.Column="1" Background="#35353B" CornerRadius="10" Padding="7,2" Margin="8,0,0,0"><TextBlock Text="{Binding FrameCount}" Foreground="#C6C7CE" FontSize="10"/></Border></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><Button Grid.Row="2" Content="+ Thêm tất cả trong nhóm" Command="{Binding AddAllCategoryCommand}" Margin="13" Background="#365FAD"/></Grid></Border>
   <Border Grid.Column="2" Background="{StaticResource CardBrush}" CornerRadius="12"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBox Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" Margin="16,14,16,10" ToolTip="Tìm frame theo tên"/><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="10,0,4,10"><ItemsControl ItemsSource="{Binding VisibleFrames}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Command="{Binding DataContext.ToggleCommand,RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Width="220" Height="180" Padding="0" Margin="6" Background="Transparent"><Button.Template><ControlTemplate TargetType="Button"><Border x:Name="FrameBorder" Background="#18181B" BorderBrush="#44444B" BorderThickness="2" CornerRadius="10" ClipToBounds="True"><Grid><Image Source="{Binding Frame.ThumbnailPath}" Stretch="Uniform" Margin="8"/><Border x:Name="SelectedBadge" Visibility="Collapsed" Background="#E64F8CFF" CornerRadius="13" Width="28" Height="28" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"><TextBlock Text="✓" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/></Border></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="FrameBorder" Property="BorderBrush" Value="#759FFF"/></Trigger><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter TargetName="FrameBorder" Property="BorderBrush" Value="#4F8CFF"/><Setter TargetName="FrameBorder" Property="Background" Value="#243452"/><Setter TargetName="SelectedBadge" Property="Visibility" Value="Visible"/></DataTrigger></ControlTemplate.Triggers></ControlTemplate></Button.Template></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Grid></Border>
  </Grid>
  <Grid Grid.Row="2" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Background="#3A321F" BorderBrush="#6A582B" BorderThickness="1" CornerRadius="7" Padding="11,9" Visibility="{Binding HasMessage,Converter={StaticResource BoolVisibility}}"><TextBlock Text="{Binding Message}" Foreground="#FFD98A" TextWrapping="Wrap"/></Border><WrapPanel Grid.Column="1"><Button Content="Hủy" Command="{Binding CancelCommand}" Background="#45454B" MinWidth="100"/><Button Content="Dùng các frame đã chọn" Command="{Binding ApplyCommand}" Background="#267454" MinWidth="190"/></WrapPanel></Grid>
 </Grid>
</UserControl>
