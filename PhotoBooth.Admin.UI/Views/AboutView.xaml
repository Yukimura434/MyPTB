<UserControl x:Class="PhotoBooth.Admin.UI.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="About" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Thông tin phiên bản ứng dụng"
                       Foreground="#A8A8AE"
                       Margin="0,4,0,24" />

            <Border Style="{StaticResource Card}" Padding="28">
                <StackPanel>
                    <TextBlock Text="{Binding ProductName}"
                               FontSize="28"
                               FontWeight="SemiBold"
                               Foreground="White" />
                    <TextBlock Text="Phiên bản hiện tại"
                               Foreground="#A8A8AE"
                               Margin="0,22,0,4" />
                    <TextBlock Text="{Binding Version}"
                               FontFamily="Consolas"
                               FontSize="22"
                               Foreground="{StaticResource AccentBrush}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="28" Margin="8,16,8,8">
                <StackPanel>
                    <TextBlock Text="What's New" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Nội dung cập nhật sẽ được hiển thị tại đây trong các phiên bản sau."
                               Foreground="#A8A8AE"
                               TextWrapping="Wrap"
                               Margin="0,10,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
