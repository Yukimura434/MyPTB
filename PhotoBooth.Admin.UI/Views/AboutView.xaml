<UserControl x:Class="PhotoBooth.Admin.UI.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">
    <UserControl.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="BorderBrush" Value="#8DA5C7" />
            <Setter Property="MinHeight" Value="44" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="820" HorizontalAlignment="Stretch">
            <TextBlock Text="Giới thiệu" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Thông tin phiên bản ứng dụng"
                       Foreground="#A8A8AE"
                       Margin="0,4,0,24" />

            <Border Style="{StaticResource Card}" Padding="28">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Source="../Assets/fox-logo.png"
                           Width="64" Height="64" Margin="0,0,20,0"
                           VerticalAlignment="Top" SnapsToDevicePixels="True" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ProductName}"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="White" />
                        <TextBlock Text="Phiên bản hiện tại"
                                   Foreground="#A8A8AE"
                                   Margin="0,22,0,4" />
                        <TextBlock Text="{Binding Version}"
                                   FontFamily="Consolas"
                                   FontSize="22"
                                   Foreground="#B8D1FF" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Padding="28" Margin="8,16,8,8">
                <StackPanel>
                    <TextBlock Text="Cập nhật ứng dụng" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{Binding Status}" Foreground="#CFD8E6" TextWrapping="Wrap" Margin="0,12,0,18" />
                    <WrapPanel>
                        <Button Content="Kiểm tra bản cập nhật" Command="{Binding CheckCommand}" Padding="16,12" Margin="0,0,10,10" />
                        <Button Content="Tải bản cập nhật" Command="{Binding DownloadCommand}" Padding="16,12" Margin="0,0,10,10">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasUpdate}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style>
                        </Button>
                        <Button Content="Cài đặt và đóng ứng dụng" Command="{Binding InstallCommand}" Padding="16,12" Margin="0,0,0,10">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsReadyToInstall}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style>
                        </Button>
                    </WrapPanel>
                    <TextBlock Text="Phiên bản 3.0.0: giao diện ngang và dọc, upload nền, đăng nhập theo phiên và cập nhật thủ công."
                               Foreground="#A8A8AE"
                               TextWrapping="Wrap"
                               Margin="0,10,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
