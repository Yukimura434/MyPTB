<Window x:Class="PhotoBooth.Admin.UI.Views.CollectionManagerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Quản lý bộ sưu tập" Width="540" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/MiuPhotoBooth;component/Themes/LibraryStyles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="24" IsEnabled="{Binding IsLibraryReady}">
 <DockPanel><Button DockPanel.Dock="Right" Content="Đóng" IsCancel="True" Style="{StaticResource LibrarySecondary}"/><TextBlock Text="Quản lý bộ sưu tập" FontSize="22" FontWeight="SemiBold"/></DockPanel>
 <TextBlock Text="Tạo bộ sưu tập" FontWeight="SemiBold" Margin="0,22,0,8"/><DockPanel><Button Content="Tạo" DockPanel.Dock="Right" Command="{Binding CreateEventCommand}" Margin="8,0,0,0"/><TextBox x:Name="NewNameBox" Text="{Binding NewEventName,UpdateSourceTrigger=PropertyChanged}" Margin="0" MaxLength="80" AutomationProperties.Name="Tên bộ sưu tập mới"/></DockPanel>
 <Border BorderBrush="#8196B2" BorderThickness="0,1,0,0" Margin="0,20,0,0" Padding="0,18,0,0"><StackPanel><TextBlock Text="Bộ sưu tập" FontWeight="SemiBold" Margin="0,0,0,8"/><ComboBox ItemsSource="{Binding Collections}" SelectedItem="{Binding SelectedEvent}" ItemTemplate="{StaticResource CollectionName}" Margin="0" AutomationProperties.Name="Bộ sưu tập cần quản lý"/>
 <TextBlock Text="Tên bộ sưu tập" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding EditEventName,UpdateSourceTrigger=PropertyChanged}" MaxLength="80" IsEnabled="{Binding CanManageSelectedEvent}" Margin="0,0,0,10" AutomationProperties.Name="Tên bộ sưu tập"/><WrapPanel><Button Content="Đổi tên" Command="{Binding RenameEventCommand}" Style="{StaticResource LibrarySecondary}" Margin="0,0,8,0"/><Button Content="Xóa bộ sưu tập" Command="{Binding DeleteEventCommand}" Style="{StaticResource LibraryDanger}"/></WrapPanel>
 <Border Background="#1D2C43" BorderBrush="#8196B2" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,20,0,0"><StackPanel><TextBlock Text="{Binding CollectionSummary}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="Thay thế toàn bộ danh sách đang dùng bằng các mục trong bộ sưu tập này. Bộ sưu tập trống sẽ bỏ chọn tất cả." Foreground="#C4D2E8" TextWrapping="Wrap" Margin="0,8,0,14"/><Button Content="Sử dụng bộ sưu tập" Command="{Binding UseCollectionCommand}" Margin="0"/></StackPanel></Border>
 </StackPanel></Border>
 <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="#DCE8FB" Margin="0,14,0,0" Visibility="{Binding HasMessage,Converter={StaticResource BoolVisibility}}"/>
 </StackPanel></ScrollViewer>
</Window>