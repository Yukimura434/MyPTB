<UserControl x:Class="PhotoBooth.Admin.UI.Views.ShareSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Language="vi-VN"
             Background="{StaticResource BackgroundBrush}">
    <UserControl.Resources>
        <Style x:Key="ShareChoice" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ChoiceBorder" Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Width="18" Height="18" VerticalAlignment="Top" Margin="0,2,0,0">
                                    <Ellipse Stroke="#9DA6B5" StrokeThickness="2"/>
                                    <Ellipse x:Name="ChoiceDot" Width="8" Height="8" Fill="{StaticResource AccentBrush}" Visibility="Collapsed"/>
                                </Grid>
                                <ContentPresenter Grid.Column="1" Margin="8,0,0,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ChoiceBorder" Property="Background" Value="{StaticResource AccentSubtleBrush}"/>
                                <Setter TargetName="ChoiceBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="ChoiceDot" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChoiceBorder" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ChoiceBorder" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}"/>
                                <Setter TargetName="ChoiceBorder" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="ChoiceBorder" Property="Padding" Value="13"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ChoiceBorder" Property="Opacity" Value="0.76"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,24,28,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Width="44" Height="44" CornerRadius="10" Background="{StaticResource AccentSubtleBrush}" Margin="0,0,14,0">
                <Path Data="{DynamicResource Icon.Share}" Style="{StaticResource VectorIcon}" Width="22" Height="22" Stroke="{StaticResource AccentHoverBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Kênh chia sẻ" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Chọn cách khách nhận ảnh và nơi lưu bản chia sẻ trực tuyến." Style="{StaticResource PageSubtitle}"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource AccentSubtleBrush}" BorderBrush="#43659B" BorderThickness="1"
                CornerRadius="9" Padding="12" Margin="0,18,0,4">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Path Data="{DynamicResource Icon.Check}" Style="{StaticResource VectorIcon}" Width="18" Height="18" Stroke="#BBD2FF" Margin="0,1,10,0"/>
                <TextBlock Grid.Column="1" Text="Thiết lập được lưu tự động và chỉ áp dụng cho các lượt chụp mới."
                           Foreground="#D9E5FF" TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,10,0,0">
            <Grid x:Name="SettingsGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="DeliveryColumn" Width="*"/>
                    <ColumnDefinition x:Name="ColumnGap" Width="16"/>
                    <ColumnDefinition x:Name="StorageColumn" Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition x:Name="RowGap" Height="0"/>
                    <RowDefinition x:Name="StorageRow" Height="0"/>
                </Grid.RowDefinitions>

                <Border x:Name="DeliveryCard" Style="{StaticResource Card}" Margin="0" Padding="22">
                    <StackPanel>
                        <TextBlock Text="Cách khách nhận ảnh" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Chọn một phương thức dùng cho các lượt chụp tiếp theo."
                                   Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,-4,0,16"/>

                        <RadioButton GroupName="DeliveryMode" IsChecked="{Binding IsCloudOnly}" Style="{StaticResource ShareChoice}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Trực tuyến bằng mã QR" FontWeight="SemiBold" FontSize="15"/>
                                    <Border Background="#275F49" CornerRadius="10" Padding="8,2" Margin="10,-1,0,0">
                                        <TextBlock Text="KHUYÊN DÙNG" Foreground="#C6F6DE" FontWeight="SemiBold" FontSize="10"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Khách quét mã QR để xem và tải ảnh qua Internet."
                                           Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton GroupName="DeliveryMode" IsChecked="{Binding IsLanOnly}" Style="{StaticResource ShareChoice}">
                            <StackPanel>
                                <TextBlock Text="Chỉ dùng mạng nội bộ" FontWeight="SemiBold" FontSize="15"/>
                                <TextBlock Text="Phù hợp khi địa điểm không có Internet; hai thiết bị cần dùng chung mạng."
                                           Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton GroupName="DeliveryMode" IsChecked="{Binding IsCloudWithLanFallback}" Style="{StaticResource ShareChoice}">
                            <StackPanel>
                                <TextBlock Text="Tự động dự phòng bằng mạng nội bộ" FontWeight="SemiBold" FontSize="15"/>
                                <TextBlock Text="Ưu tiên trực tuyến và chuyển sang kết nối tại chỗ khi cần."
                                           Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                            </StackPanel>
                        </RadioButton>

                        <Border Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="9" Padding="13" Margin="0,6,0,0">
                            <StackPanel>
                                <TextBlock Text="Mạng nội bộ" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,5,0,10"/>
                                <Button Command="{Binding StartServerCommand}" IsEnabled="{Binding LocalShareEnabled}" Style="{StaticResource AdminSecondaryButton}" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{DynamicResource Icon.Share}" Style="{StaticResource ButtonVectorIcon}" Width="16" Height="16" Margin="0,0,8,0"/>
                                        <TextBlock Text="Bật chia sẻ trong mạng nội bộ"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border x:Name="StorageCard" Grid.Column="2" Style="{StaticResource Card}" Margin="0" Padding="22">
                    <StackPanel>
                        <TextBlock Text="Nơi lưu ảnh trực tuyến" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Nơi lưu được chốt khi bắt đầu mỗi lượt chụp; ảnh của một lượt luôn ở cùng một nơi."
                                   Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,-4,0,16"/>

                        <RadioButton GroupName="OnlineStorage" IsChecked="{Binding IsSystemLibrary}" Style="{StaticResource ShareChoice}">
                            <StackPanel>
                                <TextBlock Text="Thư viện MiuPhotoBooth" FontWeight="SemiBold" FontSize="15"/>
                                <TextBlock Text="Mã QR mở album ảnh do MiuPhotoBooth cung cấp."
                                           Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton GroupName="OnlineStorage" IsChecked="{Binding IsGoogleDrive}" IsEnabled="{Binding CanSelectGoogleDrive}" Style="{StaticResource ShareChoice}">
                            <StackPanel>
                                <TextBlock Text="Google Drive của khách hàng" FontWeight="SemiBold" FontSize="15"/>
                                <TextBlock Text="Mỗi lượt chụp có một thư mục riêng; mã QR mở đúng thư mục đó."
                                           Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                <TextBlock Text="{Binding GoogleDriveEmail,StringFormat=Tài khoản: {0}}" Foreground="{StaticResource AccentHoverBrush}"
                                           TextWrapping="Wrap" Margin="0,5,0,0"
                                           Visibility="{Binding GoogleDriveConnected,Converter={StaticResource BoolVisibility}}"/>
                            </StackPanel>
                        </RadioButton>

                        <Border Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                                CornerRadius="9" Padding="13" Margin="0,6,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,14,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="#9DA6B5"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding GoogleDriveConnected}" Value="True">
                                                            <Setter Property="Fill" Value="#61D49B"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding GoogleDriveStateText}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <TextBlock Text="Kết nối và ngắt kết nối do chủ tài khoản quản lý trên Web Customer."
                                               Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Kiểm tra kết nối" Command="{Binding RefreshStorageCommand}"
                                        Style="{StaticResource AdminSecondaryButton}" MinWidth="150" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Border Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="9" Padding="13" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="Trạng thái kết nối" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding OnlineStorageStatusText}" Foreground="{StaticResource AccentHoverBrush}" TextWrapping="Wrap" Margin="0,5,0,0" LineHeight="19"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource AccentSubtleBrush}" BorderBrush="#43659B" BorderThickness="1"
                                CornerRadius="9" Padding="13" Margin="0,12,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Path Data="{DynamicResource Icon.Share}" Style="{StaticResource VectorIcon}" Width="20" Height="20" Stroke="#BBD2FF" Margin="0,1,11,0"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Tải ảnh tự động" FontWeight="SemiBold"/>
                                    <TextBlock Text="Nếu mất mạng, ảnh gốc vẫn an toàn trên máy và ứng dụng sẽ tự tiếp tục khi kết nối ổn định."
                                               Foreground="#D9E5FF" TextWrapping="Wrap" Margin="0,5,0,0" LineHeight="19"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
