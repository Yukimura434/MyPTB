<UserControl x:Class="PhotoBooth.Admin.UI.Views.BeautyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="28,24,28,32" MaxWidth="1120" HorizontalAlignment="Left">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Margin="4,0,4,18">
                <TextBlock Text="Làm đẹp" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Điều chỉnh retouch cho ảnh chụp và Live View. Ảnh luôn được xử lý Beauty trước preset màu." Style="{StaticResource PageSubtitle}" TextWrapping="Wrap"/>
            </StackPanel>
            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="14,11" Margin="0,0,0,18">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <CheckBox Content="Bật làm đẹp cho ảnh chụp và Live View" IsChecked="{Binding Enabled}" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="{Binding RuntimeStatus}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" MaxWidth="360"/>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1" IsEnabled="{Binding IsEditorEnabled}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18">
                            <StackPanel>
                                <TextBlock Text="Da &amp; độ nét" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Làm mịn da" Style="{StaticResource FieldLabel}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions><Slider Minimum="0" Maximum="100" Value="{Binding SmoothSkin}"/><TextBlock Grid.Column="1" Text="{Binding SmoothSkin}" HorizontalAlignment="Right"/></Grid>
                                <TextBlock Text="Làm sáng da" Style="{StaticResource FieldLabel}" Margin="4,14,4,3"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions><Slider Minimum="0" Maximum="100" Value="{Binding BrightenSkin}"/><TextBlock Grid.Column="1" Text="{Binding BrightenSkin}" HorizontalAlignment="Right"/></Grid>
                                <TextBlock Text="Tông da" Style="{StaticResource FieldLabel}" Margin="4,14,4,3"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions><Slider Minimum="0" Maximum="100" Value="{Binding SkinTone}"/><TextBlock Grid.Column="1" Text="{Binding SkinTone}" HorizontalAlignment="Right"/></Grid>
                                <TextBlock Text="Độ nét" Style="{StaticResource FieldLabel}" Margin="4,14,4,3"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions><Slider Minimum="0" Maximum="100" Value="{Binding Sharpen}"/><TextBlock Grid.Column="1" Text="{Binding Sharpen}" HorizontalAlignment="Right"/></Grid>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18">
                            <StackPanel>
                                <TextBlock Text="Hình dáng khuôn mặt" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Kích thước mắt" Style="{StaticResource FieldLabel}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions><Slider Minimum="0" Maximum="100" Value="{Binding EyeSize}"/><TextBlock Grid.Column="1" Text="{Binding EyeSize}" HorizontalAlignment="Right"/></Grid>
                                <TextBlock Text="Thon gọn khuôn mặt" Style="{StaticResource FieldLabel}" Margin="4,14,4,3"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions><Slider Minimum="0" Maximum="100" Value="{Binding SlimFace}"/><TextBlock Grid.Column="1" Text="{Binding SlimFace}" HorizontalAlignment="Right"/></Grid>
                                <Border Background="{StaticResource AccentSubtleBrush}" BorderBrush="#36558A" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,22,0,0"><TextBlock Text="Các thay đổi hình học chỉ tác động vùng khuôn mặt được nhận diện và không thay đổi kích thước ảnh." Foreground="#C7D8FA" FontSize="12" TextWrapping="Wrap"/></Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Grid Grid.Row="2" Margin="0,18,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border Background="{StaticResource WarningSubtleBrush}" BorderBrush="#72562B" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,0,14,0"><TextBlock Text="{Binding Message}" Foreground="#FFD79B" TextWrapping="Wrap"/></Border>
                        <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Tải lại" Command="{Binding ReloadCommand}" Style="{StaticResource AdminSecondaryButton}"/><Button Content="Tắt và đặt lại" Command="{Binding ResetCommand}" Style="{StaticResource AdminDangerButton}"/><Button Content="Lưu và áp dụng" Command="{Binding SaveCommand}" Style="{StaticResource AdminSuccessButton}" IsEnabled="{Binding HasUnsavedChanges}"/></StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
