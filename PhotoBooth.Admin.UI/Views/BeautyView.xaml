<UserControl x:Class="PhotoBooth.Admin.UI.Views.BeautyView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="24" MaxWidth="900" HorizontalAlignment="Left"><StackPanel>
  <TextBlock Text="Beauty" Style="{StaticResource PageTitle}"/>
  <TextBlock Text="Điều chỉnh retouch khuôn mặt cho ảnh chụp. Ảnh được xử lý trước LUT; video vẫn giữ nguyên." Foreground="#A7A7AD" TextWrapping="Wrap" Margin="0,4,0,18"/>
  <Border Style="{StaticResource Card}"><StackPanel>
   <CheckBox Content="Bật Beauty cho ảnh chụp" IsChecked="{Binding Enabled}" FontSize="16" Margin="4,4,4,18"/>
   <Grid Margin="4,8"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="55"/></Grid.ColumnDefinitions><TextBlock Text="Smooth Skin" VerticalAlignment="Center"/><Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding SmoothSkin}"/><TextBlock Grid.Column="2" Text="{Binding SmoothSkin}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
   <Grid Margin="4,8"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="55"/></Grid.ColumnDefinitions><TextBlock Text="Brighten Skin" VerticalAlignment="Center"/><Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding BrightenSkin}"/><TextBlock Grid.Column="2" Text="{Binding BrightenSkin}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
   <Grid Margin="4,8"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="55"/></Grid.ColumnDefinitions><TextBlock Text="Skin Tone" VerticalAlignment="Center"/><Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding SkinTone}"/><TextBlock Grid.Column="2" Text="{Binding SkinTone}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
   <Grid Margin="4,8"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="55"/></Grid.ColumnDefinitions><TextBlock Text="Sharpen" VerticalAlignment="Center"/><Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Sharpen}"/><TextBlock Grid.Column="2" Text="{Binding Sharpen}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
   <TextBlock Text="Face shape" FontSize="16" FontWeight="SemiBold" Margin="4,20,4,6"/>
   <Grid Margin="4,8"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="55"/></Grid.ColumnDefinitions><TextBlock Text="Eye Size" VerticalAlignment="Center"/><Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding EyeSize}"/><TextBlock Grid.Column="2" Text="{Binding EyeSize}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
   <Grid Margin="4,8"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="55"/></Grid.ColumnDefinitions><TextBlock Text="Slim Face" VerticalAlignment="Center"/><Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding SlimFace}"/><TextBlock Grid.Column="2" Text="{Binding SlimFace}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
   <TextBlock Text="{Binding RuntimeStatus}" Foreground="#8CC8FF" Margin="4,16,4,4"/><TextBlock Text="{Binding Message}" Foreground="#FFB74D" Margin="4"/>
   <WrapPanel Margin="0,12,0,0"><Button Content="Lưu" Command="{Binding SaveCommand}" Background="#4CAF50"/><Button Content="Tải lại" Command="{Binding ReloadCommand}"/><Button Content="Tắt và đặt lại" Command="{Binding ResetCommand}"/></WrapPanel>
  </StackPanel></Border>
 </StackPanel></Grid></ScrollViewer>
</UserControl>
