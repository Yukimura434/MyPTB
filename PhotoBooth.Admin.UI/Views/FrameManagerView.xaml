<UserControl x:Class="PhotoBooth.Admin.UI.Views.FrameManagerView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/MiuPhotoBooth;component/Themes/LibraryStyles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <Grid Margin="24,22,24,18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <DockPanel Margin="0,0,0,18"><Button DockPanel.Dock="Right" Content="+ Nhập khung ảnh" Command="{Binding ImportCommand}" Margin="12,0,0,0" VerticalAlignment="Center"/><StackPanel><TextBlock Text="Khung ảnh" Style="{StaticResource PageTitle}"/><TextBlock Text="Chọn từng mục hoặc sử dụng một bộ sưu tập tại booth." Style="{StaticResource PageSubtitle}" TextWrapping="Wrap"/></StackPanel></DockPanel>

 <DockPanel Grid.Row="2" Margin="0,0,0,14"><Button x:Name="ManageCollectionsButton" DockPanel.Dock="Right" Content="Quản lý bộ sưu tập" Click="ManageCollections_Click" Style="{StaticResource LibrarySecondary}" Visibility="{Binding ShowCollections,Converter={StaticResource BoolVisibility}}" IsEnabled="{Binding IsLibraryReady}"/><WrapPanel>
 <Button Content="Tất cả khung ảnh" Command="{Binding SetLibraryTabCommand}" CommandParameter="Tất cả"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource LibrarySecondary}"><Setter Property="Margin" Value="0,0,8,0"/><Style.Triggers><DataTrigger Binding="{Binding LibraryTab}" Value="Tất cả"><Setter Property="Background" Value="#263D64"/><Setter Property="BorderBrush" Value="#B5CEFF"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Content="Đang sử dụng" Command="{Binding SetLibraryTabCommand}" CommandParameter="Đang sử dụng"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource LibrarySecondary}"><Setter Property="Margin" Value="0,0,8,0"/><Style.Triggers><DataTrigger Binding="{Binding LibraryTab}" Value="Đang sử dụng"><Setter Property="Background" Value="#263D64"/><Setter Property="BorderBrush" Value="#B5CEFF"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
 <Button x:Name="CollectionsButton" Content="Bộ sưu tập  ▾" Click="Collections_Click"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource LibrarySecondary}"><Style.Triggers><DataTrigger Binding="{Binding ShowCollections}" Value="True"><Setter Property="Background" Value="#263D64"/><Setter Property="BorderBrush" Value="#B5CEFF"/></DataTrigger></Style.Triggers></Style></Button.Style>
 <Button.ContextMenu><ContextMenu Style="{StaticResource LibraryMenu}" DataContext="{Binding PlacementTarget.DataContext,RelativeSource={RelativeSource Self}}" ItemsSource="{Binding Collections}" Background="#1B2432" BorderBrush="#8196B2" BorderThickness="1" MinWidth="230"><ContextMenu.ItemContainerStyle><Style TargetType="MenuItem" BasedOn="{StaticResource LibraryMenuItem}"><Setter Property="Header" Value="{Binding Name}"/><Setter Property="Command" Value="{Binding DataContext.SelectCollectionCommand,RelativeSource={RelativeSource AncestorType=ContextMenu}}"/><Setter Property="CommandParameter" Value="{Binding}"/></Style></ContextMenu.ItemContainerStyle></ContextMenu></Button.ContextMenu></Button>
 <TextBlock Text="{Binding EffectiveSummary}" Foreground="#BDD4FF" Margin="16,0,8,0"/></WrapPanel></DockPanel>
 <Border Grid.Row="3" Background="#263D64" BorderBrush="#8196B2" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12" Visibility="{Binding HasMessage,Converter={StaticResource BoolVisibility}}"><TextBlock Text="{Binding Message}" TextWrapping="Wrap"/></Border>
 <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition x:Name="DetailColumn" Style="{StaticResource LibraryDetailColumn}"/></Grid.ColumnDefinitions>
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,12,14"><TextBlock Text="{Binding FrameSummary}" DockPanel.Dock="Right" Foreground="#C4D2E8" FontSize="12"/><TextBlock Text="{Binding LibraryHeading}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></DockPanel>
 <ListBox x:Name="AssetList" Grid.Row="1" ItemsSource="{Binding VisibleFrames}" SelectedItem="{Binding SelectedFrame}"  Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="False">
 <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource LibraryItem}">
 <Setter Property="Width" Value="{Binding FrameCardWidth,RelativeSource={RelativeSource AncestorType=UserControl}}"/>
 <Setter Property="Height" Value="{Binding FrameCardHeight,RelativeSource={RelativeSource AncestorType=UserControl}}"/>
 <Setter Property="VerticalContentAlignment" Value="Stretch"/>
 </Style></ListBox.ItemContainerStyle>
 <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
 <ListBox.ItemTemplate><DataTemplate><Border><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <Button Command="{Binding DataContext.EditSlotOrderCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Width="{Binding FrameThumbnailWidth,RelativeSource={RelativeSource AncestorType=UserControl}}" HorizontalAlignment="Center" Background="#111722" BorderBrush="#8196B2" Padding="6" Margin="0" ToolTip="Đánh số thứ tự ô ảnh"><Image Source="{Binding ThumbnailPath}" Stretch="Uniform"/></Button>
 <Button Style="{StaticResource LibraryPin}" Tag="{Binding IsPinned}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0" Command="{Binding DataContext.PinCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
 <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,10,0,4"/>
 <TextBlock Grid.Row="2" Foreground="#C4D2E8" FontSize="12"><Run Text="{Binding Slots.Count,Mode=OneWay}"/><Run Text=" ô ảnh"/></TextBlock>
 </Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
 <TextBlock Grid.Row="1" Text="{Binding EmptyLibraryText}" TextWrapping="Wrap" MaxWidth="340" Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#C4D2E8" Visibility="{Binding IsLibraryEmpty,Converter={StaticResource BoolVisibility}}"/>
 </Grid>
 <Border x:Name="DetailPanel" Grid.Column="2" Background="#1B2432" BorderBrush="#8196B2" BorderThickness="1" CornerRadius="12" Padding="18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
 <DockPanel Margin="0,0,0,16"><Button DockPanel.Dock="Right" Style="{StaticResource LibraryPin}" Command="{Binding PinCommand}" Tag="{Binding SelectedFrame.IsPinned}" VerticalAlignment="Top" Margin="12,0,0,0"/><StackPanel><TextBlock Text="CHI TIẾT KHUNG ẢNH" FontSize="10" Foreground="#C4D2E8"/><TextBlock Text="{Binding SelectedFrame.Name}" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></DockPanel>
 <TextBlock Grid.Row="1" Text="Chọn một khung ảnh để xem chi tiết" Foreground="#C4D2E8" TextWrapping="Wrap" VerticalAlignment="Top"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasSelectedFrame}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
 <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding HasSelectedFrame,Converter={StaticResource BoolVisibility}}"><StackPanel>
 <Button x:Name="FramePreview" Command="{Binding EditSlotOrderCommand}" Height="300" Padding="10" Margin="0" Background="#111722" BorderBrush="#8196B2" ToolTip="Đánh số thứ tự ô ảnh">
 <Viewbox Stretch="Uniform"><Grid Width="{Binding SelectedFrame.PixelWidth}" Height="{Binding SelectedFrame.PixelHeight}"><Image Source="{Binding SelectedFrame.SourcePath}" Stretch="Fill"/>
 <ItemsControl ItemsSource="{Binding DetailSlots}" IsHitTestVisible="False"><ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding X}"/><Setter Property="Canvas.Top" Value="{Binding Y}"/><Setter Property="Width" Value="{Binding Width}"/><Setter Property="Height" Value="{Binding Height}"/></Style></ItemsControl.ItemContainerStyle><ItemsControl.ItemTemplate><DataTemplate><Grid><Border BorderBrush="#A7C5FF" BorderThickness="4" Background="#18000000"/><Border Width="54" Height="54" CornerRadius="27" Background="#315DAE" BorderBrush="White" BorderThickness="3" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="{Binding NumberText}" Foreground="White" FontSize="27" FontWeight="Bold" HorizontalAlignment="Center"/></Border></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
 </Grid></Viewbox></Button><TextBlock Text="Nhấn vào khung để đổi thứ tự ô ảnh" Foreground="#C4D2E8" FontSize="12" Margin="0,10,0,8"/><TextBlock Foreground="#C4D2E8" Margin="0,0,0,16"><Run Text="Số ô ảnh: "/><Run Text="{Binding SelectedFrame.Slots.Count,Mode=OneWay}"/></TextBlock>
 <Border BorderBrush="#8196B2" BorderThickness="0,1,0,0" Padding="0,14,0,0"><StackPanel><TextBlock Text="Phân loại vào bộ sưu tập" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/><DockPanel><Button DockPanel.Dock="Right" Content="Lưu phân loại" Command="{Binding AssignEventCommand}" Style="{StaticResource LibrarySecondary}" Margin="8,0,0,0"/><ComboBox ItemsSource="{Binding AssignmentEvents}" SelectedItem="{Binding AssignmentEvent}" ItemTemplate="{StaticResource CollectionName}" Margin="0" IsEnabled="{Binding IsLibraryReady}" AutomationProperties.Name="Phân loại vào bộ sưu tập"/></DockPanel><Button Content="Xóa khung ảnh" Command="{Binding DeleteCommand}" Style="{StaticResource LibraryDanger}" HorizontalAlignment="Left" Margin="0,18,0,0"/></StackPanel></Border>
 </StackPanel></ScrollViewer></Grid></Border></Grid>
 <TextBlock Grid.Row="5" Text="Sử dụng bộ sưu tập sẽ thay thế toàn bộ danh sách đang dùng. Áp dụng từ lượt chụp tiếp theo." FontSize="11" Foreground="#C4D2E8" TextWrapping="Wrap" Margin="0,14,0,0"/>
 </Grid></UserControl>
