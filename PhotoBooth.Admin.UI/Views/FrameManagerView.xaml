<UserControl x:Class="PhotoBooth.Admin.UI.Views.FrameManagerView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource BackgroundBrush}">
 <UserControl.Resources>
  <Style x:Key="SmallSecondary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#45454B"/><Setter Property="Padding" Value="13,8"/><Setter Property="MinWidth" Value="88"/></Style>
  <Style x:Key="SmallDanger" TargetType="Button" BasedOn="{StaticResource SmallSecondary}"><Setter Property="Background" Value="#823944"/></Style>
  <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Foreground" Value="#9C9DA5"/><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="3,4,3,3"/></Style>
 </UserControl.Resources>
 <Grid Margin="28,24,28,28">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Thư viện frame" FontSize="28" FontWeight="Bold"/><TextBlock Text="Sắp xếp frame theo sự kiện để dễ tìm và quản lý." Foreground="#A9AAB1" FontFamily="Segoe UI" Margin="0,5,0,0"/></StackPanel><Button Grid.Column="1" Content="+ Nhập frame PNG" Command="{Binding ImportCommand}" Padding="18,10" Margin="8,0,0,0"/></Grid>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*" MinWidth="420"/><ColumnDefinition Width="12"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>

   <!-- Event collections -->
   <Border Background="{StaticResource CardBrush}" CornerRadius="12"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="17,16,17,12"><TextBlock Text="Sự kiện" FontSize="17" FontWeight="Bold"/><TextBlock Text="Bộ sưu tập frame" Foreground="#8F9098" FontFamily="Segoe UI" FontSize="12" Margin="0,3,0,0"/></StackPanel>
    <ListBox Grid.Row="1" ItemsSource="{Binding EventItems}" SelectedItem="{Binding SelectedEvent}" Margin="9,0"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,5"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Box" Background="#252529" CornerRadius="8" Padding="12,10" BorderBrush="Transparent" BorderThickness="1"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Background" Value="#34343A"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Box" Property="Background" Value="#263D64"/><Setter TargetName="Box" Property="BorderBrush" Value="#4F8CFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/><Border Grid.Column="1" Background="#35353B" CornerRadius="10" Padding="7,2" Margin="8,0,0,0"><TextBlock Text="{Binding FrameCount}" Foreground="#C6C7CE" FontSize="10"/></Border></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
    <Border Grid.Row="2" BorderBrush="#3C3C40" BorderThickness="0,1,0,0" Padding="13"><StackPanel><TextBlock Text="Tạo sự kiện mới" Style="{StaticResource Label}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding NewEventName,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,7,0"/><Button Grid.Column="1" Content="+" Command="{Binding CreateEventCommand}" Margin="0" Padding="14,8"/></Grid><TextBlock Text="Đổi tên sự kiện đang chọn" Style="{StaticResource Label}" Margin="3,12,3,3"/><TextBox Text="{Binding EditEventName,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanManageSelectedEvent}" Margin="0,0,0,7"/><WrapPanel><Button Content="Lưu tên" Command="{Binding RenameEventCommand}" Style="{StaticResource SmallSecondary}" Margin="0,0,6,0"/><Button Content="Xóa" Command="{Binding DeleteEventCommand}" Style="{StaticResource SmallDanger}" Margin="0"/></WrapPanel></StackPanel></Border>
   </Grid></Border>

   <!-- Frames in selected collection -->
   <Border Grid.Column="2" Background="{StaticResource CardBrush}" CornerRadius="12"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Margin="15,14,15,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" Padding="11,8" ToolTip="Tìm theo tên frame"/><ComboBox Grid.Column="1" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding Sort}" Margin="0,0,8,0"/><Border Grid.Column="2" Background="#263D64" CornerRadius="12" Padding="9,4" VerticalAlignment="Center"><TextBlock Text="{Binding FrameSummary}" Foreground="#BDD4FF" FontSize="11"/></Border></Grid>
    <ListBox Grid.Row="1" ItemsSource="{Binding VisibleFrames}" SelectedItem="{Binding SelectedFrame}" Margin="9,0,9,9"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,6"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Box" Background="#252529" CornerRadius="9" Padding="9" BorderBrush="Transparent" BorderThickness="1"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Background" Value="#34343A"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Box" Property="Background" Value="#2A3448"/><Setter TargetName="Box" Property="BorderBrush" Value="#4F8CFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="74" Height="62" Background="#18181B" CornerRadius="6" ClipToBounds="True"><Image Source="{Binding ThumbnailPath}" Stretch="UniformToFill"/></Border><StackPanel Grid.Column="1" Margin="11,2"><TextBlock Text="{Binding Name}" FontSize="15" TextTrimming="CharacterEllipsis"/><TextBlock Foreground="#92939B" FontFamily="Segoe UI" FontSize="11" Margin="0,6,0,0"><Run Text="{Binding Slots.Count,Mode=OneWay}"/><Run Text=" ô ảnh  ·  "/><Run Text="{Binding CreatedAtUtc,Mode=OneWay,StringFormat={}{0:dd/MM/yyyy}}"/></TextBlock></StackPanel><TextBlock Grid.Column="2" Text="&#xE718;" FontFamily="Segoe MDL2 Assets" FontSize="18" Margin="8,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#55555D"/><Style.Triggers><DataTrigger Binding="{Binding IsPinned}" Value="True"><Setter Property="Foreground" Value="#FFD166"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
   </Grid></Border>

   <!-- Details -->
   <Border Grid.Column="4" Background="{StaticResource CardBrush}" CornerRadius="12"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="18,16,18,12"><TextBlock Text="Chi tiết frame" FontSize="17" FontWeight="Bold"/><TextBlock Text="Xem trước và phân loại" Foreground="#8F9098" FontFamily="Segoe UI" FontSize="12" Margin="0,3,0,0"/></StackPanel>
    <Border Grid.Row="1" Margin="14,0" Background="#18181B" CornerRadius="9" Padding="10"><Grid><TextBlock Text="Chọn một frame để xem trước" Foreground="#777780" TextWrapping="Wrap"/><Image Source="{Binding SelectedFrame.SourcePath}" Stretch="Uniform"/></Grid></Border>
    <StackPanel Grid.Row="2" Margin="16,13,16,15"><TextBlock Text="{Binding SelectedFrame.Name}" FontSize="17" TextAlignment="Left" TextTrimming="CharacterEllipsis"/><TextBlock Foreground="#92939B" FontFamily="Segoe UI" FontSize="12" TextAlignment="Left" Margin="0,5,0,12"><Run Text="Số ô ảnh: "/><Run Text="{Binding SelectedFrame.Slots.Count,Mode=OneWay}"/><Run Text="  ·  Đã ghim: "/><Run Text="{Binding PinnedCount,Mode=OneWay}"/><Run Text=" / 10"/></TextBlock><TextBlock Text="Phân loại vào sự kiện" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding AssignmentEvents}" SelectedItem="{Binding AssignmentEvent}" Margin="0,0,0,7"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextAlignment="Left" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><Button Content="Lưu phân loại" Command="{Binding AssignEventCommand}" Margin="0,0,0,8"/><WrapPanel><Button Content="Ghim / Bỏ ghim" Command="{Binding PinCommand}" Style="{StaticResource SmallSecondary}" Margin="0,0,7,0"/><Button Content="Xóa frame" Command="{Binding DeleteCommand}" Style="{StaticResource SmallDanger}" Margin="0"/></WrapPanel><Border Background="#3A321F" BorderBrush="#6A582B" BorderThickness="1" CornerRadius="7" Padding="10,8" Margin="0,12,0,0" Visibility="{Binding HasMessage,Converter={StaticResource BoolVisibility}}"><TextBlock Text="{Binding Message}" Foreground="#FFD98A" FontFamily="Segoe UI" FontSize="12" TextWrapping="Wrap"/></Border></StackPanel>
   </Grid></Border>
  </Grid>
 </Grid>
</UserControl>
