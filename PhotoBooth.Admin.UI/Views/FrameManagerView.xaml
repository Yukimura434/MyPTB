<UserControl x:Class="PhotoBooth.Admin.UI.Views.FrameManagerView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel><TextBlock Text="Frame Manager" Style="{StaticResource PageTitle}" DockPanel.Dock="Left"/><Button Content="Import PNG" Command="{Binding ImportCommand}" DockPanel.Dock="Right"/></DockPanel><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}"><DockPanel><StackPanel DockPanel.Dock="Top" Orientation="Horizontal"><TextBox Width="240" Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}"/><ComboBox Width="150" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding Sort}"/><Button Content="Refresh" Command="{Binding RefreshCommand}"/><TextBlock Text="{Binding PinnedCount,StringFormat=Pinned: {0} / 10}" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="#FFD54F" FontWeight="SemiBold"/></StackPanel><ListBox ItemsSource="{Binding VisibleFrames}" SelectedItem="{Binding SelectedFrame}"><ListBox.ItemTemplate><DataTemplate><Border Background="#252526" CornerRadius="8" Margin="3" Padding="8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Image Source="{Binding SourcePath}" Width="60" Height="50" Stretch="UniformToFill"/><StackPanel Grid.Column="1" Margin="10,0"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Foreground="#999"><Run Text="Slots: "/><Run Text="{Binding Slots.Count,Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding CreatedAtUtc,Mode=OneWay}"/></TextBlock></StackPanel><TextBlock Grid.Column="2" Text="&#xE718;" FontFamily="Segoe MDL2 Assets" FontSize="18" Margin="4,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#6A6A6A"/><Style.Triggers><DataTrigger Binding="{Binding IsPinned}" Value="True"><Setter Property="Foreground" Value="#FFD54F"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Border><Border Grid.Column="1" Style="{StaticResource Card}"><DockPanel><StackPanel DockPanel.Dock="Bottom"><WrapPanel><Button Content="Pin / Unpin" Command="{Binding PinCommand}"/><Button Content="Delete" Command="{Binding DeleteCommand}" Background="#F44336"/></WrapPanel><TextBlock Text="{Binding Message}" Foreground="#FFB74D" Margin="6"/></StackPanel><Grid><Image Source="{Binding SelectedFrame.SourcePath}" Stretch="Uniform"/><Border BorderBrush="#4F8CFF" BorderThickness="1"/><Border VerticalAlignment="Bottom" Background="#CC1E1E1E" Padding="10"><StackPanel><TextBlock Text="{Binding SelectedFrame.Name}" FontSize="18"/><TextBlock><Run Text="Detected slots: "/><Run Text="{Binding SelectedFrame.Slots.Count,Mode=OneWay}"/></TextBlock></StackPanel></Border></Grid></DockPanel></Border></Grid></Grid></UserControl>
