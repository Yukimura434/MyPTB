<UserControl x:Class="PhotoBooth.Admin.UI.Views.PresetManagerView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/MiuPhotoBooth;component/Themes/LibraryStyles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <Grid Margin="24,22,24,18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <DockPanel Margin="0,0,0,18"><Button DockPanel.Dock="Right" Content="+ Nhập preset" Command="{Binding ImportLutCommand}" Margin="12,0,0,0" VerticalAlignment="Center"/><StackPanel><TextBlock Text="Preset màu" Style="{StaticResource PageTitle}"/><TextBlock Text="Chọn từng mục hoặc sử dụng một bộ sưu tập tại booth." Style="{StaticResource PageSubtitle}" TextWrapping="Wrap"/></StackPanel></DockPanel>
 <Border Grid.Row="1" Background="#1D2C43" BorderBrush="#8196B2" BorderThickness="1" CornerRadius="9" Padding="14,10" Margin="0,0,0,14"><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Dùng màu gốc" Command="{Binding ClearLivePresetCommand}" Style="{StaticResource LibrarySecondary}" Margin="12,0,8,0"/><Button Content="Xem Live View" Command="{Binding ViewLiveCommand}" Style="{StaticResource LibrarySecondary}"/></StackPanel><StackPanel><TextBlock Text="PRESET CHO LIVE VIEW" FontSize="10" Foreground="#C4D2E8"/><TextBlock Text="{Binding LivePresetSummary}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></DockPanel></Border>
 <DockPanel Grid.Row="2" Margin="0,0,0,14"><Button x:Name="ManageCollectionsButton" DockPanel.Dock="Right" Content="Quản lý bộ sưu tập" Click="ManageCollections_Click" Style="{StaticResource LibrarySecondary}" Visibility="{Binding ShowCollections,Converter={StaticResource BoolVisibility}}" IsEnabled="{Binding IsLibraryReady}"/><WrapPanel>
 <Button Content="Tất cả preset" Command="{Binding SetLibraryTabCommand}" CommandParameter="Tất cả"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource LibrarySecondary}"><Setter Property="Margin" Value="0,0,8,0"/><Style.Triggers><DataTrigger Binding="{Binding LibraryTab}" Value="Tất cả"><Setter Property="Background" Value="#263D64"/><Setter Property="BorderBrush" Value="#B5CEFF"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Content="Đang sử dụng" Command="{Binding SetLibraryTabCommand}" CommandParameter="Đang sử dụng"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource LibrarySecondary}"><Setter Property="Margin" Value="0,0,8,0"/><Style.Triggers><DataTrigger Binding="{Binding LibraryTab}" Value="Đang sử dụng"><Setter Property="Background" Value="#263D64"/><Setter Property="BorderBrush" Value="#B5CEFF"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
 <Button x:Name="CollectionsButton" Content="Bộ sưu tập  ▾" Click="Collections_Click"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource LibrarySecondary}"><Style.Triggers><DataTrigger Binding="{Binding ShowCollections}" Value="True"><Setter Property="Background" Value="#263D64"/><Setter Property="BorderBrush" Value="#B5CEFF"/></DataTrigger></Style.Triggers></Style></Button.Style>
 <Button.ContextMenu><ContextMenu Style="{StaticResource LibraryMenu}" DataContext="{Binding PlacementTarget.DataContext,RelativeSource={RelativeSource Self}}" ItemsSource="{Binding Collections}" Background="#1B2432" BorderBrush="#8196B2" BorderThickness="1" MinWidth="230"><ContextMenu.ItemContainerStyle><Style TargetType="MenuItem" BasedOn="{StaticResource LibraryMenuItem}"><Setter Property="Header" Value="{Binding Name}"/><Setter Property="Command" Value="{Binding DataContext.SelectCollectionCommand,RelativeSource={RelativeSource AncestorType=ContextMenu}}"/><Setter Property="CommandParameter" Value="{Binding}"/></Style></ContextMenu.ItemContainerStyle></ContextMenu></Button.ContextMenu></Button>
 <TextBlock Text="{Binding EffectiveSummary}" Foreground="#BDD4FF" Margin="16,0,8,0"/></WrapPanel></DockPanel>
 <Border Grid.Row="3" Background="#263D64" BorderBrush="#8196B2" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12" Visibility="{Binding HasMessage,Converter={StaticResource BoolVisibility}}"><TextBlock Text="{Binding Message}" TextWrapping="Wrap"/></Border>
 <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition x:Name="DetailColumn" Style="{StaticResource LibraryDetailColumn}"/></Grid.ColumnDefinitions>
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,12,14"><TextBlock Text="{Binding PresetSummary}" DockPanel.Dock="Right" Foreground="#C4D2E8" FontSize="12"/><TextBlock Text="{Binding LibraryHeading}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></DockPanel>
 <ListBox x:Name="AssetList" Grid.Row="1" ItemsSource="{Binding VisiblePresets}" SelectedItem="{Binding SelectedPreset}" ItemContainerStyle="{StaticResource LibraryItem}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" >

 <ListBox.ItemTemplate><DataTemplate><Grid MinHeight="72"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions><Border Width="40" Height="40" Background="#263D64" BorderBrush="#8196B2" BorderThickness="1" CornerRadius="8" VerticalAlignment="Center"><TextBlock Text="◉" FontSize="22" Foreground="#DCE8FB" HorizontalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0"><TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding LutDisplayName}" FontSize="12" Foreground="#C4D2E8" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/></StackPanel><Button Grid.Column="2" Style="{StaticResource LibraryPin}" Tag="{Binding IsPinned}" VerticalAlignment="Top" HorizontalAlignment="Right" Command="{Binding DataContext.PinCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
 <TextBlock Grid.Row="1" Text="{Binding EmptyLibraryText}" TextWrapping="Wrap" MaxWidth="340" Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#C4D2E8" Visibility="{Binding IsLibraryEmpty,Converter={StaticResource BoolVisibility}}"/>
 </Grid>
 <Border x:Name="DetailPanel" Grid.Column="2" Background="#1B2432" BorderBrush="#8196B2" BorderThickness="1" CornerRadius="12" Padding="18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
 <DockPanel Margin="0,0,0,16"><Button DockPanel.Dock="Right" Style="{StaticResource LibraryPin}" Command="{Binding PinCommand}" Tag="{Binding SelectedPreset.IsPinned}" VerticalAlignment="Top" Margin="12,0,0,0"/><StackPanel><TextBlock Text="CHI TIẾT PRESET" FontSize="10" Foreground="#C4D2E8"/><TextBlock Text="{Binding SelectedPreset.Name}" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></DockPanel>
 <TextBlock Grid.Row="1" Text="Chọn một preset để xem chi tiết" Foreground="#C4D2E8" TextWrapping="Wrap" VerticalAlignment="Top"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasSelection}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
 <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding HasSelection,Converter={StaticResource BoolVisibility}}"><StackPanel>
 <Grid x:Name="PresetPreviewLayout" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition x:Name="PreviewImageColumn" Width="0.9*"/><ColumnDefinition x:Name="PreviewGapColumn" Width="18"/><ColumnDefinition x:Name="PreviewControlColumn" Width="1.3*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition x:Name="PreviewGapRow" Height="0"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <Grid x:Name="PresetImagePanel" VerticalAlignment="Top"><Image x:Name="PresetImage" Source="{Binding PreviewBytes,Converter={StaticResource ByteImage}}" Stretch="Uniform" MaxHeight="300" VerticalAlignment="Top"/><Border Background="#E61B2432" Padding="8" VerticalAlignment="Center" Visibility="{Binding IsPreviewBusy,Converter={StaticResource BoolVisibility}}"><TextBlock Text="Đang xem thử màu…" TextWrapping="Wrap" HorizontalAlignment="Center"/></Border></Grid>
 <StackPanel x:Name="PresetControls" Grid.Column="2"><DockPanel><TextBlock Text="{Binding LutStrengthPercent}" DockPanel.Dock="Right" Foreground="#BDD4FF"/><TextBlock Text="Cường độ áp dụng" FontSize="12" FontWeight="SemiBold"/></DockPanel><Slider Minimum="0" Maximum="1" TickFrequency="0.05" Value="{Binding LutStrength,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding HasSelection}" Margin="0,12,0,0"/><DockPanel Margin="0,0,0,14"><TextBlock Text="100%" DockPanel.Dock="Right" FontSize="10" Foreground="#C4D2E8"/><TextBlock Text="0%" FontSize="10" Foreground="#C4D2E8"/></DockPanel>
 <Button Content="{Binding UseLivePresetText}" Command="{Binding UseLivePresetCommand}" Padding="8,10" Margin="0,0,0,10"/><TextBlock Text="{Binding LivePresetHelp}" Foreground="#C4D2E8" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,14"/><Button Content="Lưu cường độ" Command="{Binding SaveStrengthCommand}" Style="{StaticResource LibrarySecondary}"/>
 </StackPanel></Grid>
 <Expander Header="Tên và thông tin preset" Foreground="#C4D2E8" Margin="0,0,0,14"><StackPanel Margin="0,10,0,0"><TextBlock Text="Tên hiển thị" Style="{StaticResource FieldLabel}"/><DockPanel><Button DockPanel.Dock="Right" Content="Lưu tên" Command="{Binding RenameCommand}" Style="{StaticResource LibrarySecondary}" Margin="8,0,0,0"/><TextBox Text="{Binding EditName,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding HasSelection}" Margin="0"/></DockPanel><TextBlock Text="Tệp màu gốc" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding SelectedPreset.LutDisplayName}" TextWrapping="Wrap"/><TextBlock Text="{Binding LutStatusText}" Foreground="#C4D2E8" Margin="0,6,0,0"/></StackPanel></Expander>
 <Border BorderBrush="#8196B2" BorderThickness="0,1,0,0" Padding="0,14,0,0"><StackPanel><TextBlock Text="Phân loại vào bộ sưu tập" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/><DockPanel><Button DockPanel.Dock="Right" Content="Lưu phân loại" Command="{Binding AssignEventCommand}" Style="{StaticResource LibrarySecondary}" Margin="8,0,0,0"/><ComboBox ItemsSource="{Binding AssignmentEvents}" SelectedItem="{Binding AssignmentEvent}" ItemTemplate="{StaticResource CollectionName}" Margin="0" IsEnabled="{Binding IsLibraryReady}" AutomationProperties.Name="Phân loại vào bộ sưu tập"/></DockPanel><Button Content="Xóa preset" Command="{Binding DeleteCommand}" Style="{StaticResource LibraryDanger}" HorizontalAlignment="Left" Margin="0,18,0,0"/></StackPanel></Border>
 </StackPanel></ScrollViewer></Grid></Border></Grid>
 <TextBlock Grid.Row="5" Text="Sử dụng bộ sưu tập sẽ thay thế toàn bộ danh sách đang dùng. Áp dụng từ lượt chụp tiếp theo." FontSize="11" Foreground="#C4D2E8" TextWrapping="Wrap" Margin="0,14,0,0"/>
 </Grid></UserControl>
