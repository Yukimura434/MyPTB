<UserControl x:Class="PhotoBooth.Admin.UI.Views.PresetManagerView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource BackgroundBrush}">
 <UserControl.Resources>
  <Style x:Key="Action" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="MinWidth" Value="104"/><Setter Property="Margin" Value="0,0,8,8"/></Style>
  <Style x:Key="Secondary" TargetType="Button" BasedOn="{StaticResource Action}"><Setter Property="Background" Value="#45454B"/></Style>
  <Style x:Key="Danger" TargetType="Button" BasedOn="{StaticResource Action}"><Setter Property="Background" Value="#8E3B46"/></Style>
  <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Foreground" Value="#B9BAC1"/><Setter Property="Margin" Value="4,4,4,3"/><Setter Property="FontSize" Value="12"/></Style>
 </UserControl.Resources>
 <Grid Margin="28,24,28,28">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,20">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="Presets" FontSize="28" FontWeight="Bold"/><TextBlock Text="Quản lý cấu hình màu dùng cho Live View và ảnh chụp." Margin="0,5,0,0" Foreground="#A9AAB1" FontFamily="Segoe UI"/></StackPanel>
   <Border Grid.Column="1" VerticalAlignment="Center" Background="#263D64" CornerRadius="16" Padding="12,6"><TextBlock Text="{Binding PresetSummary}" Foreground="#BDD4FF" FontSize="12"/></Border>
  </Grid>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="360" MinWidth="300"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*" MinWidth="480"/></Grid.ColumnDefinitions>
   <Border Background="{StaticResource CardBrush}" CornerRadius="12">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Margin="18,17,18,12"><TextBlock Text="Danh sách preset" FontSize="17" FontWeight="Bold"/><TextBlock Text="Chọn một preset để chỉnh sửa" Foreground="#92939B" FontFamily="Segoe UI" FontSize="12" Margin="0,3,0,0"/></StackPanel>
     <ListBox Grid.Row="1" ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" Margin="10,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,6"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Box" Background="#252529" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" Padding="14,12"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Background" Value="#34343A"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Box" Property="Background" Value="#263D64"/><Setter TargetName="Box" Property="BorderBrush" Value="#4F8CFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontSize="15" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding ModifiedAtUtc, StringFormat='Cập nhật {0:dd/MM/yyyy HH:mm}'}" Foreground="#92939B" FontFamily="Segoe UI" FontSize="11" Margin="0,5,0,0"/></StackPanel><Border Grid.Column="1" Background="#245B46" CornerRadius="10" Padding="8,3" Margin="8,0,0,0" VerticalAlignment="Top" Visibility="{Binding IsDefault,Converter={StaticResource BoolVisibility}}"><TextBlock Text="MẶC ĐỊNH" Foreground="#9BE2BE" FontSize="9"/></Border></Grid></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <Border Grid.Row="2" BorderBrush="#3C3C40" BorderThickness="0,1,0,0" Padding="14"><StackPanel><TextBlock Text="Tên preset mới" Style="{StaticResource Label}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding CreateName,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/><Button Grid.Column="1" Content="+ Tạo" Command="{Binding CreateCommand}" Margin="0"/></Grid></StackPanel></Border>
    </Grid>
   </Border>
   <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" Background="Transparent"/>
   <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
     <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="20" Margin="0,0,0,12"><StackPanel>
      <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Thông tin preset" FontSize="18" FontWeight="Bold"/><TextBlock Text="Đổi tên, sao chép hoặc đặt preset cho phiên chụp." Foreground="#92939B" FontFamily="Segoe UI" FontSize="12" Margin="0,4,0,0"/></StackPanel><Border Grid.Column="1" Background="#245B46" CornerRadius="11" Padding="10,4" Visibility="{Binding SelectedPreset.IsDefault,Converter={StaticResource BoolVisibility}}"><TextBlock Text="Đang sử dụng mặc định" Foreground="#9BE2BE" FontSize="11"/></Border></Grid>
      <TextBlock Text="Tên hiển thị" Style="{StaticResource Label}"/><TextBox Text="{Binding EditName,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding HasSelection}" Margin="0,0,0,12"/>
      <WrapPanel><Button Content="Lưu tên" Command="{Binding RenameCommand}" Style="{StaticResource Action}"/><Button Content="Đặt mặc định" Command="{Binding DefaultCommand}" Style="{StaticResource Action}" Background="#267454"/><Button Content="Không sử dụng preset" Command="{Binding ClearDefaultCommand}" Style="{StaticResource Secondary}" MinWidth="168"/><Button Content="Nhân bản" Command="{Binding DuplicateCommand}" Style="{StaticResource Secondary}"/><Button Content="Xóa preset" Command="{Binding DeleteCommand}" Style="{StaticResource Danger}"/></WrapPanel>
     </StackPanel></Border>
     <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="20"><StackPanel>
      <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Màu sắc · 3D LUT" FontSize="18" FontWeight="Bold"/><TextBlock Text="Gắn tệp .cube và điều chỉnh cường độ áp dụng." Foreground="#92939B" FontFamily="Segoe UI" FontSize="12" Margin="0,4,0,0"/></StackPanel><Button Grid.Column="1" Content="Nhập LUT mới" Command="{Binding ImportLutCommand}" Style="{StaticResource Secondary}" Margin="8,0,0,0"/></Grid>
      <TextBlock Text="LUT áp dụng" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding Luts}" SelectedItem="{Binding SelectedLut}" IsEnabled="{Binding HasSelection}" Margin="0,0,0,10"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" TextAlignment="Left" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
      <Border Background="#242428" CornerRadius="8" Padding="14" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="KÍCH THƯỚC" Foreground="#85868E" FontSize="10"/><TextBlock Text="{Binding LutCubeSizeText}" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="TRẠNG THÁI" Foreground="#85868E" FontSize="10"/><TextBlock Text="{Binding LutStatusText}" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="LIVE VIEW" Foreground="#85868E" FontSize="10"/><TextBlock Text="{Binding LutLiveViewText}" Margin="0,4,0,0"/></StackPanel></Grid></Border>
      <Grid Margin="4,0,4,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Cường độ" Foreground="#B9BAC1"/><TextBlock Grid.Column="1" Text="{Binding LutStrengthPercent}" Foreground="#BDD4FF"/></Grid>
      <Slider Minimum="0" Maximum="1" Value="{Binding LutStrength}" TickFrequency="0.05" IsSnapToTickEnabled="True" IsEnabled="{Binding HasSelection}" Margin="4,0,4,14"/>
      <WrapPanel><Button Content="Áp dụng LUT" Command="{Binding AttachLutCommand}" Style="{StaticResource Action}"/><Button Content="Gỡ khỏi preset" Command="{Binding DetachLutCommand}" Style="{StaticResource Secondary}"/><Button Content="Xóa khỏi thư viện" Command="{Binding DeleteLutCommand}" Style="{StaticResource Danger}"/></WrapPanel>
      <TextBlock Text="LUT lớn hơn 65³ vẫn áp dụng cho ảnh chụp nhưng không dùng trong Live View. Giới hạn nhập là 128³." Foreground="#92939B" FontFamily="Segoe UI" FontSize="11" TextWrapping="Wrap" Margin="4,4,4,0"/>
     </StackPanel></Border>
     <Border Background="#3A321F" BorderBrush="#6A582B" BorderThickness="1" CornerRadius="8" Padding="13,10" Margin="0,12,0,0" Visibility="{Binding HasMessage,Converter={StaticResource BoolVisibility}}"><TextBlock Text="{Binding Message}" Foreground="#FFD98A" FontFamily="Segoe UI" TextWrapping="Wrap"/></Border>
    </StackPanel>
   </ScrollViewer>
  </Grid>
 </Grid>
</UserControl>
