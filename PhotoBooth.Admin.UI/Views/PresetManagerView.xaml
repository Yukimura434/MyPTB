<UserControl x:Class="PhotoBooth.Admin.UI.Views.PresetManagerView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource BackgroundBrush}">
 <UserControl.Resources>
  <Style x:Key="SmallSecondary" TargetType="Button" BasedOn="{StaticResource AdminSecondaryButton}"><Setter Property="Padding" Value="13,8"/><Setter Property="MinWidth" Value="88"/></Style>
  <Style x:Key="SmallDanger" TargetType="Button" BasedOn="{StaticResource AdminDangerButton}"><Setter Property="Padding" Value="13,8"/><Setter Property="MinWidth" Value="88"/></Style>
  <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}"/>
 </UserControl.Resources>
 <Grid Margin="28,24,28,28">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Thư viện preset màu" Style="{StaticResource PageTitle}"/><TextBlock Text="Mỗi preset dùng một LUT và có thể sắp xếp theo sự kiện." Style="{StaticResource PageSubtitle}"/></StackPanel><Button Grid.Column="1" Content="+ Nhập LUT" Command="{Binding ImportLutCommand}" Padding="18,10" Margin="8,0,0,0"/></Grid>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*" MinWidth="420"/><ColumnDefinition Width="12"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>

   <!-- Event collections -->
   <Border Background="{StaticResource CardBrush}" CornerRadius="12"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="17,16,17,12"><TextBlock Text="Sự kiện" FontSize="17" FontWeight="Bold"/><TextBlock Text="Bộ sưu tập preset" Foreground="#8F9098" FontFamily="Segoe UI" FontSize="12" Margin="0,3,0,0"/></StackPanel>
    <ListBox Grid.Row="1" ItemsSource="{Binding EventItems}" SelectedItem="{Binding SelectedEvent}" Margin="9,0"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,5"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Box" Background="#252529" CornerRadius="8" Padding="12,10" BorderBrush="Transparent" BorderThickness="1"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Background" Value="#34343A"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Box" Property="Background" Value="#263D64"/><Setter TargetName="Box" Property="BorderBrush" Value="#4F8CFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/><Border Grid.Column="1" Background="#35353B" CornerRadius="10" Padding="7,2" Margin="8,0,0,0"><TextBlock Text="{Binding PresetCount}" Foreground="#C6C7CE" FontSize="10"/></Border></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
    <Border Grid.Row="2" BorderBrush="#3C3C40" BorderThickness="0,1,0,0" Padding="13"><StackPanel><TextBlock Text="Tạo sự kiện mới" Style="{StaticResource Label}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding NewEventName,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,7,0"/><Button Grid.Column="1" Content="+" Command="{Binding CreateEventCommand}" Margin="0" Padding="14,8"/></Grid><TextBlock Text="Đổi tên sự kiện đang chọn" Style="{StaticResource Label}" Margin="3,12,3,3"/><TextBox Text="{Binding EditEventName,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanManageSelectedEvent}" Margin="0,0,0,7"/><WrapPanel><Button Content="Lưu tên" Command="{Binding RenameEventCommand}" Style="{StaticResource SmallSecondary}" Margin="0,0,6,0"/><Button Content="Xóa" Command="{Binding DeleteEventCommand}" Style="{StaticResource SmallDanger}" Margin="0"/></WrapPanel></StackPanel></Border>
   </Grid></Border>

   <!-- Presets in selected collection -->
   <Border Grid.Column="2" Background="{StaticResource CardBrush}" CornerRadius="12"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Margin="15,14,15,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" Padding="11,8" ToolTip="Tìm theo tên preset hoặc LUT"/><ComboBox Grid.Column="1" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding Sort}" Margin="0,0,8,0"/><Border Grid.Column="2" Background="#263D64" CornerRadius="12" Padding="9,4" VerticalAlignment="Center"><TextBlock Text="{Binding PresetSummary}" Foreground="#BDD4FF" FontSize="11"/></Border></Grid>
    <ListBox Grid.Row="1" ItemsSource="{Binding VisiblePresets}" SelectedItem="{Binding SelectedPreset}" Margin="9,0,9,9"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,6"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Box" Background="#252529" CornerRadius="9" Padding="10" BorderBrush="Transparent" BorderThickness="1"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Background" Value="#34343A"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Box" Property="Background" Value="#2A3448"/><Setter TargetName="Box" Property="BorderBrush" Value="#4F8CFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="48" Height="48" Background="#32384A" CornerRadius="8"><TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="#8EB6FF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="10,1"><TextBlock Text="{Binding Name}" FontSize="15" TextTrimming="CharacterEllipsis"/><TextBlock Foreground="#92939B" FontFamily="Segoe UI" FontSize="11" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"><Run Text="{Binding LutDisplayName,Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding LutCubeSize,Mode=OneWay}"/><Run Text="³"/></TextBlock></StackPanel><TextBlock Grid.Column="2" Text="&#xE718;" FontFamily="Segoe MDL2 Assets" FontSize="18" Margin="8,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#55555D"/><Style.Triggers><DataTrigger Binding="{Binding IsPinned}" Value="True"><Setter Property="Foreground" Value="#FFD166"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
   </Grid></Border>

   <!-- One unified details panel -->
   <Border Grid.Column="4" Background="{StaticResource CardBrush}" CornerRadius="12"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="18,16,18,12"><TextBlock Text="Chi tiết preset" FontSize="17" FontWeight="Bold"/><TextBlock Text="Xem hiệu ứng LUT trên ảnh mẫu" Foreground="#8F9098" FontFamily="Segoe UI" FontSize="12" Margin="0,3,0,0"/></StackPanel>
    <Border Grid.Row="1" Margin="14,0" Background="#18181B" CornerRadius="9" Padding="8"><Grid><Image Source="{Binding PreviewBytes,Converter={StaticResource ByteImage}}" Stretch="Uniform"/><Border Background="#A018181B" CornerRadius="8" Padding="10,6" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsPreviewBusy,Converter={StaticResource BoolVisibility}}"><TextBlock Text="Đang vẽ hiệu ứng…" Foreground="#D7D8DF"/></Border></Grid></Border>
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="16,12,16,15">
     <Grid Margin="0,0,0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Cường độ xem trước · không lưu" Style="{StaticResource Label}"/><TextBlock Grid.Column="1" Text="{Binding LutStrengthPercent}" Foreground="#BDD4FF" VerticalAlignment="Center"/></Grid><Slider Minimum="0" Maximum="1" TickFrequency="0.05" Value="{Binding LutStrength,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding HasSelection}" Margin="0,0,0,10"/>
     <TextBlock Text="Tên hiển thị" Style="{StaticResource Label}"/><Grid Margin="0,0,0,9"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding EditName,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding HasSelection}" Margin="0,0,7,0"/><Button Grid.Column="1" Content="Lưu tên" Command="{Binding RenameCommand}" Style="{StaticResource SmallSecondary}" Margin="0"/></Grid>
     <TextBlock Text="LUT áp dụng · không thể thay đổi" Style="{StaticResource Label}"/><Border Background="#242428" CornerRadius="7" Padding="11,8" Margin="0,0,0,9"><TextBlock Text="{Binding SelectedPreset.LutDisplayName}" TextTrimming="CharacterEllipsis"/></Border>
     <Grid Margin="0,0,0,9"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#242428" CornerRadius="7" Padding="10" Margin="0,0,4,0"><StackPanel><TextBlock Text="KÍCH THƯỚC" Foreground="#85868E" FontSize="10"/><TextBlock Text="{Binding LutCubeSizeText}" Margin="0,4,0,0"/></StackPanel></Border><Border Grid.Column="1" Background="#242428" CornerRadius="7" Padding="10" Margin="4,0,0,0"><StackPanel><TextBlock Text="TRẠNG THÁI" Foreground="#85868E" FontSize="10"/><TextBlock Text="{Binding LutStatusText}" Margin="0,4,0,0"/></StackPanel></Border></Grid>
     <TextBlock Text="Phân loại vào sự kiện" Style="{StaticResource Label}"/><Grid Margin="0,0,0,9"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox ItemsSource="{Binding AssignmentEvents}" SelectedItem="{Binding AssignmentEvent}" Margin="0,0,7,0"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><Button Grid.Column="1" Content="Lưu" Command="{Binding AssignEventCommand}" Style="{StaticResource SmallSecondary}" Margin="0"/></Grid>
     <WrapPanel><Button Content="{Binding PinButtonText}" Command="{Binding PinCommand}" Margin="0,0,7,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource SmallSecondary}"><Style.Triggers><DataTrigger Binding="{Binding SelectedPreset.IsPinned}" Value="True"><Setter Property="Background" Value="#8A6A22"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Content="Xóa preset" Command="{Binding DeleteCommand}" Style="{StaticResource SmallDanger}" Margin="0"/></WrapPanel>
     <Border Background="#3A321F" BorderBrush="#6A582B" BorderThickness="1" CornerRadius="7" Padding="10,8" Margin="0,11,0,0" Visibility="{Binding HasMessage,Converter={StaticResource BoolVisibility}}"><TextBlock Text="{Binding Message}" Foreground="#FFD98A" FontFamily="Segoe UI" FontSize="12" TextWrapping="Wrap"/></Border>
    </StackPanel></ScrollViewer>
   </Grid></Border>
  </Grid>
 </Grid>
</UserControl>
