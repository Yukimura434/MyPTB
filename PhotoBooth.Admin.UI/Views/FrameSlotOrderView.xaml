<UserControl x:Class="PhotoBooth.Admin.UI.Views.FrameSlotOrderView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource BackgroundBrush}">
 <Grid Margin="28,24,28,28">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="Đánh số thứ tự ô ảnh" Style="{StaticResource PageTitle}"/><TextBlock Text="Nhấn vào từng ô theo đúng thứ tự ảnh sẽ được chụp và ghép vào frame." Style="{StaticResource PageSubtitle}"/></StackPanel>
   <Border Grid.Column="1" Background="#263D64" CornerRadius="15" Padding="13,7" VerticalAlignment="Center"><TextBlock Text="{Binding ProgressText}" Foreground="#BDD4FF" FontWeight="SemiBold"/></Border>
  </Grid>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
   <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
    <Grid><Border Background="#15171C" CornerRadius="9" Padding="12">
     <Viewbox Stretch="Uniform">
      <Grid Width="{Binding Frame.PixelWidth}" Height="{Binding Frame.PixelHeight}" Background="#24262B">
       <Image Source="{Binding Frame.SourcePath}" Stretch="Fill"/>
       <ItemsControl ItemsSource="{Binding Slots}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding X}"/><Setter Property="Canvas.Top" Value="{Binding Y}"/><Setter Property="Width" Value="{Binding Width}"/><Setter Property="Height" Value="{Binding Height}"/></Style></ItemsControl.ItemContainerStyle>
        <ItemsControl.ItemTemplate><DataTemplate>
         <Button Command="{Binding DataContext.ToggleSlotCommand,RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Padding="0" Margin="0" Background="Transparent" BorderThickness="0" ToolTip="Nhấn để đánh số hoặc bỏ số ô ảnh này">
          <Button.Template><ControlTemplate TargetType="Button"><Grid>
           <Border x:Name="SlotBorder" Background="#26000000" BorderBrush="#8BB1FF" BorderThickness="4"/>
           <Border x:Name="NumberBadge" Width="56" Height="56" CornerRadius="28" Background="#B9242933" BorderBrush="#8BB1FF" BorderThickness="3" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="{Binding NumberText}" Foreground="#D8E6FF" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          </Grid><ControlTemplate.Triggers>
           <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SlotBorder" Property="Background" Value="#3D5B8DEF"/><Setter TargetName="SlotBorder" Property="BorderBrush" Value="#C8D9FF"/></Trigger>
           <DataTrigger Binding="{Binding IsNumbered}" Value="True"><Setter TargetName="SlotBorder" Property="Background" Value="#245B8DEF"/><Setter TargetName="NumberBadge" Property="Background" Value="#F15B8DEF"/><Setter TargetName="NumberBadge" Property="BorderBrush" Value="White"/></DataTrigger>
          </ControlTemplate.Triggers></ControlTemplate></Button.Template>
         </Button>
        </DataTemplate></ItemsControl.ItemTemplate>
       </ItemsControl>
      </Grid>
     </Viewbox>
    </Border></Grid>
   </Border>
   <Border Grid.Column="2" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel><TextBlock Text="{Binding Frame.Name}" FontSize="19" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="Cách đánh số" Style="{StaticResource SectionTitle}" Margin="0,22,0,10"/><TextBlock Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" LineHeight="22" Text="• Nhấn vào ô chưa có số để gán số tiếp theo.&#x0a;• Nhấn lại ô đã có số để thu hồi số đó.&#x0a;• Các số phía sau tự động lùi lại, không để hở thứ tự."/><Border Background="#1E2D47" BorderBrush="#3F6096" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,18,0,0"><StackPanel><TextBlock Text="{Binding ProgressText}" FontWeight="SemiBold"/><TextBlock Text="{Binding SaveHint}" Foreground="#AFC6EE" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Border><Button Content="Đánh lại từ đầu" Command="{Binding ResetCommand}" Style="{StaticResource AdminSecondaryButton}" Margin="0,12,0,0"/></StackPanel>
     <Border Grid.Row="1" Background="#3A321F" BorderBrush="#6A582B" BorderThickness="1" CornerRadius="7" Padding="10,8" Margin="0,16,0,0" VerticalAlignment="Top" Visibility="{Binding HasMessage,Converter={StaticResource BoolVisibility}}"><TextBlock Text="{Binding Message}" Foreground="#FFD98A" TextWrapping="Wrap"/></Border>
     <StackPanel Grid.Row="2"><Button Content="Lưu thứ tự" Command="{Binding SaveCommand}" Style="{StaticResource AdminSuccessButton}" Margin="0,0,0,8"/><Button Content="Hủy" Command="{Binding CancelCommand}" Style="{StaticResource AdminSecondaryButton}" Margin="0"/></StackPanel>
    </Grid>
   </Border>
  </Grid>
 </Grid>
</UserControl>
