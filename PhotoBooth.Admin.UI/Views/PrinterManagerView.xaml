<UserControl x:Class="PhotoBooth.Admin.UI.Views.PrinterManagerView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PhotoBooth.Admin.UI.Views" Background="{StaticResource BackgroundBrush}">
 <UserControl.Resources><ResourceDictionary>
  <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/MiuPhotoBooth;component/Themes/LibraryStyles.xaml"/></ResourceDictionary.MergedDictionaries>
  <SolidColorBrush x:Key="MutedTextBrush" Color="#BDCBE0"/><SolidColorBrush x:Key="BorderStrongBrush" Color="#8196B2"/>
  <local:PrinterConnectionConverter x:Key="ConnectionLabel"/>
  <Style x:Key="Hint" TargetType="TextBlock"><Setter Property="Foreground" Value="#BDCBE0"/><Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="Field" TargetType="TextBlock" BasedOn="{StaticResource Hint}"><Setter Property="Margin" Value="0,0,0,6"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="Select" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="Margin" Value="0"/><Setter Property="MinHeight" Value="38"/><Setter Property="BorderBrush" Value="#8196B2"/><Setter Property="Padding" Value="10,7,32,7"/><Setter Property="ClipToBounds" Value="True"/><Setter Property="ItemTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"/></DataTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Action" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Margin" Value="0"/><Setter Property="MinHeight" Value="40"/><Setter Property="Padding" Value="14,8"/></Style>
  <Style x:Key="Secondary" TargetType="Button" BasedOn="{StaticResource Action}"><Setter Property="Background" Value="#232D3C"/><Setter Property="BorderBrush" Value="#8196B2"/></Style>
  <Style x:Key="Fallback" TargetType="Border"><Setter Property="Background" Value="#202936"/><Setter Property="BorderBrush" Value="#8196B2"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="6"/><Setter Property="Padding" Value="11,8"/><Setter Property="MinHeight" Value="38"/></Style>
  <Style x:Key="PrinterItem" TargetType="ListBoxItem">
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="10"/><Setter Property="Margin" Value="0,0,0,8"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Chrome" Background="#252D39" BorderThickness="1" BorderBrush="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ContentPresenter/><TextBlock x:Name="Check" Grid.Column="1" Text="✓" Foreground="#BDD8FF" Margin="8,0,0,0" Visibility="Collapsed" FontSize="18"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#233A5E"/><Setter TargetName="Chrome" Property="BorderBrush" Value="#8BB8FF"/><Setter TargetName="Check" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#ADC8ED"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
 </ResourceDictionary></UserControl.Resources>
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*" MaxHeight="700"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Máy in" Style="{StaticResource PageTitle}"/><TextBlock Text="Chọn máy in và cấu hình cho MiuPhotoBooth." Style="{StaticResource Hint}" Margin="0,4,0,0"/></StackPanel><Border Grid.Column="1" Background="#1B222E" BorderBrush="#8196B2" BorderThickness="1" CornerRadius="9" Padding="14,10"><CheckBox x:Name="PrintingSwitch" IsChecked="{Binding PrintingEnabled}" IsEnabled="{Binding CanSelectPrinter}" AutomationProperties.Name="Cho phép in ở MiuPhotoBooth"><StackPanel><TextBlock Text="Cho phép in ở MiuPhotoBooth" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="{Binding PrintingHelp}" Style="{StaticResource Hint}" FontSize="11" Margin="0,3,0,0"/></StackPanel></CheckBox></Border></Grid>
  <Grid Grid.Row="1" MaxHeight="700" VerticalAlignment="Top"><Grid.ColumnDefinitions><ColumnDefinition Width="290"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="#1B222E" BorderBrush="#394658" BorderThickness="1" CornerRadius="12"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="16,16,16,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="Máy in khả dụng" FontSize="15" FontWeight="SemiBold"/><Border Background="#34435A" CornerRadius="5" Padding="6,2" Margin="7,0,0,0"><TextBlock Text="{Binding PrinterSummary}" FontSize="11" Foreground="White"/></Border></StackPanel><TextBlock Text="Được phát hiện từ Windows" Style="{StaticResource Hint}" FontSize="11" Margin="0,5,0,0"/></StackPanel><Button Grid.Column="1" x:Name="ScanButton" Content="Quét lại" Command="{Binding ScanCommand}" Style="{StaticResource Secondary}" FontSize="12" Padding="8,6" MinHeight="36" Margin="7,0,0,0"/></Grid>
    <ListBox Background="#1B222E" BorderThickness="0" x:Name="PrinterList" Grid.Row="1" ItemsSource="{Binding Printers}" SelectedItem="{Binding SelectedPrinter}" IsEnabled="{Binding CanSelectPrinter}" Margin="10,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ItemContainerStyle="{StaticResource PrinterItem}" AutomationProperties.Name="Máy in khả dụng"><ListBox.ItemTemplate><DataTemplate><Grid MinHeight="40"><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path Data="{StaticResource Icon.Printer}" Style="{StaticResource VectorIcon}" Width="20" Height="20" Stroke="#D4E0F4"/><StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" TextWrapping="Wrap" Foreground="#F2F4F8" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="{Binding ConnectionType,Converter={StaticResource ConnectionLabel}}" Foreground="#BDCBE0" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
    <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="18" Visibility="{Binding IsEmpty,Converter={StaticResource BoolVisibility}}"><Path Data="{StaticResource Icon.Printer}" Style="{StaticResource VectorIcon}" Width="34" Height="34" Stroke="#A1B7D7" HorizontalAlignment="Center"/><TextBlock Text="Chưa tìm thấy máy in" FontSize="15" FontWeight="SemiBold" TextAlignment="Center" Margin="0,16,0,6"/><TextBlock Text="Kiểm tra máy in trong Windows rồi quét lại." Style="{StaticResource Hint}" TextAlignment="Center"/></StackPanel>
    <StackPanel Grid.Row="2" Margin="16,12,16,16"><TextBlock Text="{Binding ConnectionHint}" Style="{StaticResource Hint}" FontSize="12" Margin="0,0,0,10"/><Button x:Name="ConnectButton" Content="{Binding ConnectLabel}" Command="{Binding ConnectCommand}" Style="{StaticResource Action}"/><TextBlock Text="{Binding PrinterStatus}" Style="{StaticResource Hint}" FontSize="11" Margin="0,9,0,0"/></StackPanel>
   </Grid></Border>
   <Border Grid.Column="2" Background="#1B222E" BorderBrush="#394658" BorderThickness="1" CornerRadius="12"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="20,16,20,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="CẤU HÌNH IN" Foreground="#BDCBE0" FontSize="10"/><TextBlock Text="{Binding ConfigurationName}" TextWrapping="Wrap" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/><TextBlock Text="{Binding ConfigurationCaption}" Style="{StaticResource Hint}" FontSize="12" Margin="0,5,0,0"/></StackPanel><Border Grid.Column="1" Background="#163F36" BorderBrush="#65A98D" BorderThickness="1" CornerRadius="6" Padding="9,6" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsSavedDefault,Converter={StaticResource BoolVisibility}}"><TextBlock Text="Mặc định ở booth" Foreground="#C2F1DA" FontSize="11"/></Border></Grid>
    <Border Grid.Row="1" Background="#3D3020" BorderBrush="#D4AD6B" BorderThickness="1" CornerRadius="7" Padding="12,9" Margin="20,0,20,12" Visibility="{Binding HasMessage,Converter={StaticResource BoolVisibility}}"><TextBlock Text="{Binding Message}" Foreground="#FFE0A7" TextWrapping="Wrap" FontSize="12" AutomationProperties.LiveSetting="Polite"/></Border>
    <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="28" Visibility="{Binding NeedsConnection,Converter={StaticResource BoolVisibility}}"><Path Data="{StaticResource Icon.Printer}" Style="{StaticResource VectorIcon}" Width="66" Height="66" Stroke="#91A9CC" HorizontalAlignment="Center" Margin="0,0,0,22"/><TextBlock Text="Kết nối một máy in để bắt đầu" FontSize="18" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/><TextBlock Text="Chọn máy bên trái, sau đó bấm “Kết nối máy đã chọn”." Style="{StaticResource Hint}" TextAlignment="Center" Margin="0,10,0,0"/><TextBlock Text="Các tùy chọn giấy và chất lượng sẽ được tải từ máy in." Style="{StaticResource Hint}" TextAlignment="Center" Margin="0,6,0,0"/></StackPanel>
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding HasEditingProfile,Converter={StaticResource BoolVisibility}}"><StackPanel Margin="20,0,20,16">
     <Border Background="#131B27" BorderBrush="#394658" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Kết nối" Style="{StaticResource Hint}" FontSize="11"/><TextBlock Text="{Binding ConnectionText}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,10,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Hỗ trợ in màu" Style="{StaticResource Hint}" FontSize="11"/><TextBlock Text="{Binding ColorSupportText}" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Hỗ trợ in hai mặt" Style="{StaticResource Hint}" FontSize="11"/><TextBlock Text="{Binding DuplexSupportText}" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Grid></Border>
     <StackPanel IsEnabled="{Binding CanEdit}"><TextBlock Text="Giấy &amp; chất lượng" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,14"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <StackPanel Margin="0,0,0,14"><TextBlock Text="Khổ giấy" Style="{StaticResource Field}"/><Grid><ComboBox x:Name="PaperBox" ItemsSource="{Binding PaperSizes}" SelectedItem="{Binding PaperSize}" IsEnabled="{Binding HasPaperSizes}" Style="{StaticResource Select}" AutomationProperties.Name="Khổ giấy"/><Border IsHitTestVisible="False"><Border.Style><Style TargetType="Border" BasedOn="{StaticResource Fallback}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasPaperSizes}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="Không có khổ giấy" Foreground="#C1CADA" FontSize="12"/></Border></Grid><TextBlock Text="{Binding PaperHelp}" Style="{StaticResource Hint}" FontSize="11" Margin="0,5,0,0"/></StackPanel>
       <StackPanel Grid.Column="2" Margin="0,0,0,14"><TextBlock Text="Nguồn giấy" Style="{StaticResource Field}"/><Grid><ComboBox ItemsSource="{Binding PaperTypes}" SelectedItem="{Binding PaperType}" IsEnabled="{Binding HasPaperTypes}" Style="{StaticResource Select}" AutomationProperties.Name="Nguồn giấy"/><Border IsHitTestVisible="False"><Border.Style><Style TargetType="Border" BasedOn="{StaticResource Fallback}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasPaperTypes}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="Mặc định của máy in" Foreground="#C1CADA" FontSize="12"/></Border></Grid></StackPanel>
       <StackPanel Grid.Row="1"><TextBlock Text="Chất lượng / độ phân giải" Style="{StaticResource Field}"/><Grid><ComboBox ItemsSource="{Binding Qualities}" SelectedItem="{Binding Quality}" IsEnabled="{Binding HasQualities}" Style="{StaticResource Select}" AutomationProperties.Name="Chất lượng hoặc độ phân giải"/><Border IsHitTestVisible="False"><Border.Style><Style TargetType="Border" BasedOn="{StaticResource Fallback}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasQualities}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="Mặc định của máy in" Foreground="#C1CADA" FontSize="12"/></Border></Grid></StackPanel>
       <StackPanel Grid.Row="1" Grid.Column="2"><TextBlock Text="Số bản mặc định" Style="{StaticResource Field}"/><ComboBox ItemsSource="{Binding Copies}" SelectedItem="{Binding DefaultCopies}" Style="{StaticResource Select}" AutomationProperties.Name="Số bản mặc định"><ComboBox.ItemTemplate><DataTemplate><TextBlock><Run Text="{Binding Mode=OneWay}"/><Run Text=" bản"/></TextBlock></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
      </Grid>
      <StackPanel Margin="0,12,0,14"><TextBlock Text="Loại giấy" Style="{StaticResource Field}"/><ComboBox ItemsSource="{Binding MediaTypes}" SelectedItem="{Binding MediaType}" Style="{StaticResource Select}" AutomationProperties.Name="Loại giấy"/><TextBlock Text="Chọn đúng loại giấy đang nạp vào máy." Style="{StaticResource Hint}" Margin="0,6,0,0"/></StackPanel>
      <Border BorderBrush="#394658" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,14,0,16"><StackPanel><TextBlock Text="Cách in" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><CheckBox IsChecked="{Binding Landscape}" VerticalAlignment="Top" AutomationProperties.Name="In ngang"><StackPanel><TextBlock Text="In ngang" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="Bỏ chọn để in dọc." Style="{StaticResource Hint}" FontSize="11" Margin="0,3,0,0"/></StackPanel></CheckBox><CheckBox Grid.Column="2" IsChecked="{Binding PrintInColor}" IsEnabled="{Binding SupportsColor}" VerticalAlignment="Top" AutomationProperties.Name="In màu"><StackPanel><TextBlock Text="In màu" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="Dùng màu khi máy in hỗ trợ." Style="{StaticResource Hint}" FontSize="11" Margin="0,3,0,0"/></StackPanel></CheckBox></Grid></StackPanel></Border>
      <Border Background="#202C3D" BorderBrush="#8196B2" BorderThickness="1" CornerRadius="8" Padding="14,11"><CheckBox IsChecked="{Binding IsDefault}" AutomationProperties.Name="Dùng làm máy in mặc định ở MiuPhotoBooth"><StackPanel><TextBlock Text="Dùng làm máy in mặc định ở MiuPhotoBooth" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="Máy in được chọn cho các lượt chụp tại booth." Style="{StaticResource Hint}" FontSize="11" Margin="0,3,0,0"/></StackPanel></CheckBox></Border>
     </StackPanel>
    </StackPanel></ScrollViewer>
    <Border Grid.Row="3" Background="#19212E" BorderBrush="#394658" BorderThickness="0,1,0,0" CornerRadius="0,0,12,12" Padding="16,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center" Margin="0,0,12,0"><TextBlock Text="{Binding SaveState}" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="In thử sử dụng 1 bản để kiểm tra cấu hình." Style="{StaticResource Hint}" FontSize="11" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="TestButton" Content="Lưu và in thử" Command="{Binding SaveAndTestCommand}" Style="{StaticResource Secondary}" Margin="0,0,8,0"/><Button x:Name="SaveButton" Content="Lưu cấu hình" Command="{Binding SaveCommand}" Style="{StaticResource Action}"/></StackPanel></Grid></Border>
   </Grid></Border>
  </Grid>
  <TextBlock Grid.Row="2" Text="Danh sách máy in lấy từ Windows. Việc phát hiện máy không xác nhận tình trạng giấy, mực hoặc kết nối thực tế." Style="{StaticResource Hint}" FontSize="11" Margin="0,10,0,0"/>
 </Grid>
</UserControl>
