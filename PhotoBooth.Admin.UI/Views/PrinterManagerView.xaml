<UserControl x:Class="PhotoBooth.Admin.UI.Views.PrinterManagerView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,12"><TextBlock Text="Printer Manager" Style="{StaticResource PageTitle}"/><Button Content="Quét lại" Command="{Binding ScanCommand}" DockPanel.Dock="Right"/></DockPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Card}" Margin="0,0,8,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Máy in Windows đang quét được" Style="{StaticResource SectionTitle}"/><ListBox Grid.Row="1" ItemsSource="{Binding Printers}" SelectedItem="{Binding SelectedPrinter}" Margin="0,8"><ListBox.ItemTemplate><DataTemplate><Border Background="#252526" CornerRadius="8" Padding="12" Margin="3"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding ConnectionType}" Foreground="#AAA"/><TextBlock Text="{Binding PortName}" Foreground="#888"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox><Button Grid.Row="2" Content="Kết nối" Command="{Binding ConnectCommand}" Margin="0,8,0,0"/><TextBlock Grid.Row="3" Margin="4,10,4,0" Text="{Binding PrinterStatus}" Foreground="#4CAF50"/></Grid></Border>
   <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0"><ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="0,0,8,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,10"><TextBlock Text="Profile Settings" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding EditingProfile.PrinterName}" FontSize="18" FontWeight="SemiBold"/></StackPanel>
    <StackPanel Grid.Row="1" Margin="0,0,0,10"><TextBlock Text="Paper Size"/><ComboBox ItemsSource="{Binding PaperSizes}" SelectedItem="{Binding EditingProfile.PaperSize}"/></StackPanel>
    <StackPanel Grid.Row="2" Margin="0,0,0,10"><TextBlock Text="Paper Source / Type"/><ComboBox ItemsSource="{Binding PaperTypes}" SelectedItem="{Binding EditingProfile.PaperType}"/></StackPanel>
    <StackPanel Grid.Row="3" Margin="0,0,0,10"><TextBlock Text="Quality / Resolution"/><ComboBox ItemsSource="{Binding Qualities}" SelectedItem="{Binding EditingProfile.Quality}"/></StackPanel>
    <StackPanel Grid.Row="4" Margin="0,0,0,14"><TextBlock Text="Copies"/><ComboBox ItemsSource="{Binding Copies}" SelectedItem="{Binding EditingProfile.DefaultCopies}"/></StackPanel>
    <Border Grid.Row="5" BorderBrush="#505054" BorderThickness="0,1,0,0" Padding="0,12,0,0"><StackPanel>
     <CheckBox Content="Landscape" IsChecked="{Binding EditingProfile.Landscape}" Foreground="White" Height="30" VerticalContentAlignment="Center" Margin="0,0,0,4"/>
     <CheckBox Content="In màu" IsChecked="{Binding EditingProfile.PrintInColor}" Foreground="White" Height="30" VerticalContentAlignment="Center" Margin="0,0,0,4"/>
     <CheckBox Content="Dùng lề mặc định của Windows (bỏ chọn = in không viền)" IsChecked="{Binding EditingProfile.UseDefaultBorder}" Foreground="White" Height="30" VerticalContentAlignment="Center" Margin="0,0,0,4"/>
     <CheckBox Content="Đặt làm máy in mặc định" IsChecked="{Binding EditingProfile.IsDefault}" Foreground="White" Height="30" VerticalContentAlignment="Center" Margin="0,0,0,4"/>
    </StackPanel></Border>
    <WrapPanel Grid.Row="6" Margin="0,14,0,0"><Button Content="Lưu" Command="{Binding SaveCommand}" Margin="0,0,8,0"/><Button Content="Lưu và in thử" Command="{Binding SaveAndTestCommand}" Background="#4CAF50"/></WrapPanel>
    <TextBlock Grid.Row="7" Text="{Binding Message}" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#FFB74D"/>
   </Grid></ScrollViewer></Border>
  </Grid>
 </Grid>
</UserControl>
