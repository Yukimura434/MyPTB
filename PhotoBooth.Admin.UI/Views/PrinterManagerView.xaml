<UserControl x:Class="PhotoBooth.Admin.UI.Views.PrinterManagerView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource BackgroundBrush}">
 <UserControl.Resources>
  <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Foreground" Value="#A5A6AE"/><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="3,5,3,3"/></Style>
  <Style x:Key="Secondary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#45454B"/></Style>
 </UserControl.Resources>
 <Grid Margin="28,24,28,28">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Máy in" FontSize="28" FontWeight="Bold"/><TextBlock Text="Kết nối, cấu hình và kiểm tra máy in dùng cho PhotoBooth." Foreground="#A9AAB1" FontFamily="Segoe UI" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Border Background="#263D64" CornerRadius="15" Padding="11,5" Margin="0,0,9,0"><TextBlock Text="{Binding PrinterSummary}" Foreground="#BDD4FF" FontSize="11"/></Border><Button Content="↻ Quét lại" Command="{Binding ScanCommand}" Style="{StaticResource Secondary}" Margin="0" Padding="16,9"/></StackPanel></Grid>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="380"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*" MinWidth="520"/></Grid.ColumnDefinitions>

   <!-- Discovered printers -->
   <Border Background="{StaticResource CardBrush}" CornerRadius="12"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="18,17,18,12"><TextBlock Text="Máy in khả dụng" FontSize="18" FontWeight="Bold"/><TextBlock Text="Được phát hiện từ Windows" Foreground="#92939B" FontFamily="Segoe UI" FontSize="12" Margin="0,4,0,0"/></StackPanel>
    <ListBox Grid.Row="1" ItemsSource="{Binding Printers}" SelectedItem="{Binding SelectedPrinter}" Margin="10,0"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,7"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Box" Background="#252529" CornerRadius="9" Padding="13,12" BorderBrush="Transparent" BorderThickness="1"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Background" Value="#34343A"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Box" Property="Background" Value="#263D64"/><Setter TargetName="Box" Property="BorderBrush" Value="#4F8CFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="34" Height="34" CornerRadius="17" Background="#37373E"><TextBlock Text="&#xE749;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#D7D8DF"/></Border><StackPanel Grid.Column="1" Margin="10,0"><TextBlock Text="{Binding Name}" FontSize="15" TextAlignment="Left" TextTrimming="CharacterEllipsis"/><TextBlock Foreground="#92939B" FontFamily="Segoe UI" FontSize="11" TextAlignment="Left" Margin="0,5,0,0"><Run Text="{Binding ConnectionType,Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding PortName,Mode=OneWay}"/></TextBlock></StackPanel><Border Grid.Column="2" Background="#245B46" CornerRadius="10" Padding="8,3" VerticalAlignment="Top"><Border.Style><Style TargetType="Border"><Setter Property="Opacity" Value="0.35"/><Style.Triggers><DataTrigger Binding="{Binding IsOnline}" Value="True"><Setter Property="Opacity" Value="1"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="ONLINE" Foreground="#9BE2BE" FontSize="9"/></Border></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
    <Border Grid.Row="2" BorderBrush="#3C3C40" BorderThickness="0,1,0,0" Padding="15"><StackPanel><Button Content="Kết nối máy đã chọn" Command="{Binding ConnectCommand}" Margin="0,0,0,10"/><Border Background="#242428" CornerRadius="8" Padding="11,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Ellipse Width="8" Height="8" Fill="#66C98D" Margin="0,0,9,0"/><TextBlock Grid.Column="1" Text="{Binding PrinterStatus}" Foreground="#C8C9D0" FontFamily="Segoe UI" FontSize="12" TextAlignment="Left" TextWrapping="Wrap"/></Grid></Border></StackPanel></Border>
   </Grid></Border>

   <!-- Profile configuration -->
   <Border Grid.Column="2" Background="{StaticResource CardBrush}" CornerRadius="12"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="20,18,20,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Cấu hình in" FontSize="18" FontWeight="Bold"/><TextBlock Text="{Binding EditingProfile.PrinterName,TargetNullValue=Kết nối máy in để bắt đầu cấu hình}" Foreground="#92939B" FontFamily="Segoe UI" FontSize="12" Margin="0,4,0,0"/></StackPanel><Border Grid.Column="1" Background="#245B46" CornerRadius="11" Padding="10,4" Visibility="{Binding EditingProfile.IsDefault,Converter={StaticResource BoolVisibility}}"><TextBlock Text="MÁY IN MẶC ĐỊNH" Foreground="#9BE2BE" FontSize="10"/></Border></Grid>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" IsEnabled="{Binding HasEditingProfile}"><StackPanel Margin="20,0,20,8">
     <Border Background="#242428" CornerRadius="9" Padding="14" Margin="0,0,0,15"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="KẾT NỐI" Foreground="#85868E" FontSize="10"/><TextBlock Text="{Binding SelectedPrinter.ConnectionType,TargetNullValue=—}" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="HỖ TRỢ MÀU" Foreground="#85868E" FontSize="10"/><TextBlock Text="{Binding SelectedPrinter.SupportsColor}" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="IN HAI MẶT" Foreground="#85868E" FontSize="10"/><TextBlock Text="{Binding SelectedPrinter.SupportsDuplex}" Margin="0,4,0,0"/></StackPanel></Grid></Border>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="Khổ giấy" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding PaperSizes}" SelectedItem="{Binding EditingProfile.PaperSize}" Margin="0,0,0,11"/><TextBlock Text="Chất lượng / độ phân giải" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding Qualities}" SelectedItem="{Binding EditingProfile.Quality}" Margin="0,0,0,11"/></StackPanel>
      <StackPanel Grid.Column="2"><TextBlock Text="Nguồn / loại giấy" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding PaperTypes}" SelectedItem="{Binding EditingProfile.PaperType}" Margin="0,0,0,11"/><TextBlock Text="Số bản mặc định" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding Copies}" SelectedItem="{Binding EditingProfile.DefaultCopies}" Margin="0,0,0,11"/></StackPanel>
     </Grid>
     <Border BorderBrush="#3C3C40" BorderThickness="0,1,0,0" Margin="0,4,0,0" Padding="0,15,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><CheckBox Content="In ngang (Landscape)" IsChecked="{Binding EditingProfile.Landscape}" Foreground="White" Height="32"/><CheckBox Content="In màu" IsChecked="{Binding EditingProfile.PrintInColor}" Foreground="White" Height="32"/></StackPanel><StackPanel Grid.Column="1"><CheckBox Content="Dùng lề mặc định Windows" IsChecked="{Binding EditingProfile.UseDefaultBorder}" Foreground="White" Height="32"/><CheckBox Content="Đặt làm máy in mặc định" IsChecked="{Binding EditingProfile.IsDefault}" Foreground="White" Height="32"/></StackPanel></Grid></Border>
     <TextBlock Text="Tắt “Dùng lề mặc định Windows” để ưu tiên in không viền khi driver hỗ trợ." Foreground="#85868E" FontFamily="Segoe UI" FontSize="11" TextAlignment="Left" Margin="3,13,3,0" TextWrapping="Wrap"/>
    </StackPanel></ScrollViewer>
    <Border Grid.Row="2" BorderBrush="#3C3C40" BorderThickness="0,1,0,0" Padding="16,13"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Background="#3A321F" BorderBrush="#6A582B" BorderThickness="1" CornerRadius="7" Padding="10,8" Margin="0,0,12,0" Visibility="{Binding HasMessage,Converter={StaticResource BoolVisibility}}"><TextBlock Text="{Binding Message}" Foreground="#FFD98A" FontFamily="Segoe UI" FontSize="12" TextWrapping="Wrap" TextAlignment="Left"/></Border><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Lưu cấu hình" Command="{Binding SaveCommand}" Style="{StaticResource Secondary}" Margin="0,0,8,0"/><Button Content="Lưu và in thử" Command="{Binding SaveAndTestCommand}" Background="#267454" Margin="0"/></StackPanel></Grid></Border>
   </Grid></Border>
  </Grid>
 </Grid>
</UserControl>
