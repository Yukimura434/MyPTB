<UserControl x:Class="PhotoBooth.Admin.UI.Views.DeviceEnrollmentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}"
             Foreground="{StaticResource TextBrush}">
    <UserControl.Resources>
        <Style x:Key="StepNumber" TargetType="Border">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="LocationItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="SelectionBorder" Padding="16" CornerRadius="10"
                                Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SelectionBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="SelectionBorder" Property="Background" Value="{StaticResource AccentSubtleBrush}"/>
                                <Setter TargetName="SelectionBorder" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}"/>
                                <Setter TargetName="SelectionBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="SelectionBorder" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="SelectionBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="32,24" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Thiết lập thiết bị" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Kết nối an toàn máy này với đúng cửa hàng trước khi nhân viên đăng nhập."
                               Style="{StaticResource PageSubtitle}"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Dùng kết nối đã lưu" Margin="20,4,0,4"
                        Style="{StaticResource AdminSecondaryButton}"
                        Command="{Binding ShowSavedProfilesCommand}"
                        Visibility="{Binding HasProfiles,Converter={StaticResource BoolVisibility}}"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="32,28" MaxWidth="1180" HorizontalAlignment="Center">
                <Grid Visibility="{Binding ShowWizard,Converter={StaticResource BoolVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*" MinWidth="330"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="220"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,4,0,0">
                        <TextBlock Text="TIẾN TRÌNH" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,18"/>

                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border>
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource StepNumber}">
                                        <Style.Triggers><DataTrigger Binding="{Binding IsVerifyOwnerStep}" Value="True"><Setter Property="Background" Value="{StaticResource AccentBrush}"/><Setter Property="BorderBrush" Value="{StaticResource AccentHoverBrush}"/></DataTrigger></Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="1" HorizontalAlignment="Center" FontWeight="Bold"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="4,1,0,0">
                                <TextBlock Text="Xác minh chủ tài khoản" FontWeight="SemiBold"/>
                                <TextBlock Text="Đăng nhập một lần" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Border Width="1" Height="18" Margin="14,-16,0,2" HorizontalAlignment="Left" Background="{StaticResource BorderStrongBrush}"/>
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border>
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource StepNumber}">
                                        <Style.Triggers><DataTrigger Binding="{Binding IsChooseLocationStep}" Value="True"><Setter Property="Background" Value="{StaticResource AccentBrush}"/><Setter Property="BorderBrush" Value="{StaticResource AccentHoverBrush}"/></DataTrigger></Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="2" HorizontalAlignment="Center" FontWeight="Bold"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="4,1,0,0">
                                <TextBlock Text="Chọn cửa hàng" FontWeight="SemiBold"/>
                                <TextBlock Text="Đặt đúng vị trí máy" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Border Width="1" Height="18" Margin="14,-16,0,2" HorizontalAlignment="Left" Background="{StaticResource BorderStrongBrush}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border>
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource StepNumber}">
                                        <Style.Triggers><DataTrigger Binding="{Binding IsCompleteStep}" Value="True"><Setter Property="Background" Value="#287A52"/><Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}"/></DataTrigger></Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="3" HorizontalAlignment="Center" FontWeight="Bold"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="4,1,0,0">
                                <TextBlock Text="Hoàn tất" FontWeight="SemiBold"/>
                                <TextBlock Text="Sẵn sàng đăng nhập" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <Grid Grid.Column="2">
                        <Border Style="{StaticResource Card}" Margin="0" Padding="28"
                                Visibility="{Binding IsVerifyOwnerStep,Converter={StaticResource BoolVisibility}}">
                            <StackPanel>
                                <TextBlock Text="Xác minh chủ tài khoản" FontSize="22" FontWeight="SemiBold"/>
                                <TextBlock Text="Thông tin đăng nhập chỉ được dùng để xác minh trong bước này và không lưu trên máy."
                                           Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,7,0,22"/>
                                <TextBlock Text="Email chủ tài khoản" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding OwnerEmail,UpdateSourceTrigger=PropertyChanged}" MaxLength="320"
                                         MinHeight="44" AutomationProperties.Name="Email chủ tài khoản"/>
                                <TextBlock Text="Mật khẩu" Style="{StaticResource FieldLabel}" Margin="4,12,4,3"/>
                                <PasswordBox x:Name="ActivationPassword" PasswordChanged="ActivationPassword_PasswordChanged"
                                             MaxLength="128" MinHeight="44" AutomationProperties.Name="Mật khẩu chủ tài khoản"/>
                                <Border Background="{StaticResource AccentSubtleBrush}" CornerRadius="8" Padding="12" Margin="4,18,4,18">
                                    <TextBlock Text="Sau khi xác minh, ứng dụng sẽ hiển thị danh sách cửa hàng bằng tên để bạn chọn."
                                               Foreground="#C7D9FF" TextWrapping="Wrap" FontSize="12"/>
                                </Border>
                                <Button Content="Tiếp tục" Command="{Binding VerifyOwnerCommand}" Height="44" Margin="4,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0" Padding="28"
                                Visibility="{Binding IsChooseLocationStep,Converter={StaticResource BoolVisibility}}">
                            <StackPanel>
                                <Border Background="{StaticResource SuccessSubtleBrush}" BorderBrush="#397A59" BorderThickness="1"
                                        CornerRadius="8" Padding="12" Margin="0,0,0,20">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource Icon.Check}" Style="{StaticResource VectorIcon}"
                                              Width="18" Height="18" Stroke="{StaticResource SuccessBrush}" Margin="0,0,10,0"/>
                                        <StackPanel>
                                            <TextBlock Text="Đã xác minh" FontWeight="SemiBold" Foreground="#BFF3D4"/>
                                            <TextBlock Text="{Binding VerifiedOwnerSummary}" Foreground="#A8DABB" FontSize="12" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="Chọn cửa hàng đặt thiết bị" FontSize="22" FontWeight="SemiBold"/>
                                <TextBlock Text="Thiết bị sẽ nhận cấu hình và dữ liệu của cửa hàng được chọn."
                                           Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,7,0,18"/>
                                <ListBox ItemsSource="{Binding Locations}" SelectedItem="{Binding SelectedLocation}"
                                         ItemContainerStyle="{StaticResource LocationItem}" MaxHeight="250">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15"/>
                                                    <TextBlock Text="Cửa hàng đang hoạt động" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0"/>
                                                </StackPanel>
                                                <Path Grid.Column="1" Data="{StaticResource Icon.Check}" Style="{StaticResource VectorIcon}"
                                                      Width="18" Height="18" Stroke="{StaticResource SuccessBrush}" Margin="14,0,0,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Text="Tên thiết bị" Style="{StaticResource FieldLabel}" Margin="4,8,4,3"/>
                                <TextBox Text="{Binding DeviceName,UpdateSourceTrigger=PropertyChanged}" MaxLength="120" MinHeight="44"
                                         AutomationProperties.Name="Tên thiết bị"/>
                                <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Button Content="Quay lại" Command="{Binding BackCommand}" Style="{StaticResource AdminSecondaryButton}" Margin="4,0,10,0"/>
                                    <Button Grid.Column="1" Content="Kết nối thiết bị" Command="{Binding ActivateCommand}" Height="44" Margin="0"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0" Padding="32"
                                Visibility="{Binding IsCompleteStep,Converter={StaticResource BoolVisibility}}">
                            <StackPanel HorizontalAlignment="Center" MaxWidth="430">
                                <Border Width="68" Height="68" CornerRadius="34" Background="{StaticResource SuccessSubtleBrush}"
                                        BorderBrush="#397A59" BorderThickness="1" Margin="0,8,0,18">
                                    <Path Data="{StaticResource Icon.Check}" Style="{StaticResource VectorIcon}"
                                          Width="30" Height="30" Stroke="{StaticResource SuccessBrush}"
                                          StrokeThickness="2.2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Thiết bị đã sẵn sàng" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="Nhân viên có thể đăng nhập và bắt đầu làm việc trên máy này."
                                           Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,22"/>
                                <Border Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="9" Padding="16" Margin="0,0,0,18">
                                    <StackPanel>
                                        <TextBlock Text="Kết nối đang dùng" FontSize="11" Foreground="{StaticResource MutedTextBrush}"/>
                                        <TextBlock Text="{Binding DeviceStatusDetail}" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <Button Content="Thiết lập kết nối khác" Command="{Binding StartNewConnectionCommand}"
                                        Style="{StaticResource AdminSecondaryButton}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource DangerSubtleBrush}" BorderBrush="#8A4651" BorderThickness="1"
                                CornerRadius="8" Padding="12" Margin="0,14,0,0" VerticalAlignment="Bottom"
                                Visibility="{Binding HasError,Converter={StaticResource BoolVisibility}}">
                            <TextBlock Text="{Binding Error}" Foreground="#FFD5D9" TextWrapping="Wrap"
                                       AutomationProperties.LiveSetting="Assertive"/>
                        </Border>
                    </Grid>

                    <Border Grid.Column="4" Style="{StaticResource Card}" Margin="0" Padding="20" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="TRẠNG THÁI MÁY NÀY" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}"/>
                            <TextBlock Text="{Binding DeviceStatusTitle}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,0"/>
                            <TextBlock Text="{Binding DeviceStatusDetail}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,6,0,14"/>
                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,14"/>
                            <TextBlock Text="{Binding Status}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" FontSize="12"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Style="{StaticResource Card}" Margin="0" Padding="28" MaxWidth="760" HorizontalAlignment="Center"
                        Visibility="{Binding ShowSavedProfiles,Converter={StaticResource BoolVisibility}}">
                    <StackPanel>
                        <TextBlock Text="Kết nối đã lưu trên máy này" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock Text="Chọn đúng cửa hàng để chuyển hồ sơ đang dùng. Không cần nhập lại tài khoản chủ."
                                   Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,7,0,20"/>
                        <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                                 ItemContainerStyle="{StaticResource LocationItem}" MaxHeight="360">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding LocationName}" FontSize="16" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding DeviceName}" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0"/>
                                            <TextBlock Text="{Binding OrganizationName}" FontSize="12" Foreground="{StaticResource FaintTextBrush}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{StaticResource SuccessSubtleBrush}" CornerRadius="12" Padding="9,4" VerticalAlignment="Center">
                                            <TextBlock Text="Đã lưu" FontSize="11" Foreground="#BFF3D4"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Button Content="Kết nối mới" Command="{Binding StartNewConnectionCommand}"
                                    Style="{StaticResource AdminSecondaryButton}" Margin="0,0,10,0"/>
                            <Button Grid.Column="1" Content="Dùng kết nối đã chọn" Command="{Binding SelectProfileCommand}" Height="44" Margin="0"
                                    Visibility="{Binding ShowProfileSwitchAction,Converter={StaticResource BoolVisibility}}"/>
                        </Grid>
                        <Border Background="{StaticResource WarningSubtleBrush}" BorderBrush="#7F6234" BorderThickness="1"
                                CornerRadius="9" Padding="14" Margin="0,14,0,0"
                                Visibility="{Binding ShowProfileSwitchConfirmation,Converter={StaticResource BoolVisibility}}">
                            <StackPanel>
                                <TextBlock Text="Xác nhận chuyển kết nối" FontWeight="SemiBold" Foreground="#FFDCA8"/>
                                <TextBlock Text="{Binding SelectedProfileSummary,StringFormat=Ứng dụng sẽ chuyển sang {0}.}"
                                           Foreground="#F4D5A6" TextWrapping="Wrap" FontSize="12" Margin="0,5,0,12"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Hủy" Command="{Binding CancelProfileSwitchCommand}"
                                            Style="{StaticResource AdminSecondaryButton}" Margin="0,0,8,0"/>
                                    <Button Content="Xác nhận chuyển" Command="{Binding ConfirmProfileCommand}" Margin="0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource DangerSubtleBrush}" BorderBrush="#8A4651" BorderThickness="1"
                                CornerRadius="8" Padding="12" Margin="0,14,0,0"
                                Visibility="{Binding HasError,Converter={StaticResource BoolVisibility}}">
                            <TextBlock Text="{Binding Error}" Foreground="#FFD5D9" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <Border Grid.RowSpan="2" Background="#990F1117"
                Visibility="{Binding IsBusy,Converter={StaticResource BoolVisibility}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="180" Height="5"/>
                <TextBlock Text="Đang xử lý…" Margin="0,14,0,0" FontWeight="SemiBold"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
