<UserControl x:Class="PhotoBooth.Admin.UI.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:color="clr-namespace:PhotoBooth.Color.D3D11;assembly=PhotoBooth.Color.D3D11">
    <Grid Margin="28,22,28,26">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <Grid Margin="4,0,4,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Tổng quan vận hành" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Kiểm tra camera, sự kiện và thông số phiên chụp trước khi mở chế độ khách." Style="{StaticResource PageSubtitle}"/>
            </StackPanel>
            <Border Grid.Column="1" Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="13,8" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" Margin="0,0,8,0"/><TextBlock Text="{Binding ConnectionStatus}" Foreground="{StaticResource MutedTextBrush}"/></StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="13*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="7*" MinWidth="390"/></Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Margin="0" Padding="0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Background="{StaticResource SurfaceBrush}" Margin="1" Height="58">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="18,0" VerticalAlignment="Center">
                            <TextBlock Text="Live view" FontSize="17" FontWeight="SemiBold"/>
                            <Border Background="{StaticResource AccentSubtleBrush}" CornerRadius="10" Padding="8,3" Margin="10,0,0,0"><TextBlock Text="CAMERA" Foreground="#BFD3FF" FontSize="10" FontWeight="SemiBold"/></Border>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Margin="0,0,18,0" Foreground="{StaticResource MutedTextBrush}">
                            <Run Text="FPS "/><Run Text="{Binding CurrentFps,Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding Resolution,Mode=OneWay}"/>
                        </TextBlock>
                    </Grid>
                    <Grid Grid.Row="1" Background="#090B0F">
                        <TextBlock Text="Kết nối camera để bắt đầu Live View" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource FaintTextBrush}" FontSize="17"/>
                        <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid Width="1200" Height="900">
                                <Grid.LayoutTransform><TransformGroup><ScaleTransform ScaleX="{Binding LiveViewScaleX}"/><RotateTransform Angle="{Binding LiveViewRotation}"/></TransformGroup></Grid.LayoutTransform>
                                <color:LatestJpegImage FrameData="{Binding LiveImage}" FramePresented="OnLiveFramePresented" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Viewbox>
                    </Grid>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel IsEnabled="{Binding IsCameraControlsEnabled}">
                            <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Kết nối camera" Style="{StaticResource SectionTitle}" Margin="0"/><TextBlock Grid.Column="1" Text="{Binding ConnectionStatus}" Foreground="{StaticResource SuccessBrush}"/></Grid>
                            <TextBlock Text="Thiết bị" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding Cameras}" SelectedItem="{Binding SelectedCamera}" Margin="0,0,0,8"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding FriendlyName}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Button Content="Lấy nét" Command="{Binding FocusCommand}" Style="{StaticResource AdminSecondaryButton}" Margin="0,0,6,0"/>
                                <Button Grid.Column="1" Content="{Binding ConnectionActionText}" Command="{Binding ConnectCommand}" Margin="0,0,6,0"/>
                                <Button Grid.Column="2" Content="Ngắt kết nối" Command="{Binding DisconnectCommand}" Style="{StaticResource AdminDangerButton}" Margin="0"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Sự kiện đang vận hành" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Chọn sự kiện" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding AvailableEvents}" SelectedItem="{Binding SelectedEvent,Mode=TwoWay}" IsEditable="False" Margin="0,0,0,7">
                                <ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsEventDraft}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ComboBox.Style>
                                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBox Text="{Binding EventName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" ToolTip="Nhập tên sự kiện" Margin="0,0,0,7"><TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsEventDraft}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBox.Style></TextBox>
                            <TextBlock Text="Thư mục lưu ảnh" Style="{StaticResource FieldLabel}"/>
                            <Grid Margin="0,0,0,9"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding EventLocation,Mode=OneWay}" IsReadOnly="True" ToolTip="{Binding EventLocation}" Margin="0,0,7,0"/><Button Grid.Column="1" Content="Chọn…" Command="{Binding ChooseEventLocationCommand}" IsEnabled="{Binding IsEventDraft}" Style="{StaticResource AdminSecondaryButton}" Margin="0"/></Grid>
                            <WrapPanel><Button Content="{Binding EventActionText}" Command="{Binding NewEventCommand}"/><Button Content="Áp dụng sự kiện" Command="{Binding SetDefaultEventCommand}" Style="{StaticResource AdminSuccessButton}"/><Button Content="Hủy" Command="{Binding CancelEventCommand}" IsEnabled="{Binding IsEventDraft}" Style="{StaticResource AdminSecondaryButton}"/></WrapPanel>
                            <TextBlock Text="{Binding LastCapture}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource MutedTextBrush}" Margin="4,6,4,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Thông số phiên chụp" Style="{StaticResource SectionTitle}"/>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <StackPanel><TextBlock Text="Số ảnh" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding PhotoCounts}" SelectedItem="{Binding PhotoCount,Mode=TwoWay}" Margin="0"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Đếm ngược" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding Countdowns}" SelectedItem="{Binding Countdown,Mode=TwoWay}" Margin="0"/></StackPanel>
                                <StackPanel Grid.Row="1" Margin="0,8,0,0"><TextBlock Text="Thời lượng mỗi ảnh GIF" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding GifDurationOptions}" SelectedItem="{Binding GifDuration,Mode=TwoWay}" Margin="0"/></StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,8,0,0"><TextBlock Text="Thời gian màn hình chờ" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding WaitingTimeoutOptions}" SelectedItem="{Binding WaitingTimeout,Mode=TwoWay}" Margin="0"/></StackPanel>
                            </Grid>
                            <TextBlock Text="Lưu ảnh" Style="{StaticResource FieldLabel}" Margin="4,14,4,3"/><ComboBox ItemsSource="{Binding SaveLocationOptions}" SelectedItem="{Binding SaveLocation,Mode=TwoWay}" Margin="0,0,0,9"/>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel><CheckBox Content="Tự động lật ảnh" IsChecked="{Binding AutoFlip,Mode=TwoWay}" Margin="4,7"/><CheckBox Content="Màn hình khách dọc" IsChecked="{Binding UsePortraitCustomer,Mode=TwoWay}" Margin="4,7"/></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock Text="Xoay ảnh" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding ImageRotationOptions}" SelectedItem="{Binding ImageRotation,Mode=TwoWay}" Margin="0"/></StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0">
                        <Expander IsExpanded="False" IsEnabled="{Binding IsCameraControlsEnabled}">
                            <Expander.Header><TextBlock Text="Điều khiển camera nâng cao" FontSize="16" FontWeight="SemiBold" Margin="2,5"/></Expander.Header>
                            <StackPanel Margin="0,12,0,0">
                                <Button Content="Chụp thử" Command="{Binding TestCaptureCommand}" Style="{StaticResource AdminSuccessButton}" HorizontalAlignment="Left" Margin="0,0,0,10"/>
                                <ItemsControl ItemsSource="{Binding CameraProperties}"><ItemsControl.ItemTemplate><DataTemplate>
                                    <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Label}" Foreground="{StaticResource MutedTextBrush}"/>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding Values}" SelectedItem="{Binding SelectedValue,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsHitTestVisible="{Binding IsEnabled}" Focusable="{Binding IsEnabled}" Margin="0">
                                            <ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsDisplayOnly}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ComboBox.Style>
                                        </ComboBox>
                                        <Border Grid.Column="1" Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8">
                                            <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsDisplayOnly}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                            <TextBlock Text="{Binding SelectedValue,TargetNullValue=—}" TextTrimming="CharacterEllipsis"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            </StackPanel>
                        </Expander>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
