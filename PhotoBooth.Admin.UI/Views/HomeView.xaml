<UserControl x:Class="PhotoBooth.Admin.UI.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:color="clr-namespace:PhotoBooth.Color.D3D11;assembly=PhotoBooth.Color.D3D11">
    <UserControl.Resources>
        <Style x:Key="SummaryLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="SummaryValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,22,28,26">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Margin="4,0,4,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Tổng quan vận hành" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Kết nối camera, kiểm tra lưu trữ và thông số lượt chụp." Style="{StaticResource PageSubtitle}"/>
            </StackPanel>
            <Border Grid.Column="1" Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="9" Padding="13,8" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" Margin="0,0,8,0"/><TextBlock Text="{Binding ConnectionStatus}" Foreground="{StaticResource MutedTextBrush}"/></StackPanel>
            </Border>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid x:Name="BoothLayout">
            <Grid.ColumnDefinitions><ColumnDefinition Width="13*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="7*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border x:Name="CameraCard" VerticalAlignment="Top" Style="{StaticResource Card}" Height="580" Margin="0" Padding="0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Background="{StaticResource SurfaceBrush}" Margin="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="18,0" VerticalAlignment="Center">
                            <Path Data="{StaticResource Icon.Camera}" Style="{StaticResource VectorIcon}" Width="22" Height="22" Stroke="#BFD3FF"/>
                            <TextBlock Text="Live view" FontSize="17" FontWeight="SemiBold" Margin="10,0,0,0"/>
                            <Border Background="{StaticResource AccentSubtleBrush}" CornerRadius="10" Padding="8,3" Margin="10,0,0,0"><TextBlock Text="CAMERA" Foreground="#BFD3FF" FontSize="10" FontWeight="SemiBold"/></Border>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Margin="0,0,18,0" Foreground="{StaticResource MutedTextBrush}"><Run Text="FPS "/><Run Text="{Binding CurrentFps,Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding Resolution,Mode=OneWay}"/></TextBlock>
                    </Grid>
                    <Grid Grid.Row="1" Background="#090B0F">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="{StaticResource Icon.Camera}" Style="{StaticResource VectorIcon}" Width="52" Height="52" Stroke="#5F6E84" StrokeThickness="1.5" HorizontalAlignment="Center"/>
                            <TextBlock Text="Kết nối camera để bắt đầu Live View" Foreground="{StaticResource FaintTextBrush}" FontSize="17" Margin="0,14,0,0"/>
                        </StackPanel>
                        <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid Width="1200" Height="900">
                                <Grid.LayoutTransform><TransformGroup><ScaleTransform ScaleX="{Binding LiveViewScaleX}"/><RotateTransform Angle="{Binding LiveViewRotation}"/></TransformGroup></Grid.LayoutTransform>
                                <color:LatestJpegImage ColorPreset="{Binding LivePreset}" FrameData="{Binding LiveImage}" FramePresented="OnLiveFramePresented" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Viewbox>
                    </Grid>
                </Grid>
            </Border>

            <Border x:Name="BoothControls" Grid.Column="2">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel IsEnabled="{Binding IsCameraControlsEnabled}">
                            <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Path Data="{StaticResource Icon.Camera}" Style="{StaticResource VectorIcon}" Width="20" Height="20" Stroke="#9FC0FF"/>
                                <TextBlock Grid.Column="1" Text="Kết nối camera" Style="{StaticResource SectionTitle}" Margin="10,0,0,0"/>
                                <TextBlock Grid.Column="2" Text="{Binding ConnectionStatus}" Foreground="{StaticResource SuccessBrush}"/>
                            </Grid>
                            <TextBlock Text="Thiết bị" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding Cameras}" SelectedItem="{Binding SelectedCamera}" Margin="0,0,0,8"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding FriendlyName}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Button Content="Lấy nét" Command="{Binding FocusCommand}" Style="{StaticResource AdminSecondaryButton}" Margin="0,0,6,0"/>
                                <Button Grid.Column="1" Content="{Binding ConnectionActionText}" Command="{Binding ConnectCommand}" Margin="0,0,6,0"/>
                                <Button Grid.Column="2" Content="Ngắt kết nối" Command="{Binding DisconnectCommand}" Style="{StaticResource AdminDangerButton}" Margin="0"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12"><StackPanel>
                      <TextBlock Text="Vận hành booth" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                      <TextBlock Text="Thông số lượt chụp" FontWeight="SemiBold" Margin="0,0,0,8"/>
                      <UniformGrid Columns="2" IsEnabled="{Binding CanEditBooth}">
                       <StackPanel Margin="0,0,6,10"><TextBlock Text="Số ảnh" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding PhotoCounts}" SelectedItem="{Binding PhotoCount}"/></StackPanel>
                       <StackPanel Margin="6,0,0,10"><TextBlock Text="Đếm ngược (giây)" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding Countdowns}" SelectedItem="{Binding Countdown}"/></StackPanel>
                       <StackPanel Margin="0,0,6,10"><TextBlock Text="GIF (giây / ảnh)" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding GifDurationOptions}" SelectedItem="{Binding GifDuration}"/></StackPanel>
                       <StackPanel Margin="6,0,0,10"><TextBlock Text="Thời gian chờ" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding WaitingTimeoutOptions}" SelectedItem="{Binding WaitingTimeout}"/></StackPanel>
                       <StackPanel Margin="0,0,6,10"><TextBlock Text="Xoay ảnh (độ)" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding ImageRotationOptions}" SelectedItem="{Binding ImageRotation}"/></StackPanel>
                       <CheckBox Content="Lật ngang" IsChecked="{Binding AutoFlip}" VerticalAlignment="Center" Margin="6,12,0,0"/>
                      </UniformGrid>
                      <WrapPanel Margin="0,4,0,12"><CheckBox Content="Tạo GIF" IsChecked="{Binding CreateGif}" Margin="0,0,24,0"/><CheckBox Content="Tạo video" IsChecked="{Binding CreateVideo}"/></WrapPanel>
                      <TextBlock Text="Thư mục lưu ảnh trên máy" Style="{StaticResource FieldLabel}"/>
                      <TextBlock Text="{Binding WorkingFolder}" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" Margin="0,4,0,8"/>
                      <TextBlock Text="{Binding Storage}" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,8"/>

                      <TextBlock Text="{Binding SettingsMessage}" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,12,0,8"/>
                      <WrapPanel><Button Content="Lưu thay đổi" Command="{Binding SaveBoothCommand}" Margin="0,0,8,0"/><Button Content="Hoàn tác" Command="{Binding RevertBoothCommand}" Style="{StaticResource AdminSecondaryButton}"/></WrapPanel>
                     </StackPanel></Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12"><StackPanel>
                     <TextBlock Text="Thư viện đang sử dụng" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                     <TextBlock Text="{Binding FrameSummary}"/><TextBlock Text="{Binding PresetSummary}" Margin="0,6,0,8"/>
                     <WrapPanel>
                      <Button Content="Frame" Command="{Binding DataContext.NavigateCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="frames" Style="{StaticResource AdminSecondaryButton}" Margin="0,0,8,6"/>
                      <Button Content="Preset màu" Command="{Binding DataContext.NavigateCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="presets" Style="{StaticResource AdminSecondaryButton}" Margin="0,0,8,6"/>
                      <Button Content="Làm đẹp" Command="{Binding DataContext.NavigateCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="beauty" Style="{StaticResource AdminSecondaryButton}" Margin="0,0,0,6"/>
                     </WrapPanel>
                    </StackPanel></Border>
                    <Border Background="#173B2F" BorderBrush="#2C805A" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Width="42" Height="42" Background="#245E47" CornerRadius="21"><Path Data="{StaticResource Icon.Check}" Style="{StaticResource VectorIcon}" Width="23" Height="23" Stroke="#8FE0B4"/></Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock Text="Kiểm tra trước khi chụp" Foreground="#A8EBC5" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Kiểm tra camera và thư viện trước khi mở MiuPhotoBooth." Foreground="#BBD8C8" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0">
                        <Expander IsExpanded="False" IsEnabled="{Binding IsCameraControlsEnabled}">
                            <Expander.Header><TextBlock Text="Điều khiển camera nâng cao" FontSize="16" FontWeight="SemiBold" Margin="2,5"/></Expander.Header>
                            <StackPanel Margin="0,12,0,0">
                                <Button Content="Chụp thử" Command="{Binding TestCaptureCommand}" Style="{StaticResource AdminSuccessButton}" HorizontalAlignment="Left" Margin="0,0,0,10"/>
                                <ItemsControl ItemsSource="{Binding CameraProperties}"><ItemsControl.ItemTemplate><DataTemplate>
                                    <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Label}" Foreground="{StaticResource MutedTextBrush}"/>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding Values}" SelectedItem="{Binding SelectedValue,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsHitTestVisible="{Binding IsEnabled}" Focusable="{Binding IsEnabled}" Margin="0"><ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsDisplayOnly}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ComboBox.Style></ComboBox>
                                        <Border Grid.Column="1" Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsDisplayOnly}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding SelectedValue,TargetNullValue=—}" TextTrimming="CharacterEllipsis"/></Border>
                                    </Grid>
                                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            </StackPanel>
                        </Expander>
                    </Border>
                </StackPanel>
            </Border>
        </Grid></ScrollViewer>
    </Grid>
</UserControl>
