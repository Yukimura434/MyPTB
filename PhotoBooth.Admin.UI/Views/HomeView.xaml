<UserControl x:Class="PhotoBooth.Admin.UI.Views.HomeView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:color="clr-namespace:PhotoBooth.Color.D3D11;assembly=PhotoBooth.Color.D3D11">
 <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="13*"/><ColumnDefinition Width="7*"/></Grid.ColumnDefinitions>
  <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0"><Grid><TextBlock Text="Connect a camera to start Live View" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#888" FontSize="18"/><Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"><Grid Width="1200" Height="900"><Grid.LayoutTransform><TransformGroup><ScaleTransform ScaleX="{Binding LiveViewScaleX}"/><RotateTransform Angle="{Binding LiveViewRotation}"/></TransformGroup></Grid.LayoutTransform><color:LatestJpegImage FrameData="{Binding LiveImage}" FramePresented="OnLiveFramePresented" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Viewbox><StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18" Background="#AA1E1E1E"><TextBlock Text="LIVE VIEW" FontWeight="SemiBold" Foreground="#4F8CFF"/><TextBlock><Run Text="FPS "/><Run Text="{Binding CurrentFps,Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding Resolution,Mode=OneWay}"/></TextBlock></StackPanel></Grid></Border>
  <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel>
   <Border Style="{StaticResource Card}"><StackPanel IsEnabled="{Binding IsCameraControlsEnabled}"><TextBlock Text="Camera Connection" Style="{StaticResource SectionTitle}"/><ComboBox ItemsSource="{Binding Cameras}" SelectedItem="{Binding SelectedCamera}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding FriendlyName}" TextAlignment="Left" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><TextBlock Margin="4"><Run Text="Status: "/><Run Text="{Binding ConnectionStatus,Mode=OneWay}" Foreground="#4CAF50"/></TextBlock><WrapPanel><Button Content="Focus" Command="{Binding FocusCommand}" Background="#4CAF50"/><Button Content="{Binding ConnectionActionText}" Command="{Binding ConnectCommand}"/><Button Content="Disconnect" Command="{Binding DisconnectCommand}"/></WrapPanel></StackPanel></Border>
   <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Sự kiện" Style="{StaticResource SectionTitle}"/><TextBlock Text="Chọn sự kiện vận hành" Margin="0,2,0,2"/><ComboBox ItemsSource="{Binding AvailableEvents}" SelectedItem="{Binding SelectedEvent,Mode=TwoWay}" IsEditable="False"><ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsEventDraft}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ComboBox.Style><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" Foreground="White" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><TextBox Text="{Binding EventName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" ToolTip="Nhập tên sự kiện"><TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsEventDraft}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBox.Style></TextBox><TextBlock Text="Thư mục lưu ảnh" Margin="0,10,0,2"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding EventLocation,Mode=OneWay}" IsReadOnly="True" ToolTip="{Binding EventLocation}"/><Button Grid.Column="1" Content="Chọn…" Command="{Binding ChooseEventLocationCommand}" IsEnabled="{Binding IsEventDraft}" ToolTip="Chỉ có thể chọn thư mục khi tạo Event mới" Margin="8,0,0,0"/></Grid><WrapPanel Margin="0,10,0,0"><Button Content="{Binding EventActionText}" Command="{Binding NewEventCommand}"/><Button Content="Áp dụng event" Command="{Binding SetDefaultEventCommand}"/><Button Content="Hủy" Command="{Binding CancelEventCommand}" IsEnabled="{Binding IsEventDraft}"/></WrapPanel><TextBlock Text="{Binding LastCapture}" TextTrimming="CharacterEllipsis" Foreground="#999" Margin="4,6,4,0"/></StackPanel></Border>
   <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Setting" Style="{StaticResource SectionTitle}"/><TextBlock Text="Vị trí lưu ảnh" Margin="0,4,0,2"/><ComboBox ItemsSource="{Binding SaveLocationOptions}" SelectedItem="{Binding SaveLocation,Mode=TwoWay}"/><CheckBox Content="Tự động lật ảnh" IsChecked="{Binding AutoFlip,Mode=TwoWay}" Margin="0,8,0,0"/></StackPanel></Border>
   <Border Style="{StaticResource Card}"><StackPanel IsEnabled="{Binding IsCameraControlsEnabled}"><TextBlock Text="Camera Control" Style="{StaticResource SectionTitle}"/><Button Content="Test Capture" Command="{Binding TestCaptureCommand}" Background="#4CAF50"/><ItemsControl ItemsSource="{Binding CameraProperties}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="4"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Label}"/><ComboBox Grid.Column="1" ItemsSource="{Binding Values}" SelectedItem="{Binding SelectedValue,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsHitTestVisible="{Binding IsEnabled}" Focusable="{Binding IsEnabled}"><ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsDisplayOnly}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ComboBox.Style></ComboBox><Border Grid.Column="1" Background="#242428" BorderBrush="#4B4B52" BorderThickness="1" CornerRadius="5" Padding="14,8" Margin="4"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsDisplayOnly}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding SelectedValue,TargetNullValue=—}" Foreground="#D7D8DF" TextTrimming="CharacterEllipsis"/></Border></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
  </StackPanel></ScrollViewer>
  <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{StaticResource SurfaceBrush}" CornerRadius="10" Padding="18,10" Margin="8"><WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="Photo Count" Margin="10"/><ComboBox Width="90" ItemsSource="{Binding PhotoCounts}" SelectedItem="{Binding PhotoCount,Mode=TwoWay}"/><TextBlock Text="Countdown" Margin="24,10,10,10"/><ComboBox Width="90" ItemsSource="{Binding Countdowns}" SelectedItem="{Binding Countdown,Mode=TwoWay}"/><TextBlock Text="s" Margin="4"/><TextBlock Text="GIF" Margin="24,10,10,10"/><ComboBox Width="90" ItemsSource="{Binding GifDurationOptions}" SelectedItem="{Binding GifDuration,Mode=TwoWay}"/><TextBlock Text="s" Margin="4"/><TextBlock Text="Màn hình chờ" Margin="24,10,10,10"/><ComboBox Width="100" ItemsSource="{Binding WaitingTimeoutOptions}" SelectedItem="{Binding WaitingTimeout,Mode=TwoWay}"/><Border Width="1" Height="30" Background="#46464C" Margin="22,4,14,4"/><CheckBox Content="Sử dụng màn hình dọc" IsChecked="{Binding UsePortraitCustomer,Mode=TwoWay}" Foreground="White" VerticalAlignment="Center" Margin="8"/><TextBlock Text="Xoay ảnh" Foreground="White" VerticalAlignment="Center" Margin="16,8,8,8"/><ComboBox Width="86" ItemsSource="{Binding ImageRotationOptions}" SelectedItem="{Binding ImageRotation,Mode=TwoWay}"/></WrapPanel></Border>
 </Grid>
</UserControl>
