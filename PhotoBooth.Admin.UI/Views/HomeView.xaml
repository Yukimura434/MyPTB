<UserControl x:Class="PhotoBooth.Admin.UI.Views.HomeView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="13*"/><ColumnDefinition Width="7*"/></Grid.ColumnDefinitions>
  <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0"><Grid><TextBlock Text="Connect a camera to start Live View" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#888" FontSize="18"/><Image Source="{Binding LiveImage,Converter={StaticResource ByteImage}}" Stretch="Uniform" RenderTransformOrigin="0.5,0.5"><Image.RenderTransform><ScaleTransform ScaleX="{Binding LiveViewScaleX}"/></Image.RenderTransform></Image><StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18" Background="#AA1E1E1E"><TextBlock Text="LIVE VIEW" FontWeight="SemiBold" Foreground="#4F8CFF"/><TextBlock><Run Text="FPS "/><Run Text="{Binding CurrentFps,Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding Resolution,Mode=OneWay}"/></TextBlock></StackPanel></Grid></Border>
  <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel>
   <Border Style="{StaticResource Card}"><StackPanel IsEnabled="{Binding IsCameraControlsEnabled}"><TextBlock Text="Camera Connection" Style="{StaticResource SectionTitle}"/><ComboBox ItemsSource="{Binding Cameras}" SelectedItem="{Binding SelectedCamera}" DisplayMemberPath="DisplayName"/><TextBlock Margin="4"><Run Text="Status: "/><Run Text="{Binding ConnectionStatus,Mode=OneWay}" Foreground="#4CAF50"/></TextBlock><WrapPanel><Button Content="Focus" Command="{Binding FocusCommand}" Background="#4CAF50"/><Button Content="{Binding ConnectionActionText}" Command="{Binding ConnectCommand}"/><Button Content="Disconnect" Command="{Binding DisconnectCommand}"/></WrapPanel></StackPanel></Border>
   <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Session" Style="{StaticResource SectionTitle}"/><TextBlock Text="Select session" Margin="0,2,0,2"/><ComboBox ItemsSource="{Binding AvailableSessions}" SelectedItem="{Binding SelectedSession,Mode=TwoWay}" IsEditable="False"><ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsSessionDraft}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ComboBox.Style><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding SessionName}" Foreground="White"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><ComboBox Text="{Binding SessionName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsEditable="True" IsDropDownOpen="False"><ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsSessionDraft}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ComboBox.Style></ComboBox><TextBlock Text="Location" Margin="0,10,0,2"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding SessionLocation,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/><Button Grid.Column="1" Content="..." Command="{Binding ChooseSessionLocationCommand}" MinWidth="36" Margin="8,0,0,0"/></Grid><WrapPanel Margin="0,10,0,0"><Button Content="{Binding SessionActionText}" Command="{Binding NewSessionCommand}"/><Button Content="Set default" Command="{Binding SetDefaultSessionCommand}"/><Button Content="Cancel" Command="{Binding SaveSessionDetailsCommand}" IsEnabled="{Binding IsSessionDraft}"/><TextBlock Text="{Binding Storage}" VerticalAlignment="Center" Foreground="#999" Margin="8"/></WrapPanel><TextBlock Text="Customer uses the default session selected here." Foreground="#999" TextWrapping="Wrap" Margin="4,8,4,0"/><TextBlock Text="{Binding LastCapture}" TextTrimming="CharacterEllipsis" Foreground="#999" Margin="4,4,4,0"/></StackPanel></Border>
   <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Setting" Style="{StaticResource SectionTitle}"/><TextBlock Text="Vị trí lưu ảnh" Margin="0,4,0,2"/><ComboBox ItemsSource="{Binding SaveLocationOptions}" SelectedItem="{Binding SaveLocation,Mode=TwoWay}"/><CheckBox Content="Tự động lật ảnh" IsChecked="{Binding AutoFlip,Mode=TwoWay}" Margin="0,8,0,0"/></StackPanel></Border>
   <Border Style="{StaticResource Card}"><StackPanel IsEnabled="{Binding IsCameraControlsEnabled}"><TextBlock Text="Camera Control" Style="{StaticResource SectionTitle}"/><Button Content="Test Capture" Command="{Binding TestCaptureCommand}" Background="#4CAF50"/><ItemsControl ItemsSource="{Binding CameraProperties}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="4"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Label}"/><ComboBox Grid.Column="1" ItemsSource="{Binding Values}" SelectedItem="{Binding SelectedValue,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsHitTestVisible="{Binding IsEnabled}" Focusable="{Binding IsEnabled}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
  </StackPanel></ScrollViewer>
  <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{StaticResource SurfaceBrush}" CornerRadius="10" Padding="18,10" Margin="8"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="Photo Count" Margin="10"/><ComboBox Width="90" ItemsSource="{Binding PhotoCounts}" SelectedItem="{Binding PhotoCount,Mode=TwoWay}"/><TextBlock Text="Countdown" Margin="30,10,10,10"/><ComboBox Width="90" ItemsSource="{Binding Countdowns}" SelectedItem="{Binding Countdown,Mode=TwoWay}"/><TextBlock Text="s" Margin="4"/><TextBlock Text="GIF" Margin="30,10,10,10"/><ComboBox Width="90" ItemsSource="{Binding GifDurationOptions}" SelectedItem="{Binding GifDuration,Mode=TwoWay}"/><TextBlock Text="s" Margin="4"/><TextBlock Text="Màn hình chờ" Margin="30,10,10,10"/><ComboBox Width="100" ItemsSource="{Binding WaitingTimeoutOptions}" SelectedItem="{Binding WaitingTimeout,Mode=TwoWay}"/></StackPanel></Border>
 </Grid>
</UserControl>
