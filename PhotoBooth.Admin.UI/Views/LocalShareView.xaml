<UserControl x:Class="PhotoBooth.Admin.UI.Views.LocalShareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Language="vi-VN">
    <Grid Background="{StaticResource BackgroundBrush}" Margin="28,22,28,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Ảnh &amp; mã QR" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Tìm, xem và cấp lại mã QR cho các lượt chụp trên thiết bị này."
                           Style="{StaticResource PageSubtitle}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding Library.SearchCommand}" Style="{StaticResource AdminSecondaryButton}" MinWidth="118">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{DynamicResource Icon.Library}" Style="{StaticResource ButtonVectorIcon}" Width="16" Height="16" Margin="0,0,8,0"/>
                        <TextBlock Text="Làm mới"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding Library.RetrySyncCommand}" MinWidth="170"
                        Visibility="{Binding Library.HasRecoverableUploads,Converter={StaticResource BoolVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{DynamicResource Icon.Share}" Style="{StaticResource ButtonVectorIcon}" Width="16" Height="16" Margin="0,0,8,0"/>
                        <TextBlock Text="Tiếp tục tải ảnh"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,12,0,0">
            <Border Background="{StaticResource DangerSubtleBrush}" BorderBrush="#7D414B" BorderThickness="1" CornerRadius="8" Padding="12"
                    Visibility="{Binding Library.HasError,Converter={StaticResource BoolVisibility}}">
                <TextBlock Text="{Binding Library.Error}" Foreground="#FFCDD2" TextWrapping="Wrap"/>
            </Border>
            <Border Background="{StaticResource SuccessSubtleBrush}" BorderBrush="#347052" BorderThickness="1" CornerRadius="8" Padding="12"
                    Visibility="{Binding Library.HasSyncMessage,Converter={StaticResource BoolVisibility}}">
                <TextBlock Text="{Binding Library.SyncMessage}" Foreground="#A7E6C3" TextWrapping="Wrap"/>
            </Border>
            <Border Background="{StaticResource WarningSubtleBrush}" BorderBrush="#8A6530" BorderThickness="1" CornerRadius="8" Padding="12"
                    Visibility="{Binding Library.HasRecoverableUploads,Converter={StaticResource BoolVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding Library.RecoveryTitle}" Foreground="#FFE0A6" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Library.RecoveryDescription}" Foreground="#F3DFC0" TextWrapping="Wrap" Margin="0,4,16,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Khôi phục tất cả" Command="{Binding Library.RetrySyncCommand}" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </StackPanel>

        <Grid Grid.Row="2" Margin="-8,10,-8,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14,12">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="SẴN SÀNG NHẬN ẢNH" Foreground="{StaticResource MutedTextBrush}" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="Đã có mã QR" Foreground="{StaticResource SuccessBrush}" FontSize="12" Margin="0,5,0,0"/></StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding Library.ReadyShareCountText}" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" Margin="14,0,0,0"/>
                </Grid>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="14,12">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="ĐANG XỬ LÝ" Foreground="{StaticResource MutedTextBrush}" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="Tự động chạy nền" Foreground="{StaticResource WarningBrush}" FontSize="12" Margin="0,5,0,0"/></StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding Library.PendingShareCountText}" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" Margin="14,0,0,0"/>
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14,12">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="CẦN XỬ LÝ" Foreground="{StaticResource MutedTextBrush}" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="Có thể khôi phục hàng loạt" Foreground="{StaticResource DangerBrush}" FontSize="12" Margin="0,5,0,0"/></StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding Library.FailedShareCountText}" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}" Margin="14,0,0,0"/>
                </Grid>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource Card}" Padding="14,12">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="CHỈ LƯU TRÊN MÁY" Foreground="{StaticResource MutedTextBrush}" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="Chưa có liên kết nhận ảnh" Foreground="#C3CAD5" FontSize="12" Margin="0,5,0,0"/></StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding Library.LocalOnlyShareCountText}" FontSize="30" FontWeight="SemiBold" Foreground="#C3CAD5" Margin="14,0,0,0"/>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="3">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding Library.FilterOptions}" SelectedItem="{Binding Library.SelectedFilter}" Height="40"/>
                        <Grid Grid.Column="1" Margin="4,0">
                            <TextBlock Text="Tìm theo ngày, sự kiện hoặc mã lượt chụp" Foreground="{StaticResource MutedTextBrush}" Margin="12,0"/>
                            <DatePicker SelectedDate="{Binding Library.SelectedDate}" Height="40" Visibility="{Binding Library.IsDateFilter,Converter={StaticResource BoolVisibility}}"/>
                            <ComboBox ItemsSource="{Binding Library.EventSuggestions}" Text="{Binding Library.FilterText}" IsEditable="True" Height="40" Visibility="{Binding Library.IsEventFilter,Converter={StaticResource BoolVisibility}}"/>
                            <TextBox Text="{Binding Library.FilterText}" Height="40" Visibility="{Binding Library.IsSessionFilter,Converter={StaticResource BoolVisibility}}"/>
                        </Grid>
                        <Button Grid.Column="2" Content="Tìm kiếm" Command="{Binding Library.SearchCommand}" Height="40"/>
                    </Grid>
                </Border>

                <DockPanel Grid.Row="1" Margin="4,3,4,8">
                    <TextBlock Text="LỊCH SỬ LƯỢT CHỤP" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}"/>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Library.ResultText}" Foreground="{StaticResource MutedTextBrush}"/>
                </DockPanel>

                <ListBox Grid.Row="2" ItemsSource="{Binding Library.Captures}" HorizontalContentAlignment="Stretch"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Focusable" Value="False"/>
                            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource CardBrush}" CornerRadius="10" Padding="12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,6,8">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="142"/><ColumnDefinition Width="*"/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions>
                                    <Border Width="132" Height="94" CornerRadius="7" Background="{StaticResource SurfaceBrush}" ClipToBounds="True" HorizontalAlignment="Left">
                                        <Image Source="{Binding ThumbnailBytes,Converter={StaticResource ByteImage}}" Stretch="UniformToFill"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,18,0">
                                        <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding EventText}" Foreground="{StaticResource AccentHoverBrush}" Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding SessionText}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,3,0,0"/>
                                        <TextBlock Text="{Binding MediaText}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <Grid Grid.Column="2">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Border Background="{Binding StatusBackground}" CornerRadius="7" Padding="10,7">
                                            <StackPanel>
                                                <TextBlock Text="{Binding SyncStatusText}" Foreground="{Binding StatusForeground}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding SyncStatusHint}" Foreground="#D5DAE2" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,7,0,0">
                                            <Button Content="Xem ảnh" Command="{Binding OpenCommand}" Style="{StaticResource AdminSecondaryButton}" Padding="12,7"/>
                                            <Button Content="Mã QR" Command="{Binding ShowQrCommand}" Padding="12,7" Visibility="{Binding HasQrAction,Converter={StaticResource BoolVisibility}}"/>
                                            <Button Content="Tải lại" Command="{Binding RetryCommand}" Style="{StaticResource AdminDangerButton}" Padding="12,7" Visibility="{Binding HasRetryAction,Converter={StaticResource BoolVisibility}}"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>

        <Border Grid.RowSpan="4" Background="#F00B0D12" Visibility="{Binding Library.IsCaptureOpen,Converter={StaticResource BoolVisibility}}">
            <Border Width="1180" Height="760" MaxWidth="{Binding ActualWidth,RelativeSource={RelativeSource AncestorType=UserControl}}" MaxHeight="{Binding ActualHeight,RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="14" Padding="20"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="{Binding Library.SelectedCaptureTitle}" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Chọn một tệp để mở bằng ứng dụng mặc định của Windows." Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,12"/></StackPanel>
                        <Button Grid.Column="1" Content="Đóng" Command="{Binding Library.CloseCaptureCommand}" Style="{StaticResource AdminSecondaryButton}" MinWidth="100" VerticalAlignment="Top"/>
                    </Grid>
                    <ListBox Grid.Row="1" ItemsSource="{Binding Library.SelectedMedia}" ScrollViewer.VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
                        <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Focusable" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.Library.OpenMediaCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                        Style="{StaticResource AdminSecondaryButton}" Padding="0" Margin="6" Width="250" Height="210">
                                    <Grid><Grid.RowDefinitions><RowDefinition Height="166"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                        <Border Background="#090B10" CornerRadius="7,7,0,0" ClipToBounds="True">
                                            <Grid>
                                                <Image Source="{Binding ThumbnailBytes,Converter={StaticResource ByteImage}}" Stretch="UniformToFill"/>
                                                <Border Width="48" Height="48" CornerRadius="24" Background="#B3000000"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Visibility="{Binding IsVideo,Converter={StaticResource BoolVisibility}}">
                                                    <Path Data="{DynamicResource Icon.Play}" Style="{StaticResource VectorIcon}" Width="22" Height="22" Stroke="White"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <TextBlock Grid.Row="1" Text="{Binding Label}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="8"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Border>

        <Border Grid.RowSpan="4" Background="#F00B0D12" Visibility="{Binding Library.IsQrOpen,Converter={StaticResource BoolVisibility}}">
            <Border Width="560" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="14" Padding="26" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Mã QR nhận ảnh" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Khách quét mã này để xem và tải ảnh." Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" Margin="0,6,0,14"/>
                    <Border Background="White" CornerRadius="10" Padding="14" HorizontalAlignment="Center"><Image Source="{Binding Library.SelectedQrBytes,Converter={StaticResource ByteImage}}" Width="380" Height="380"/></Border>
                    <Button Content="Đóng" Command="{Binding Library.CloseQrCommand}" Width="140" Margin="0,18,0,0" Style="{StaticResource AdminSecondaryButton}"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
