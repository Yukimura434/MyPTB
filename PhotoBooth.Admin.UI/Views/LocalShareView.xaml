<UserControl x:Class="PhotoBooth.Admin.UI.Views.LocalShareView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Margin="32" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="Local Share" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Chia sẻ ảnh của lượt chụp qua mạng LAN bằng mã QR." Foreground="#999" Margin="0,4,0,0"/>
            <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                <StackPanel>
                    <CheckBox Content="Cho phép chia sẻ qua mạng LAN (bỏ chọn để tắt server)" IsChecked="{Binding LocalShareEnabled}" Margin="0,0,0,8"/>
                    <Button Content="Khởi động Local Share" Command="{Binding StartServerCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource AccentBrush}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
